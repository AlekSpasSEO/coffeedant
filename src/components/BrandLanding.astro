---
import HomeLayout from '../layouts/HomeLayout.astro';
import type { Brand } from '../data/catalog';
import { brandDetails, brands, machinePagesForBrand } from '../data/catalog';

const { brand, pages } = Astro.props as { brand: Brand; pages: any[] };
const base = import.meta.env.BASE_URL;
const machines = machinePagesForBrand(brand, pages);
const controlLabel = brand.position < 30 ? 'Convenience first' : brand.position > 75 ? 'Control first' : 'Balanced workflow';
const details = brandDetails[brand.slug];
const comparableBrands = [brand, ...brands
  .filter((item) => item.slug !== brand.slug)
  .sort((a, b) => Math.abs(a.position - brand.position) - Math.abs(b.position - brand.position))
  .slice(0, 2)];
---
<HomeLayout
  title={`${brand.name} Espresso Machines: Compare the Lineup | Coffeedant`}
  description={`${brand.name} espresso machines compared by workflow, price level, strengths, and trade-offs. Browse ${machines.length} Coffeedant reviews.`}
  canonicalPath={brand.path}
>
  <main id="main-content">
    <section class="hub-hero hub-hero-brand">
      <div class="shell hub-hero-grid">
        <div>
          <a class="back-link" href={`${base}brands/`}>← All brands</a>
          <p class="eyebrow">{brand.country} · {brand.system}</p>
          <h1>{brand.name}, mapped.</h1>
          <p class="hero-copy">{brand.summary}</p>
        </div>
        <div class="hero-facts" aria-label={`${brand.name} overview`}>
          <div><strong>{machines.length}</strong><span>machine reviews</span></div>
          <div><strong>{brand.range}</strong><span>price position</span></div>
          <div><strong>{controlLabel}</strong><span>workflow</span></div>
        </div>
      </div>
    </section>

    <section class="section section-compact" aria-labelledby="fit-title">
      <div class="shell">
        <div class="section-heading">
          <span class="section-number">01 / Brand fit</span>
          <h2 id="fit-title">Where {brand.name} sits.</h2>
          <p>Brand position is useful only when it helps you choose a daily routine.</p>
        </div>

        <div class="brand-fit-grid">
          <div class="spectrum-card">
            <div class="spectrum-labels"><span>Push-button ease</span><span>Hands-on control</span></div>
            <div class="spectrum-line" aria-label={`${brand.name}: ${controlLabel}`}>
              <span class="spectrum-marker" style={`left: ${brand.position}%`}><b>{brand.name}</b></span>
            </div>
            <p><strong>Best for:</strong> {brand.bestFor}</p>
          </div>
          <div class="fit-card fit-card-good">
            <span class="fit-label">Why it belongs on a shortlist</span>
            <ul>{brand.strengths.map((strength) => <li>{strength}</li>)}</ul>
          </div>
          <div class="fit-card fit-card-skip">
            <span class="fit-label">The trade-off</span>
            <p>{brand.tradeoff}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-compact brand-story" aria-labelledby="brand-story-title">
      <div class="shell">
        <div class="section-heading">
          <span class="section-number">02 / Brand approach</span>
          <h2 id="brand-story-title">What {brand.name} actually builds for.</h2>
          <p>The useful brand story is the one that changes ownership, not the one printed in a brochure.</p>
        </div>
        <div class="brand-story-grid">
          <article><span>Design approach</span><p>{details?.approach ?? brand.summary}</p></article>
          <article><span>Ownership reality</span><p>{details?.ownership ?? `The daily fit comes down to ${brand.bestFor.toLowerCase()}.`}</p></article>
          <article><span>How to read the range</span><p>{details?.rangeLogic ?? `Start with ${brand.system.toLowerCase()}, then compare the models by routine.`}</p></article>
        </div>
      </div>
    </section>

    <section class="section section-compact comparison-section" aria-labelledby="brand-compare-title">
      <div class="shell">
        <div class="section-heading">
          <span class="section-number">03 / Nearest alternatives</span>
          <h2 id="brand-compare-title">Compare the lane.</h2>
          <p>These brands sit closest on the convenience-to-control map. Similar position does not mean identical ownership.</p>
        </div>
        <div class="table-scroll">
          <table class="comparison-table" aria-label={`${brand.name} and nearby brand alternatives`}>
            <thead><tr><th>Brand</th><th>System</th><th>Price position</th><th>Best for</th><th></th></tr></thead>
            <tbody>
              {comparableBrands.map((item) => (
                <tr class:list={{ 'current-row': item.slug === brand.slug }}>
                  <th scope="row" data-label="Brand">{item.name}</th>
                  <td data-label="System">{item.system}</td>
                  <td data-label="Price position">{item.range}</td>
                  <td data-label="Best for">{item.bestFor}</td>
                  <td data-label="Brand page"><a href={`${base}${item.path.replace(/^\//, '')}`}>{item.slug === brand.slug ? 'Current' : 'Compare →'}</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section guides" aria-labelledby="models-title">
      <div class="shell">
        <div class="section-heading">
          <span class="section-number">04 / Reviews</span>
          <h2 id="models-title">The {brand.name} lineup.</h2>
          <p>Every available Coffeedant review, without making you dig through an archive.</p>
        </div>
        {machines.length > 0 ? (
          <div class="model-index">
            {machines.map((machine, index) => (
              <a href={`${base}${machine.path.replace(/^\//, '')}`}>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong>{machine.title}</strong>
                <b aria-hidden="true">→</b>
              </a>
            ))}
          </div>
        ) : (
          <div class="empty-panel">
            <strong>Reviews are being organized.</strong>
            <p>Use the main machine guide to compare this brand with the rest of the catalog.</p>
          </div>
        )}
      </div>
    </section>

    <section class="section section-compact" aria-labelledby="brand-check-title">
      <div class="shell">
        <div class="section-heading">
          <span class="section-number">05 / Before you choose</span>
          <h2 id="brand-check-title">Three checks.</h2>
          <p>A logo should never make these decisions for you.</p>
        </div>
        <div class="principle-grid">
          <article><span>01</span><h3>Choose the machine family</h3><p>{details?.rangeLogic ?? brand.system}</p></article>
          <article><span>02</span><h3>Price the full setup</h3><p>Include the grinder, milk accessories, water treatment, cleaning supplies, and realistic service costs.</p></article>
          <article><span>03</span><h3>Accept the compromise</h3><p>{brand.tradeoff}</p></article>
        </div>
      </div>
    </section>

    <section class="section section-compact">
      <div class="shell next-step">
        <div><p class="eyebrow">Still comparing?</p><h2>Put the brand second.</h2></div>
        <p>Start with your routine, then use the brand as a filter. The main guide organizes machines by control, convenience, grinder setup, space, and budget.</p>
        <a class="block-link" href={`${base}espresso-machine/`}>Open the machine guide →</a>
      </div>
    </section>
  </main>
</HomeLayout>
