---
import BrandComparison from './BrandComparison.astro';
import { rancilioBrandPath, rancilioModels, proXPath, silviaPath } from '../data/reviews/rancilio-buying-audit';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const silvia = rancilioModels[silviaPath];
const proX = rancilioModels[proXPath];
const image = 'images/products/rancilio-silvia-v6-vs-pro-x.jpg';
const imageAlt = 'Diagram: the Silvia V6 shares one boiler; the Silvia Pro X has separate brew and steam boilers';
const decisionRows = [
  { label: 'Best fit', key: 'fit' },
  { label: 'Heating', key: 'boiler' },
  { label: 'Brew temperature', key: 'temperature' },
  { label: 'Making milk drinks', key: 'milk' },
  { label: 'Body size (US)', key: 'dimensions' },
  { label: 'Setup budget', key: 'budget' },
] as const;
---
<BrandComparison
  brand="Rancilio"
  path={rancilioBrandPath}
  title="Rancilio Silvia V6 vs. Silvia Pro X | Coffeedant"
  heading="Silvia V6 vs. Silvia Pro X"
  description="Compare Rancilio’s Silvia V6 and Silvia Pro X by milk workflow, temperature control, counter space and what you need to buy separately."
  image={image}
  imageAlt={imageAlt}
  models={[{ name: silvia.name, path: silviaPath }, { name: proX.name, path: proXPath }]}
  compareId="rancilio-compare-title"
  compareTitle="What changes when you upgrade?"
  caption="Stock North American models. Dimensions are width × depth × height."
  rows={decisionRows.map(({ label, key }) => ({ label, first: silvia[key], second: proX[key] }))}
>
  <p slot="eyebrow" class="eyebrow">Rancilio espresso machines</p>
  <Fragment slot="intro">
    <p><strong>Mostly espresso?</strong> Start with the Silvia V6 if you’re happy to learn its heating routine. <strong>Two lattes most mornings?</strong> The Silvia Pro X lets you brew and steam at the same time.</p>
    <p>Both need an espresso grinder. You grind, start and stop the shot, and steam milk yourself.</p>
  </Fragment>
    <section aria-labelledby="rancilio-setup-title">
      <h2 id="rancilio-setup-title">Check your setup before ordering</h2>
      <ul class="buying-guide-checklist">
        <li><strong>Measure the working space.</strong> The Pro X is just 0.6 inches wider, but 5.1 inches deeper. Leave room above either machine to fill the tank and in front to remove the tray.</li>
        <li><strong>Price the whole setup.</strong> Include an <a href={`${base}/grinder/best-compact-electric-espresso-grinders/`}>espresso grinder</a>, a scale, suitable water and a pitcher if you make milk drinks.</li>
        <li><strong>Confirm the exact listing.</strong> Check voltage, accessories and who handles warranty repairs. A Silvia with a seller-installed PID is different from a stock V6; an older Silvia Pro is different from a Pro X.</li>
      </ul>
      <p>If you want factory temperature control for espresso without a second boiler, compare the <a href={`${base}/espresso-machine/profitec-go/`}>Profitec GO</a>. To browse beyond Rancilio, <a href={`${base}/espresso-machine/#coffee-finder`}>open the espresso machine finder</a>.</p>
    </section>
  <p slot="sources">This is a research comparison. Coffeedant did not bench-test either machine. See the <a href={silvia.official}>official Silvia photos and specifications</a>, <a href={proX.official}>official Pro X photos and specifications</a> and <a href={`${base}/testing/`}>our review methodology</a>.</p>
</BrandComparison>
