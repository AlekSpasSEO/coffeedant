---
import type { MachineReviewData } from '../../data/reviews';

const { review } = Astro.props as { review: MachineReviewData };
const base = import.meta.env.BASE_URL;
const ratingPercent = `${review.rating / 5 * 100}%`;
---

<section class="review-summary" aria-labelledby="review-title">
  <div class="review-summary-media">
    <span class="review-award">{review.verdictLabel}</span>
    <img
      src={`${base}${review.image}`}
      width="300"
      height="300"
      alt={review.imageAlt}
      fetchpriority="high"
      decoding="async"
    />
    <div class="review-fact-strip" aria-label="Key specifications">
      {review.facts.slice(0, 3).map((fact) => (
        <span><strong>{fact.value}</strong>{fact.label}</span>
      ))}
    </div>
  </div>

  <div class="review-summary-main">
    <p class="review-overline">{review.brand} · tested review</p>
    <h1 id="review-title">{review.title}</h1>
    <p class="review-deck">{review.verdict}</p>

    <div class="review-commercial-row">
      <div class="review-rating" aria-label={`${review.rating} out of 5`}>
        <strong>{review.rating}</strong>
        <span>
          <span class="review-stars" aria-hidden="true">
            <span>★★★★★</span>
            <span class="review-stars-fill" style={`width:${ratingPercent}`}>★★★★★</span>
          </span>
          Coffeedant score
        </span>
      </div>
      <div class="review-price">
        <span>Official MSRP</span>
        <strong>{review.price.msrp}</strong>
        <small>{review.price.typical}</small>
      </div>
    </div>

    <div class="review-buy-actions">
      {review.links.map((link) => (
        <a
          class:list={['review-buy-button', { 'review-buy-button-primary': link.primary }]}
          href={link.href}
          target="_blank"
          rel={link.affiliate ? 'nofollow sponsored noopener' : 'noopener'}
        >
          <span>{link.label}</span>
          <small>{link.note}</small>
        </a>
      ))}
    </div>
    <p class="review-price-check">Price checked {review.price.checked}. Retail prices change.</p>
  </div>

  <div class="review-summary-bottom">
    <div class="review-fit review-fit-good">
      <h2>Buy it if</h2>
      <ul>{review.bestFor.map((item) => <li>{item}</li>)}</ul>
    </div>
    <div class="review-fit review-fit-bad">
      <h2>Skip it if</h2>
      <ul>{review.avoidIf.map((item) => <li>{item}</li>)}</ul>
    </div>
    <div class="review-pros-cons">
      <div>
        <h2>Pros</h2>
        <ul>{review.pros.slice(0, 4).map((item) => <li>{item}</li>)}</ul>
      </div>
      <div>
        <h2>Cons</h2>
        <ul>{review.cons.slice(0, 4).map((item) => <li>{item}</li>)}</ul>
      </div>
    </div>
  </div>
</section>

<p class="affiliate-note">
  <strong>Affiliate disclosure:</strong> Coffeedant may earn a commission from retailer links, at no extra cost to you.
</p>

