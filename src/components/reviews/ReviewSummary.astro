---
import type { MachineReviewData } from '../../data/reviews';
import { getReviewOverallScore } from '../../data/reviews';
import { getAmazonOfferCheckedLabel } from '../../lib/amazon-affiliate';

const { review, anchorAliases = {} } = Astro.props as { review: MachineReviewData; anchorAliases?: Record<string, string[]> };
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const basePath = base.replace(/\/$/, '');
const assetUrl = (path: string) => /^https:\/\//i.test(path)
  ? path
  : `${base}${path.replace(/^\//, '')}`;
const pageUrl = (path: string) => path.startsWith('/') && !path.startsWith('//')
  ? path === basePath || path.startsWith(`${basePath}/`)
    ? path
    : `${base}${path.replace(/^\//, '')}`
  : path;
const formatDate = (date: string) => new Intl.DateTimeFormat('en-US', {
  month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC',
}).format(new Date(`${date}T00:00:00Z`));
const overallRating = getReviewOverallScore(review.evaluation);
const amazonLink = review.links.find((link) => link.retailer === 'Amazon');
const amazonCheckedLabel = amazonLink ? getAmazonOfferCheckedLabel(amazonLink) : null;
---

<section class="review-summary" aria-labelledby="review-title" style="position:relative">
  {(anchorAliases.summary ?? []).map(alias => <span id={alias} class="review-anchor-alias" data-legacy-anchor-target="summary" aria-hidden="true"></span>)}
  <header class="review-summary-heading">
    <p class="review-overline">{review.brand} · {review.evaluation.basis.label.toLowerCase()}</p>
    <h1 id="review-title">{review.title}</h1>
  </header>
  <div class="review-summary-media">
    <span class="review-award">{review.verdictLabel}</span>
    <img class="review-product-image" src={assetUrl(review.image)} width="500" height="500" alt={review.imageAlt} fetchpriority="high" decoding="async" />
    <aside class="review-author-card" aria-label="Author and publication details">
      <div class="review-author-head">
        <img src={assetUrl(review.author.image)} width="48" height="48" alt={review.author.imageAlt} decoding="async" />
        <div><span>Written by</span><strong>{review.author.name}</strong><small>{review.author.role}</small></div>
      </div>
      <dl class="review-author-dates">
        <div><dt>Published</dt><dd><time datetime={review.published}>{formatDate(review.published)}</time></dd></div>
        <div><dt>Updated</dt><dd><time datetime={review.updated}>{formatDate(review.updated)}</time></dd></div>
      </dl>
      <p><strong>A note from the author</strong>{review.author.note}</p>
    </aside>
  </div>

  <div class="review-summary-main">
    <p class="review-deck">{review.verdict}</p>
    <div class="review-assessment">
      <strong>My assessment</strong><p>{review.assessment}</p>
      <a href="#methodology">How I reached this conclusion <span aria-hidden="true">↗</span></a>
    </div>
    <div class="review-commercial-row">
      {overallRating !== null && (
        <a class="review-overall-rating" href="#ratings" aria-label={`${overallRating.toFixed(1)} out of 5, open the Coffeedant category ratings`}>
          <span>{review.evaluation.basis.label}</span>
          <strong>{overallRating.toFixed(1)}<small>/5</small></strong>
          <small>See all six categories ↓</small>
        </a>
      )}
      <div class="review-price">
        <span>{amazonLink?.price ? 'Current Amazon price' : amazonLink?.exactProduct ? 'Amazon availability' : 'Current Amazon pricing'}</span>
        <strong>{amazonLink?.price ?? (amazonLink?.exactProduct ? 'Check Amazon' : 'Search Amazon')}</strong>
        <small>{amazonLink?.availability ?? (amazonLink?.exactProduct ? 'Live price shown by Amazon' : 'Exact listing not verified')}</small>
      </div>
      <div class="review-buy-actions">
        {review.links.map((link) => (
          <a class:list={['review-buy-button', { 'review-buy-button-primary': link.primary }]} href={link.href} target="_blank" rel={link.affiliate ? 'nofollow sponsored noopener' : 'noopener'}>
            <span>{link.label} <span aria-hidden="true">↗</span></span>{link.note && <small>{link.note}</small>}
          </a>
        ))}
        <a class="review-buy-button review-finder-button" href={`${base}espresso-machine/#coffee-finder`}>
          <span>Compare with Coffee Finder <span aria-hidden="true">→</span></span>
          <small>Search every reviewed machine</small>
        </a>
      </div>
    </div>
    <p class="review-price-check">
      {amazonCheckedLabel
        ? <>Amazon offer checked {amazonCheckedLabel}. Price and availability can change after this check.</>
        : <>Amazon search results are live. Confirm the exact model, seller, warranty and included accessories before buying.</>}
    </p>
    {review.alternatives.length > 0 && (
      <nav class="review-alternatives" aria-label="Alternative products">
        <h2>Also consider</h2>
        {review.alternatives.map((item) => <a href={pageUrl(item.href)}><strong>{item.name} <span aria-hidden="true">↗</span></strong><span>{item.reason}</span></a>)}
      </nav>
    )}
  </div>
  <dl class="review-fact-strip" aria-label="Key specifications" style="position:relative">
    {review.facts.map((fact, index) => <div><dt>{index === 0 && (anchorAliases.specifications ?? []).map(alias => <span id={alias} class="review-anchor-alias" data-legacy-anchor-target="specifications" aria-hidden="true"></span>)}{fact.label}</dt><dd>{fact.value}</dd></div>)}
  </dl>
  <div class="review-summary-bottom">
    <div class="review-fit review-fit-good"><h2>Buy it if</h2><ul>{review.bestFor.map((item) => <li>{item}</li>)}</ul></div>
    <div class="review-fit review-fit-bad"><h2>Skip it if</h2><ul>{review.avoidIf.map((item) => <li>{item}</li>)}</ul></div>
    <div class="review-fit review-pros"><h2>What works</h2><ul>{review.pros.slice(0, 4).map((item) => <li>{item}</li>)}</ul></div>
    <div class="review-fit review-cons"><h2>The trade-offs</h2><ul>{review.cons.slice(0, 4).map((item) => <li>{item}</li>)}</ul></div>
  </div>
</section>
<p class="affiliate-note"><strong>Affiliate disclosure:</strong> As an Amazon Associate I earn from qualifying purchases. Coffeedant may also earn a commission from other retailer links, at no extra cost to you. The assessment is based on the evidence and sources explained below.</p>
