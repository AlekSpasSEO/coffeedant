<noscript><style>.elizabeth-dashboard [data-video-panel][hidden],.elizabeth-dashboard [data-vendor-offer][hidden]{display:block!important}.elizabeth-dashboard .ed-select-label,.elizabeth-dashboard .ed-routine-buttons{display:none}</style></noscript>
<script>
  const root = document.querySelector<HTMLElement>('[data-elizabeth-dashboard]');
  if (root) {
    const selector = root.querySelector<HTMLSelectElement>('[data-video-selector]');
    selector?.addEventListener('change', () => {
      root.querySelectorAll<HTMLElement>('[data-video-panel]').forEach(panel => { panel.hidden = panel.dataset.videoPanel !== selector.value; });
      const status = root.querySelector<HTMLElement>('[data-video-status]');
      if (status) status.textContent = `${selector.selectedOptions[0].textContent} selected.`;
    });
    const region = root.querySelector<HTMLSelectElement>('[data-region-selector]');
    const notes: Record<string, string> = { US: 'US listings for PL92T-120. Prices exclude any checkout taxes and delivery charges.', UK: 'UK-listed PL92T offers. Confirm the supplied electrical variant, plug, VAT and local support.', DE: 'German-listed 230 V PL92T offers. Listed prices include VAT; check shipping and local support.' };
    region?.addEventListener('change', () => {
      root.querySelectorAll<HTMLElement>('[data-vendor-offer]').forEach(offer => { offer.hidden = offer.dataset.region !== region.value; });
      const note = root.querySelector<HTMLElement>('[data-region-note]');
      const status = root.querySelector<HTMLElement>('[data-region-status]');
      if (note) note.textContent = notes[region.value];
      if (status) status.textContent = `Showing ${region.selectedOptions[0].textContent} retailer snapshots.`;
    });
    const routines: Record<string, string> = {
      milk: 'A useful fit once warm: the boilers let brewing and steaming overlap. You prepare each dose and texture the milk yourself; cleaning follows both drinks. No verified complete two-drink time is available.',
      espresso: 'Temperature and preinfusion controls give you room to experiment. Decide whether the second boiler earns its cost for your routine; the machine still needs preheating, an espresso grinder and a scale.',
      capsules: 'Expect a substantial change in routine: grinding, dosing, tamping, adjusting the recipe and cleaning. Elizabeth makes sense if you want that involvement. Compare bean-to-cup machines if independent one-button use matters more.',
    };
    root.querySelectorAll<HTMLButtonElement>('[data-routine]').forEach(button => button.addEventListener('click', () => {
      root.querySelectorAll<HTMLButtonElement>('[data-routine]').forEach(peer => peer.setAttribute('aria-pressed', String(peer === button)));
      const answer = root.querySelector<HTMLElement>('[data-routine-answer]');
      if (answer) answer.textContent = routines[button.dataset.routine!];
    }));
  }
</script>
