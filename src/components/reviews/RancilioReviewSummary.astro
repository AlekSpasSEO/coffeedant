---
import type { MachineReviewData } from '../../data/reviews';
import { proXPath, silviaPath, rancilioModels } from '../../data/reviews/rancilio-buying-audit';
import '../../styles/rancilio.css';

const { review, aliases } = Astro.props as { review: MachineReviewData; aliases: Record<string, string[]> };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const other = review.slug === proXPath ? silviaPath : proXPath;
const updated = new Intl.DateTimeFormat('en-US', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(review.updated));
---
<header class="review-summary rancilio-hero rancilio-review-hero" id="summary">
  {(aliases.summary ?? []).map(alias => <span id={alias} class="review-anchor-alias" data-legacy-anchor-target="summary" aria-hidden="true"></span>)}
  <div>
    <p class="eyebrow">Research review · North American model</p>
    <h1 id="review-title">{review.title}</h1>
    <p class="rancilio-byline">By <a href={`${base}/about/`}>{review.author.name}</a> · Updated <time datetime={review.updated}>{updated}</time></p>
    <p class="rancilio-verdict">{review.verdict}</p>
    <div class="rancilio-actions">
      <a class="rancilio-button" href="#verdict">See where to buy</a>
      <a href={`${base}${other}`}>Read the {rancilioModels[other].name} review <span aria-hidden="true">→</span></a>
    </div>
  </div>
  <figure class="rancilio-figure">
    <img class="review-product-image" src={`${base}/${review.image}`} width="1200" height="630" alt={review.imageAlt} decoding="async" fetchpriority="high" />
    <figcaption>Coffeedant diagram based on Rancilio specifications. <a href={rancilioModels[review.slug === proXPath ? proXPath : silviaPath].official}>See official product photos</a>.</figcaption>
  </figure>
</header>
<dl id="specifications" class="review-fact-strip rancilio-facts" aria-label="Key specifications">
  {review.facts.map((fact, i) => <div><dt>{i === 0 && (aliases.specifications ?? []).map(alias => <span id={alias} class="review-anchor-alias" data-legacy-anchor-target="specifications" aria-hidden="true"></span>)}{fact.label}</dt><dd>{fact.value}</dd></div>)}
</dl>
