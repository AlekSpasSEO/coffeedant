---
import type { MachineReviewData } from '../../data/reviews';
import { reviewInlineMedia } from '../../data/review-inline-media';
import { getReviewRouteDefinition } from '../../data/review-routes';
import ReviewSummary from './ReviewSummary.astro';
import ReviewRatings from './ReviewRatings.astro';
import ReviewPerformanceDetail from './ReviewPerformanceDetail.astro';

const { review } = Astro.props as { review: MachineReviewData };
const reviewRoute = getReviewRouteDefinition(review.slug);
if (!reviewRoute) throw new Error(`${review.slug} is not a canonical modern review route.`);
const productNoun = reviewRoute.family === 'grinder' ? 'grinder' : 'machine';
const allInlineMedia = reviewInlineMedia[review.slug] ?? [];
const inlineMedia = allInlineMedia
  .slice(0, 2)
  .map((media, index) => ({ ...media, afterSection: index === 0 ? 1 : 5 }));
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const assetUrl = (path: string) => /^https:\/\//i.test(path)
  ? path
  : new URL(`${base}${path.replace(/^\//, '')}`, Astro.site ?? Astro.url).toString();
const canonical = new URL(review.slug.replace(/^\//, ''), 'https://coffeedant.com/').toString();
const primaryOffer = review.links.find((link) => link.primary) ?? review.links[0];
const redditSources = review.article.sources.filter((source) => /^https:\/\/(?:www\.)?reddit\.com\//i.test(source.href));
const redditEvidenceSectionId = review.article.sections.find((section) => (
  /(?:owner|community|recommendation|value)/i.test(section.id)
))?.id ?? review.article.sections.at(-1)?.id;
const renderSectionHtml = (section: MachineReviewData['article']['sections'][number]) => {
  if (!/class="review-faq-list(?:\s|"|$)/i.test(section.html)) return section.html;
  return section.html
    .replace(/<details\b[^>]*>/gi, '<article class="review-faq-item">')
    .replace(/<summary\b[^>]*>([\s\S]*?)<\/summary>/gi, '<h3>$1</h3>')
    .replace(/<\/details>/gi, '</article>');
};
const isCommunityHref = (href: string) => /(?:reddit\.com|home-barista\.com|freeflarum\.com|coffeeforums\.com|forums\.whirlpool\.net\.au|facebook\.com\/groups)/i.test(href);
const formatDate = (date: string) => new Intl.DateTimeFormat('en-US', {
  month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC',
}).format(new Date(`${date}T00:00:00Z`));
const shortLabels: Record<string, string> = {
  orientation: 'Overview', setup: 'Setup', espresso: 'Espresso', milk: 'Milk', workflow: 'Daily use',
  compare: 'Compare', comparisons: 'Compare', recommendations: 'Alternatives',
  owners: 'Owner feedback', ownership: 'Ownership', faq: 'FAQ',
  grinder: 'Grinder', cost: 'Total cost', design: 'Design', value: 'Value', related: 'More guides',
};
const jumpLinks = [
  { id: 'ratings', label: 'Ratings' },
  ...review.article.sections.map((section) => ({
    id: section.id,
    label: ['espresso', 'milk'].includes(section.id)
      ? review.evaluation.dimensions.find((dimension) => dimension.deepDiveId === section.id)?.label ?? shortLabels[section.id]
      : shortLabels[section.id] ?? section.title,
  })),
  { id: 'video', label: 'Video' }, { id: 'methodology', label: 'Methodology' },
  { id: 'sources', label: 'Sources' }, { id: 'verdict', label: 'Verdict' },
];
const author = {
  '@type': 'Person', name: review.author.name, jobTitle: review.author.role,
  image: assetUrl(review.author.image), url: 'https://coffeedant.com/about/',
};
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product', '@id': `${canonical}#product`,
      name: `${review.brand} ${review.model}`, sku: review.sku, identifier: review.productId,
      category: review.category, image: assetUrl(review.image),
      description: review.description, url: canonical,
      brand: { '@type': 'Brand', name: review.brand },
    },
    {
      '@type': 'Article', '@id': `${canonical}#article`, headline: review.title,
      description: review.description, articleSection: reviewRoute.articleSection,
      genre: 'Research-led product review', inLanguage: 'en-US', author, datePublished: review.published,
      dateModified: review.updated, image: assetUrl(review.image), mainEntityOfPage: canonical,
      about: { '@id': `${canonical}#product` },
      publisher: { '@type': 'Organization', name: 'Coffeedant', url: 'https://coffeedant.com/' },
      citation: review.article.sources.map((source) => source.href),
    },
    {
      '@type': 'VideoObject', name: review.video.title, description: review.video.note,
      inLanguage: 'en-US',
      thumbnailUrl: `https://img.youtube.com/vi/${review.video.id}/hqdefault.jpg`, uploadDate: review.video.published,
      embedUrl: `https://www.youtube-nocookie.com/embed/${review.video.id}`,
      contentUrl: `https://www.youtube.com/watch?v=${review.video.id}`,
    },
    {
      '@type': 'BreadcrumbList', itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://coffeedant.com/' },
        { '@type': 'ListItem', position: 2, name: reviewRoute.breadcrumbLabel, item: `https://coffeedant.com${reviewRoute.basePath}` },
        { '@type': 'ListItem', position: 3, name: `${review.brand} ${review.model}`, item: canonical },
      ],
    },
  ],
};
---

<main id="main-content" class="review-page" data-product-id={review.productId} tabindex="-1">
  <div class="review-shell">
    <nav class="review-breadcrumbs" aria-label="Breadcrumb">
      <a href={base}>Home</a><span aria-hidden="true">/</span>
      <a href={`${base}${reviewRoute.basePath.replace(/^\//, '')}`}>{reviewRoute.breadcrumbLabel}</a><span aria-hidden="true">/</span>
      <span aria-current="page">{review.model}</span>
    </nav>
    <ReviewSummary review={review} />
    <section class="quick-answer-panel" aria-labelledby="quick-answer-title">
      <header class="quick-answer-heading"><p class="review-overline">At a glance</p><h2 id="quick-answer-title">Before you choose</h2></header>
      <dl class="quick-answer-grid">
        {review.quickAnswers.map((item) => <div><dt>{item.question}</dt><dd>{item.answer}</dd></div>)}
      </dl>
    </section>
    <nav class="review-jumpbar" aria-label="Review sections">
      <span>In this review</span><div>{jumpLinks.map((link) => <a href={`#${link.id}`}>{link.label}</a>)}</div>
    </nav>
    <article class="review-article" aria-label={`${review.brand} ${review.model} full review`}>
      <ReviewRatings evaluation={review.evaluation} productName={`${review.brand} ${review.model}`} />
      {review.article.sections.map((section, index) => (
        <section class="review-section" id={section.id} aria-labelledby={`${section.id}-title`}>
          <header class="review-section-heading">
            <p class="review-overline"><span class="review-section-number">{String(index + 2).padStart(2, '0')}</span>{section.eyebrow}</p>
            <h2 id={`${section.id}-title`}>{section.title}</h2>
          </header>
          <div class="review-section-body">
            <Fragment set:html={renderSectionHtml(section)} />
            {review.evaluation.dimensions
              .filter((dimension) => dimension.deepDiveId === section.id)
              .map((dimension) => <ReviewPerformanceDetail dimension={dimension} />)}
            {inlineMedia
              .filter((media) => media.afterSection === index)
              .map((media) => (
                <figure
                  class="review-media review-inline-media"
                  data-source-type={media.sourceType}
                  data-user-generated={String(media.userGenerated)}
                  data-usage-record={media.usageHref}
                >
                  <a class="review-media-link" href={media.sourceHref} target="_blank" rel={media.userGenerated ? 'ugc noopener' : 'noopener'}>
                    <img
                      src={/^https?:\/\//.test(media.src) ? media.src : assetUrl(media.src)}
                      alt={media.alt}
                      width={media.width}
                      height={media.height}
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                  <figcaption>
                    <span class="review-media-source-badge">{
                      media.sourceType === 'reddit'
                        ? 'Reddit photo'
                        : media.sourceType === 'community'
                          ? 'Community photo'
                          : media.sourceType === 'manufacturer'
                            ? 'Manufacturer photo'
                            : media.userGenerated
                              ? 'Owner photo'
                              : 'Product listing'
                    }</span>
                    {media.caption}
                    <span class="review-media-credit">
                      Image: <a href={media.sourceHref} target="_blank" rel={media.userGenerated ? 'ugc noopener' : 'noopener'}>{media.credit}</a>.
                      {' '}Usage record: <a href={media.usageHref} target="_blank" rel="noopener">{media.usageLabel}</a>.
                      {media.disclosure && <> {media.disclosure}</>}
                    </span>
                  </figcaption>
                </figure>
              ))}
            {section.id === redditEvidenceSectionId && redditSources.length > 0 && (
              <aside class="review-community-evidence" aria-labelledby={`${section.id}-reddit-title`}>
                <p class="review-overline">What real owners report</p>
                <h3 id={`${section.id}-reddit-title`}>The useful patterns from Reddit, kept on this page</h3>
                <ul>
                  {redditSources.slice(0, 3).map((source) => (
                    <li>
                      <strong>{source.label.replace(/^r\/([^:]+):?/i, 'r/$1')}</strong>
                      <p>{source.note}</p>
                    </li>
                  ))}
                </ul>
                <p class="review-community-evidence-note">These are self-selected owner reports, not a representative sample or Coffeedant testing. The complete source records remain in the evidence list below.</p>
              </aside>
            )}
          </div>
        </section>
      ))}
      <section class="review-section" id="video" aria-labelledby="video-title">
        <header class="review-section-heading"><p class="review-overline">See the {productNoun} in use</p><h2 id="video-title">An independent video perspective</h2></header>
        <div class="review-section-body">
          <div class="review-video" data-review-video={review.video.id}>
            <button class="review-video-poster" type="button" aria-label={`Play ${review.video.title}`}>
              <img src={`https://img.youtube.com/vi/${review.video.id}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" decoding="async" />
              <span class="review-play" aria-hidden="true">▶</span><span class="review-video-label">Play video</span>
            </button>
            <div class="review-video-copy">
              <p class="review-overline">{review.video.creator}</p><h3>{review.video.title}</h3><p>{review.video.note}</p>
              <a href={`https://www.youtube.com/watch?v=${review.video.id}`} target="_blank" rel="noopener">Watch on YouTube <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </div>
      </section>
      <section class="review-section review-methodology" id="methodology" aria-labelledby="methodology-title">
        <span id="testing" class="review-anchor-alias" aria-hidden="true"></span>
        <header class="review-section-heading"><p class="review-overline">Why I trust the verdict</p><h2 id="methodology-title">What the evidence lets me say with confidence</h2></header>
        <div class="review-section-body">
          {review.article.methodology.trim().startsWith('<') ? <Fragment set:html={review.article.methodology} /> : <p>{review.article.methodology}</p>}
        </div>
      </section>
      <section class="review-section" id="sources" aria-labelledby="sources-title">
        <span id="resources" class="review-anchor-alias" aria-hidden="true"></span>
        <header class="review-section-heading"><p class="review-overline">Check the evidence</p><h2 id="sources-title">Sources and further reading</h2></header>
        <div class="review-section-body">
          <ol class="review-source-list">
            {review.article.sources.map((source) => <li id={source.id}><a href={source.href} target="_blank" rel={isCommunityHref(source.href) ? 'ugc noopener' : 'noopener'}>{source.label} <span aria-hidden="true">↗</span></a><p>{source.note}</p></li>)}
          </ol>
        </div>
      </section>
      <section class="final-verdict" id="verdict" aria-labelledby="final-verdict-title">
        <p class="review-overline">The buying decision</p><h2 id="final-verdict-title">{review.article.finalTitle}</h2>
        {review.article.finalVerdict.map((paragraph) => <p>{paragraph}</p>)}
        {primaryOffer && <a class="review-buy-button review-buy-button-dark" href={primaryOffer.href} target="_blank" rel={primaryOffer.affiliate ? 'nofollow sponsored noopener' : 'noopener'}>{primaryOffer.label} <span aria-hidden="true">↗</span></a>}
      </section>
    </article>
    <footer class="review-meta-footer">
      <span>Published <time datetime={review.published}>{formatDate(review.published)}</time></span>
      <span>Updated <time datetime={review.updated}>{formatDate(review.updated)}</time></span>
      <a href={`${base}${review.brandPath.replace(/^\//, '')}`}>{review.brandLinkLabel ?? `More ${review.brand} reviews`}</a>
    </footer>
  </div>
</main>
<script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
<script>
  document.querySelectorAll<HTMLElement>('[data-review-video]').forEach((root) => {
    const button = root.querySelector<HTMLButtonElement>('.review-video-poster');
    button?.addEventListener('click', () => {
      const id = root.dataset.reviewVideo;
      if (!id || root.querySelector('iframe')) return;
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1`;
      frame.title = button.getAttribute('aria-label')?.replace(/^Play /, '') || 'Independent video review';
      frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      frame.allowFullscreen = true;
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      button.replaceWith(frame);
      frame.focus();
    }, { once: true });
  });
</script>
