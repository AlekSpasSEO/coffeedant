---
import type { ReviewDimension } from '../../data/reviews';
import ResponsiveTable from './ResponsiveTable.astro';

const { dimension } = Astro.props as { dimension: ReviewDimension };
---

<div class="review-performance-detail" id={`${dimension.id}-performance`}>
  <header class="review-performance-heading">
    <div>
      <p class="review-performance-kicker">{dimension.label} assessment</p>
      <h3>{dimension.deepDive.title}</h3>
    </div>
    <div class="review-performance-score" aria-label={dimension.score === null ? `${dimension.label} not scored` : `${dimension.score.toFixed(1)} out of 10`}>
      <strong>{dimension.score === null ? 'N/A' : dimension.score.toFixed(1)}</strong>
      {dimension.score !== null && <span>out of 10</span>}
    </div>
  </header>
  {dimension.deepDive.intro.map((paragraph) => <p>{paragraph}</p>)}
  <ResponsiveTable table={dimension.deepDive.table} />
  {dimension.deepDive.diagnosis && dimension.deepDive.diagnosis.length > 0 && (
    <div class="review-diagnosis-grid" aria-label={`${dimension.label} diagnostics and decisions`}>
      {dimension.deepDive.diagnosis.map((item) => (
        <div><strong>{item.signal}</strong><span>{item.guidance}</span></div>
      ))}
    </div>
  )}
  {dimension.deepDive.note && <p class="review-note"><strong>Evidence note:</strong> {dimension.deepDive.note}</p>}
</div>
