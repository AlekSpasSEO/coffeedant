---
import type { ReviewTable } from '../../data/reviews';

const { table } = Astro.props as { table: ReviewTable };
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const basePath = base.replace(/\/$/, '');
const rowLink = (href?: string) => href?.startsWith('/')
  ? href === basePath || href.startsWith(`${basePath}/`)
    ? href
    : `${base}${href.replace(/^\//, '')}`
  : href;
---

<div class="review-table-wrap" role="region" aria-label={table.caption} tabindex="0">
  <table class="review-table">
    <caption class="sr-only">{table.caption}</caption>
    <thead>
      <tr>
        {table.columns.map((column) => <th scope="col">{column.label}</th>)}
      </tr>
    </thead>
    <tbody>
      {table.rows.map((row) => (
        <tr>
          {table.columns.map((column, index) => index === 0 ? (
            <th scope="row" data-label={column.label}>
              {row.href ? <a href={rowLink(row.href)}>{row[column.key]}</a> : row[column.key]}
            </th>
          ) : (
            <td data-label={column.label}>{row[column.key]}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
