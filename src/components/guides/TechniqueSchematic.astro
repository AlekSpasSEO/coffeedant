---
import '../../styles/guide-evidence.css';
const {schematic,id}=Astro.props;
const kind=schematic.kind;
const options:Record<string,string[]>={'burr-cross-section':['Conical','Flat'],'level-tamp':['Level','Tilted'],'machine-workflow':['Shared boiler','Independent boilers'],'distribution-depth':['Uneven bed','Prepared bed']};
const variants=options[kind];
---
<div class="guide-schematic" data-technique-schematic={kind}>
 <p class="guide-evidence-label">Visual explanation / Explore the mechanism</p><h3>{schematic.title}</h3><p>{schematic.caption}</p>
 {variants&&<div class="guide-schematic-controls" role="group" aria-label={schematic.title}>{variants.map((label,index)=><button type="button" data-technique-choice={index} aria-pressed={index===0?'true':'false'}>{label}</button>)}</div>}
 {kind==='burr-cross-section'&&<>
  <svg viewBox="0 0 620 260" role="img" aria-labelledby={`${id}-diagram-title`}><title id={`${id}-diagram-title`}>Conceptual coffee paths through conical and flat burrs</title>
   <g data-technique-panel="0"><path class="diagram-path" d="M150 55L210 205H410L470 55M255 185L310 55L365 185"/><path class="diagram-coffee" d="M282 125L310 65L338 125Z"/><path class="diagram-arrow" d="M310 10v35m-8-9 8 9 8-9M190 145l18 43m-11-4 11 4 3-11M430 145l-18 43m-3-11 3 11 11-4"/><text x="42" y="85">Outer ring</text><text x="445" y="230">Exit</text><text x="255" y="240">Inner cone</text><text class="diagram-note" x="242" y="25">Coffee enters above</text></g>
   <g data-technique-panel="1" hidden><rect class="diagram-box" x="155" y="78" width="310" height="30" rx="8"/><rect class="diagram-box" x="155" y="147" width="310" height="30" rx="8"/><path class="diagram-arrow" d="M310 25v92m0 9H90m12-8-12 8 12 8M310 126h220m-12-8 12 8-12 8"/><text x="224" y="55">Feed near the center</text><text x="220" y="218">Opposing flat discs</text><text class="diagram-note" x="195" y="245">Ground coffee moves outward</text></g>
  </svg>
 </>}
 {kind==='basket-headspace'&&<>
  <div class="guide-schematic-controls"><label>Illustrative dry dose: <output data-technique-dose-output>18 g</output><input type="range" min="14" max="22" value="18" step="1" data-technique-dose aria-label="Illustrative dry coffee dose"/></label></div>
  <svg viewBox="0 0 620 270" role="img" aria-labelledby={`${id}-diagram-title`}><title id={`${id}-diagram-title`}>Qualitative basket cross-section: dose changes bed height and available clearance</title><path class="diagram-path" d="M165 72L205 235H415L455 72"/><rect class="diagram-box" x="160" y="45" width="300" height="15"/><polygon class="diagram-coffee" points="184,150 436,150 415,235 205,235" data-dose-bed/><path class="diagram-arrow" d="M475 75v65m-8-8 8 8 8-8"/><text x="180" y="30">Shower screen</text><text x="478" y="110">Clearance</text><text x="254" y="200">Coffee bed</text><text class="diagram-note" x="25" y="264">Same coffee: more mass raises the bed. Different coffee: volume can change.</text></svg>
  <p>No universal dose or clearance is encoded in this drawing. {schematic.numbers.map(number=><>{number.label}: {number.value}. {number.scope}</>)}</p>
 </>}
 {kind==='level-tamp'&&<svg viewBox="0 0 620 260" role="img" aria-labelledby={`${id}-diagram-title`}><title id={`${id}-diagram-title`}>Level and tilted tamper alignment in a basket</title><path class="diagram-path" d="M165 75L200 225H420L455 75"/><g data-technique-panel="0"><polygon class="diagram-coffee" points="178,130 442,130 420,225 200,225"/><rect class="diagram-box" x="175" y="112" width="270" height="18"/><rect class="diagram-box" x="295" y="48" width="30" height="64"/><path class="diagram-arrow" d="M310 8v32m-8-8 8 8 8-8"/><text x="208" y="252">Square base, level surface</text></g><g data-technique-panel="1" hidden><polygon class="diagram-coffee" points="178,112 442,148 420,225 200,225"/><g transform="rotate(8 310 130)"><rect class="diagram-box" x="175" y="112" width="270" height="18"/><rect class="diagram-box" x="295" y="48" width="30" height="64"/></g><text x="164" y="252">Tilt changes alignment; extra force does not level it.</text></g></svg>}
 {kind==='machine-workflow'&&<svg viewBox="0 0 620 280" role="img" aria-labelledby={`${id}-diagram-title`}><title id={`${id}-diagram-title`}>Shared boiler sequence versus separate brew and steam paths</title><g data-technique-panel="0"><rect class="diagram-box" x="20" y="95" width="130" height="65"/><rect class="diagram-box" x="245" y="95" width="130" height="65"/><rect class="diagram-box" x="470" y="95" width="130" height="65"/><path class="diagram-arrow" d="M150 128h85m-10-8 10 8-10 8M375 128h85m-10-8 10 8-10 8"/><text x="43" y="134">Brew state</text><text x="266" y="122">Change to</text><text x="265" y="144">steam state</text><text x="486" y="123">Return to</text><text x="485" y="145">brew state</text><text class="diagram-note" x="70" y="218">One heater system. Follow the exact manual when changing modes.</text></g><g data-technique-panel="1" hidden><rect class="diagram-box" x="60" y="55" width="160" height="60"/><rect class="diagram-box" x="60" y="170" width="160" height="60"/><rect class="diagram-box" x="385" y="55" width="175" height="60"/><rect class="diagram-box" x="385" y="170" width="175" height="60"/><path class="diagram-arrow" d="M220 85h150M220 200h150"/><text x="80" y="91">Brew boiler</text><text x="75" y="206">Steam boiler</text><text x="411" y="91">Espresso</text><text x="407" y="206">Milk steaming</text><text class="diagram-note" x="90" y="260">Independent circuits can overlap on machines documented to support it.</text></g></svg>}
 {kind==='ratio-scale'&&<>
  <div class="guide-schematic-controls"><label>Keep the dose at 18 g. Choose the beverage ratio: <output data-technique-ratio-output>1 : 2</output><input type="range" min="1" max="3" step="0.1" value="2" data-technique-ratio aria-label="Espresso beverage ratio"/></label></div>
  <svg viewBox="0 0 620 240" role="img" aria-labelledby={`${id}-diagram-title`}><title id={`${id}-diagram-title`}>Worked espresso ratio: eighteen grams of coffee yields eighteen to fifty-four grams of beverage</title><rect class="diagram-box" x="30" y="58" width="180" height="108" rx="10"/><path class="diagram-arrow" d="M230 115h100m-12-8 12 8-12 8"/><path class="diagram-path" d="M370 65v110h165V65M535 80h30v60h-30"/><rect class="diagram-coffee" x="373" y="108" width="159" height="64" data-ratio-liquid/><text x="71" y="103">Dry coffee</text><text x="80" y="135">18 g dose</text><text x="370" y="211" data-technique-yield>36 g beverage</text></svg>
  <p>Recipe arithmetic, not a prediction of extraction or preference. Taste at a stable dose before deciding which yield to keep.</p>
 </>}
 {kind==='distribution-depth'&&<svg viewBox="0 0 620 260" role="img" aria-labelledby={`${id}-diagram-title`}><title id={`${id}-diagram-title`}>Conceptual coffee bed before and after distribution through its depth</title><rect class="diagram-box" x="100" y="55" width="420" height="155" rx="8"/><g data-technique-panel="0">{[[160,90],[165,105],[179,93],[186,111],[380,142],[391,137],[388,158],[399,160],[405,140],[270,180],[281,172]].map(([x,y])=><circle class="diagram-coffee" cx={x} cy={y} r="12"/>)}<text x="125" y="243">Clumps and gaps: surface tidiness cannot show the whole bed.</text></g><g data-technique-panel="1" hidden>{Array.from({length:32},(_,i)=><circle class="diagram-coffee" cx={135+(i%8)*50} cy={83+Math.floor(i/8)*34} r="8"/>)}<text x="131" y="243">Illustrative distribution through depth; no measured flow claim.</text></g></svg>}
 {kind==='immersion-timeline'&&<>
  <div class="guide-schematic-controls"><button type="button" data-technique-next>Next preparation step →</button></div>
  <svg viewBox="0 0 620 260" role="img" aria-labelledby={`${id}-diagram-title`}><title id={`${id}-diagram-title`}>Upright AeroPress preparation: dose, water, steep, stir and press</title><rect class="diagram-path" x="235" y="35" width="150" height="175"/><rect class="diagram-box" x="227" y="19" width="166" height="17"/><rect class="diagram-water" x="239" y="83" width="142" height="123"/><rect class="diagram-coffee" x="239" y="192" width="142" height="14"/><path class="diagram-path" d="M245 223v28h130v-28"/><text x="35" y="107">14 g coffee</text><text x="35" y="144">200 g water</text><text x="428" y="110">60 s steep</text><text x="425" y="147">Gentle press</text></svg>
  <p aria-live="polite" data-technique-step>{schematic.steps[0]}</p><ol data-technique-steps>{schematic.steps.map(step=><li>{step}</li>)}</ol><p>This is the cited roaster's upright AeroPress recipe, not a universal Nordic brewing standard.</p>
 </>}
 <p class="guide-schematic-source">Basis: {schematic.sourceUrls.map((source,index)=><>{index>0?' · ':''}<a href={source} target="_blank" rel="noopener noreferrer">Source {index+1} ↗</a></>)}</p>
</div>
<script>
 document.querySelectorAll<HTMLElement>('[data-technique-schematic]').forEach(root=>{
  root.querySelectorAll<HTMLButtonElement>('[data-technique-choice]').forEach(button=>button.addEventListener('click',()=>{root.querySelectorAll('[data-technique-choice]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));root.querySelectorAll<HTMLElement>('[data-technique-panel]').forEach(panel=>panel.toggleAttribute('hidden',panel.dataset.techniquePanel!==button.dataset.techniqueChoice));}));
  root.querySelector<HTMLInputElement>('[data-technique-dose]')?.addEventListener('input',event=>{const dose=Number((event.target as HTMLInputElement).value),top=150-(dose-18)*10;root.querySelector('[data-technique-dose-output]')!.textContent=`${dose} g`;root.querySelector('[data-dose-bed]')!.setAttribute('points',`${165+(top-72)*40/163},${top} ${455-(top-72)*40/163},${top} 415,235 205,235`);});
  root.querySelector<HTMLInputElement>('[data-technique-ratio]')?.addEventListener('input',event=>{const ratio=Number((event.target as HTMLInputElement).value);root.querySelector('[data-technique-ratio-output]')!.textContent=`1 : ${ratio}`;root.querySelector('[data-technique-yield]')!.textContent=`${Number((18*ratio).toFixed(1))} g beverage`;const height=32*ratio,liquid=root.querySelector('[data-ratio-liquid]')!;liquid.setAttribute('y',String(172-height));liquid.setAttribute('height',String(height));});
  let step=0;const steps=[...root.querySelectorAll('[data-technique-steps] li')];root.querySelector('[data-technique-next]')?.addEventListener('click',()=>{step=(step+1)%steps.length;root.querySelector('[data-technique-step]')!.textContent=steps[step].textContent;});
 });
</script>
