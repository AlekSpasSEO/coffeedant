---
import HomeLayout from '../../layouts/HomeLayout.astro';
import '../../styles/review.css';
import { beginnerGuide } from '../../data/beginner-guide';

const guide = Astro.props.guide ?? beginnerGuide;
const isBuiltIn = guide.canonicalPath === '/espresso-machine/built-in-grinder/';
const isBudget = guide.canonicalPath === '/espresso-machine/cheap-budget-under-500/';
const isProsumer = guide.canonicalPath === '/espresso-machine/prosumer-under-1000/';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const assetUrl = (path: string) => /^https?:\/\//i.test(path) ? path : `${base}${path.replace(/^\//, '')}`;
const pageUrl = (path: string) => `${base}${path.replace(/^\//, '')}`;
const canonical = new URL(guide.canonicalPath.replace(/^\//, ''), 'https://coffeedant.com/').toString();
const formatDate = (date: string, short = false) => new Intl.DateTimeFormat('en-US', {
  month: short ? 'short' : 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC',
}).format(new Date(`${date}T00:00:00Z`));
const isCommunity = (href: string) => /reddit\.com/i.test(href);
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article', '@id': `${canonical}#article`, headline: guide.title,
      description: guide.description, genre: 'Research-led buying guide', articleSection: 'Espresso machine buying guides',
      inLanguage: 'en-US', datePublished: guide.published, dateModified: guide.updated,
      mainEntityOfPage: canonical, image: guide.media.map((item) => assetUrl(item.src)),
      author: { '@type': 'Person', name: guide.author.name, jobTitle: guide.author.role, image: assetUrl(guide.author.image), url: 'https://coffeedant.com/about/' },
      publisher: { '@type': 'Organization', name: 'Coffeedant', url: 'https://coffeedant.com/' },
      citation: guide.sources.map((source) => source[1]),
    },
    {
      '@type': 'VideoObject', name: guide.video.title, description: guide.video.note,
      thumbnailUrl: `https://img.youtube.com/vi/${guide.video.id}/hqdefault.jpg`, uploadDate: guide.video.published,
      duration: guide.video.duration, embedUrl: `https://www.youtube-nocookie.com/embed/${guide.video.id}`,
      contentUrl: `https://www.youtube.com/watch?v=${guide.video.id}`,
    },
    {
      '@type': 'FAQPage', mainEntity: guide.faqs.map(([question, answer]) => ({
        '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer },
      })),
    },
    {
      '@type': 'BreadcrumbList', itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://coffeedant.com/' },
        { '@type': 'ListItem', position: 2, name: 'Espresso machines', item: 'https://coffeedant.com/espresso-machine/' },
        { '@type': 'ListItem', position: 3, name: isBuiltIn ? 'Machines with grinders' : isBudget ? 'Machines under $500' : isProsumer ? 'Prosumer machines under $1,000' : 'Machines for beginners', item: canonical },
      ],
    },
  ],
};
const jumpLinks = [
  ['decision', 'Choose a workflow'], ['criteria', 'Criteria'], ['compare', 'Compare'], ['grinder', 'Grinder'],
  ['milk', 'Milk'], ['ownership', 'Ownership'], ['picks', 'Picks'], ['first-week', 'First week'],
  ['community', 'Owners'], ['faq', 'FAQ'], ['video', 'Video'], ['methodology', 'Methodology'], ['sources', 'Sources'], ['verdict', 'Verdict'],
];
const mediaAfter: Record<string, number> = { grinder: 0, ownership: 1 };
const labels = isBuiltIn ? {
  breadcrumb: 'Machines with grinders', heroOverline: 'Built-in grinder buying guide · research-led',
  h1: 'Best espresso machines with a grinder',
  deck: 'A grinder inside the machine can mean manual espresso, assisted puck preparation or one-touch coffee. Choose the work you want the machine to remove before comparing menus or burr counts.',
  article: 'Espresso machines with a grinder buying guide', decisionTitle: 'Choose how much of the coffee should happen inside the machine',
  compareTitle: 'Four integrated systems, three different levels of involvement', quickCaption: 'Quick comparison, exact current US or North American models',
  faqTitle: 'Espresso machines with a grinder FAQ', videoOverline: 'See the automatic category',
  videoTitle: 'An independent bean-to-cup comparison', methodologyTitle: 'Exact models first, workflow categories kept separate',
  sourcePrefix: 'built-in-grinder', footerLabel: 'Compare all espresso machine routes',
} : isBudget ? {
  breadcrumb: 'Machines under $500', heroOverline: 'Budget espresso buying guide · research-led',
  h1: 'Best espresso machines under $500',
  deck: 'A $500 machine cap creates four very different paths: rapid pump espresso, forgiving pressurized baskets, direct lever pressure, or a dual-arm manual ritual. Price the complete station before choosing the machine.',
  article: 'Espresso machines under $500 buying guide', decisionTitle: 'Choose where the $500 limit applies before comparing machines',
  compareTitle: 'Four credible machines below $500, with different support costs', quickCaption: 'Quick comparison, exact current US models or packages',
  faqTitle: 'Espresso machines under $500 FAQ', videoOverline: 'See the price class tested',
  videoTitle: 'An independent comparison of affordable espresso machines', methodologyTitle: 'A strict machine-price ceiling, exact models and complete-station context',
  sourcePrefix: 'under-500', footerLabel: 'Compare all espresso machine routes',
} : isProsumer ? {
  breadcrumb: 'Prosumer machines under $1,000', heroOverline: 'Prosumer espresso buying guide · research-led',
  h1: 'Best prosumer espresso machines under $1,000',
  deck: 'Below $1,000, “prosumer” means a focused manual platform rather than dual boilers or café throughput. Choose between factory temperature control, the 58 mm ecosystem, stronger steam, and direct lever pressure.',
  article: 'Prosumer espresso machines under $1,000 buying guide', decisionTitle: 'Choose the control you will use before choosing the heaviest machine',
  compareTitle: 'Four specialist machines below $1,000, with four different compromises', quickCaption: 'Quick comparison, exact current US or regional models',
  faqTitle: 'Prosumer espresso machines under $1,000 FAQ', videoOverline: 'See the price class in use',
  videoTitle: 'An independent under-$1,000 machine review', methodologyTitle: 'A strict machine cap, exact regional models and complete-station costs',
  sourcePrefix: 'prosumer-under-1000', footerLabel: 'Compare all espresso machine routes',
} : {
  breadcrumb: 'Machines for beginners', heroOverline: 'First-machine buying guide · research-led',
  h1: 'Best espresso machines for beginners',
  deck: 'Choose the workflow before the machine. These four exact models remove different jobs: milk technique, separate-grinder shopping, manual puck preparation, or almost all of the visible process.',
  article: 'Beginner espresso machine buying guide', decisionTitle: 'Build the shortlist from the jobs you want to keep',
  compareTitle: 'Four different beginner workflows', quickCaption: 'Quick comparison, exact US or North American models',
  faqTitle: 'Beginner espresso machine FAQ', videoOverline: 'See the fundamentals',
  videoTitle: 'An independent beginner technique overview', methodologyTitle: 'Exact models first, observed workflow second, anecdotes kept in proportion',
  sourcePrefix: 'beginner', footerLabel: 'Compare all espresso machine routes',
};
const selectorGroups = isBuiltIn ? [
  { name: 'control', legend: 'How much control do you want?', options: [['manual', 'Manual espresso'], ['assisted', 'Guided preparation'], ['automatic', 'One-touch drinks']] },
  { name: 'milk', legend: 'Who should texture the milk?', options: [['wand', 'I will steam'], ['carafe', 'The machine'], ['either', 'Either is fine']] },
  { name: 'priority', legend: 'What matters most?', options: [['speed', 'Fast routine'], ['shared', 'Easy to share'], ['premium', 'Premium menu']] },
] : isBudget ? [
  { name: 'power', legend: 'How should pressure be created?', options: [['pump', 'Electric pump'], ['lever', 'Manual lever'], ['either', 'Either is fine']] },
  { name: 'milk', legend: 'How often do you make milk drinks?', options: [['daily', 'Most days'], ['sometimes', 'Sometimes'], ['never', 'Rarely or never']] },
  { name: 'priority', legend: 'What matters most?', options: [['speed', 'Fast routine'], ['lowest', 'Lowest entry cost'], ['control', 'Hands-on control']] },
] : isProsumer ? [
  { name: 'control', legend: 'Which control matters most?', options: [['pid', 'Factory PID'], ['ecosystem', '58 mm ecosystem'], ['pressure', 'Pressure profiling']] },
  { name: 'milk', legend: 'How often do you steam milk?', options: [['often', 'Often'], ['sometimes', 'Sometimes'], ['never', 'Rarely or never']] },
  { name: 'priority', legend: 'What matters most?', options: [['value', 'Lowest machine cost'], ['build', 'Traditional build'], ['feedback', 'Visible feedback']] },
] : [
  { name: 'drink', legend: 'What do you drink most?', options: [['milk', 'Milk drinks'], ['espresso', 'Espresso'], ['mixed', 'A mix']] },
  { name: 'effort', legend: 'How involved should mornings feel?', options: [['guided', 'Guided manual'], ['craft', 'Hands-on craft'], ['automatic', 'Push button']] },
  { name: 'priority', legend: 'What matters most?', options: [['modular', 'Upgrade freedom'], ['integrated', 'One station'], ['shared', 'Easy to share']] },
];
const selectorCandidates = isBuiltIn ? [
  { signals: 'manual wand speed', brand: 'Breville', name: 'Barista Pro', note: 'Fast manual espresso with an integrated 30-step grinder.', setup: 'Best fit: one skilled user', compromise: 'Main limit: manual puck and milk work', href: '/espresso-machine/breville-barista-pro-bes878/' },
  { signals: 'assisted wand shared', brand: 'Breville', name: 'Barista Express Impress', note: 'Dose feedback and assisted tamping without automatic milk.', setup: 'Best fit: shared manual station', compromise: 'Main limit: slower thermocoil routine', href: '/espresso-machine/breville-barista-express-impress-bes876/' },
  { signals: 'automatic carafe shared speed', brand: 'De’Longhi', name: 'Magnifica Evo', note: 'Fresh-bean coffee and milk without a portafilter.', setup: 'Best fit: simple one-touch drinks', compromise: 'Main limit: less direct espresso control', href: '/espresso-machine/delonghi-magnifica-evo/' },
  { signals: 'automatic carafe premium either', brand: 'JURA', name: 'E8', note: 'A premium 27-specialty automatic with a closed brew system.', setup: 'Best fit: premium shared menu', compromise: 'Main limit: $2,599 reference and stock', href: '/espresso-machine/jura-e8/' },
] : isBudget ? [
  { signals: 'pump daily speed', brand: 'Breville', name: 'Bambino Plus', note: 'Fast electric heat and automatic or manual milk at the top of the cap.', setup: 'Best fit: frequent milk drinks', compromise: 'Main limit: grinder sold separately', href: '/espresso-machine/breville-bambino/' },
  { signals: 'pump sometimes lowest', brand: 'De’Longhi', name: 'ECP3420', note: 'A low-cost pump machine with pressurized baskets and a manual frother.', setup: 'Best fit: modest first station', compromise: 'Main limit: small sequential heater', href: '/espresso-machine/delonghi-ecp3420/' },
  { signals: 'lever never lowest control', brand: 'Flair', name: 'Classic', note: 'A gauge-equipped direct lever with forgiving and bottomless paths.', setup: 'Best fit: deliberate straight espresso', compromise: 'Main limit: kettle and grinder remain external', href: '/espresso-machine/flair-classic/' },
  { signals: 'lever sometimes control either', brand: 'ROK', name: 'EspressoGC Black PLUS', note: 'A dual-arm press with standard and Smartshot baskets plus a hand frother.', setup: 'Best fit: tactile manual workflow', compromise: 'Main limit: no heater or pressure gauge', href: '/espresso-machine/rok-espresso-gc/' },
] : isProsumer ? [
  { signals: 'ecosystem sometimes value', brand: 'Gaggia', name: 'Classic Pro E24', note: 'The lowest-cost 58 mm brass-boiler platform in the shortlist.', setup: 'Best fit: grinder-first budget', compromise: 'Main limit: no stock PID or timer', href: '/espresso-machine/gaggia-classic-evo/' },
  { signals: 'pid sometimes feedback value', brand: 'Lelit', name: 'Anna PL41TEM', note: 'Factory PID and pressure feedback in a compact LELIT57 machine.', setup: 'Best fit: temperature-focused value', compromise: 'Main limit: 57 mm tools and a small boiler', href: '/espresso-machine/lelit-anna/' },
  { signals: 'ecosystem often build', brand: 'Rancilio', name: 'Silvia V6', note: 'A dense 58 mm traditional machine with stronger steam and a manual thermostat rhythm.', setup: 'Best fit: long-term traditionalist', compromise: 'Main limit: $995 with no stock PID', href: '/espresso-machine/rancilio-silvia/' },
  { signals: 'pressure never feedback', brand: 'Flair', name: '58 Plus 2', note: 'A heated 58 mm lever with gauge-guided pressure control.', setup: 'Best fit: straight-espresso profiling', compromise: 'Main limit: no pump, boiler or milk system', href: '/espresso-machine/flair-58/' },
] : [
  { signals: 'milk guided modular', brand: 'Breville', name: 'Bambino Plus', note: 'Automatic milk, manual coffee, separate grinder.', setup: 'Best fit: regular milk drinks', compromise: 'Main limit: grinder sold separately', href: '/espresso-machine/breville-bambino/' },
  { signals: 'espresso craft modular', brand: 'Gaggia', name: 'Classic Pro E24', note: 'Traditional 58 mm single-boiler learning.', setup: 'Best fit: craft-first espresso', compromise: 'Main limit: manual temperature routine', href: '/espresso-machine/gaggia-classic-evo/' },
  { signals: 'mixed guided integrated', brand: 'Breville', name: 'Barista Express', note: 'One-box grinder and manual espresso station.', setup: 'Best fit: one familiar station', compromise: 'Main limit: fixed integrated grinder', href: '/espresso-machine/breville-barista-express-bes870xl/' },
  { signals: 'milk automatic shared', brand: 'De’Longhi', name: 'Magnifica Evo', note: 'Fresh-bean drinks without a portafilter.', setup: 'Best fit: shared push-button use', compromise: 'Main limit: less manual control', href: '/espresso-machine/delonghi-magnifica-evo/' },
];
---

<HomeLayout
  title={`${guide.title} | Coffeedant`}
  description={guide.description}
  canonicalPath={guide.canonicalPath}
  image={guide.media[0].src}
  imageAlt={guide.media[0].alt}
  ogType="article"
  published={guide.published}
  updated={guide.updated}
>
  <main id="main-content" class="review-page guide-page" tabindex="-1">
    <div class="review-shell">
      <nav class="review-breadcrumbs" aria-label="Breadcrumb">
        <a href={base}>Home</a><span aria-hidden="true">/</span>
        <a href={`${base}espresso-machine/`}>Espresso machines</a><span aria-hidden="true">/</span>
        <span aria-current="page">{labels.breadcrumb}</span>
      </nav>

      <section class="hub-hero guide-hero" aria-labelledby="guide-title">
        <div class="guide-hero-copy">
          <p class="review-overline">{labels.heroOverline}</p>
          <h1 id="guide-title">{labels.h1}</h1>
          <p class="guide-deck">{labels.deck}</p>
          <div class="guide-fast-answer">
            <strong>Fast answer</strong>
            {isBuiltIn ? <p><a href={pageUrl('/espresso-machine/breville-barista-pro-bes878/')}>Barista Pro</a> is the speed-first manual choice. <a href={pageUrl('/espresso-machine/breville-barista-express-impress-bes876/')}>Barista Express Impress</a> assists dosing and tamping, <a href={pageUrl('/espresso-machine/delonghi-magnifica-evo/')}>Magnifica Evo</a> is the value one-touch choice, and <a href={pageUrl('/espresso-machine/jura-e8/')}>JURA E8</a> is the premium automatic benchmark.</p> : isBudget ? <p><a href={pageUrl('/espresso-machine/breville-bambino/')}>Bambino Plus</a> is the fast milk-drink choice. <a href={pageUrl('/espresso-machine/delonghi-ecp3420/')}>ECP3420</a> is the lowest-cost electric option, <a href={pageUrl('/espresso-machine/flair-classic/')}>Flair Classic</a> is the gauge-equipped lever value, and <a href={pageUrl('/espresso-machine/rok-espresso-gc/')}>ROK EspressoGC</a> is the tactile dual-arm alternative.</p> : isProsumer ? <p><a href={pageUrl('/espresso-machine/gaggia-classic-evo/')}>Classic Pro E24</a> protects the grinder budget. <a href={pageUrl('/espresso-machine/lelit-anna/')}>Anna PL41TEM</a> adds a factory PID, <a href={pageUrl('/espresso-machine/rancilio-silvia/')}>Silvia V6</a> is the traditional-build choice, and <a href={pageUrl('/espresso-machine/flair-58/')}>Flair 58 Plus 2</a> trades steam for direct pressure control.</p> : <p><a href={pageUrl('/espresso-machine/breville-bambino/')}>Bambino Plus</a> is the broadest starting point for milk drinks with a separate grinder. <a href={pageUrl('/espresso-machine/gaggia-classic-evo/')}>Classic E24</a> is for craft-first learning, <a href={pageUrl('/espresso-machine/breville-barista-express-bes870xl/')}>Barista Express</a> is the one-box manual station, and <a href={pageUrl('/espresso-machine/delonghi-magnifica-evo/')}>Magnifica Evo</a> is the no-portafilter choice.</p>}
          </div>
        </div>
        <aside class="review-author-card" aria-label="Author and publication details">
          <div class="review-author-head">
            <img src={assetUrl(guide.author.image)} width="48" height="48" alt={`${guide.author.name}, ${guide.author.role.toLowerCase()}`} decoding="async" />
            <div><span>Written by</span><strong>{guide.author.name}</strong><small>{guide.author.role}</small></div>
          </div>
          <dl class="review-author-dates">
            <div><dt>Published</dt><dd><time datetime={guide.published}>{formatDate(guide.published, true)}</time></dd></div>
            <div><dt>Updated</dt><dd><time datetime={guide.updated}>{formatDate(guide.updated, true)}</time></dd></div>
          </dl>
          <p><strong>A note from the author</strong>{guide.author.note}</p>
        </aside>
      </section>

      <nav class="review-jumpbar" aria-label="Guide sections">
        <span>In this guide</span><div>{jumpLinks.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}</div>
      </nav>

      <article class="review-article guide-article" aria-label={labels.article}>
        <section class="section review-section machine-guide" id="decision" aria-labelledby="decision-title">
          <header class="review-section-heading"><p class="review-overline"><span class="review-section-number">01</span>Start with the routine</p><h2 id="decision-title">{labels.decisionTitle}</h2></header>
          <div class="review-section-body machine-guide-grid">
            <form class="machine-guide-form">
              {selectorGroups.map((group) => <fieldset><legend>{group.legend}</legend>{group.options.map(([value, label], index) => <label><input type="radio" name={group.name} value={value} checked={index === 0} /><span>{label}</span></label>)}</fieldset>)}
              <button type="submit">Show my starting point →</button>
            </form>
            <div class="machine-guide-result" aria-live="polite"><span>Your current match</span><p class="guide-result-brand">{selectorCandidates[0].brand}</p><h3 class="guide-result-title">{selectorCandidates[0].name}</h3><p class="guide-result-note">{selectorCandidates[0].note}</p><div class="guide-result-meta"><span>{selectorCandidates[0].setup}</span><span>{selectorCandidates[0].compromise}</span></div><a class="guide-result-link" href={pageUrl(selectorCandidates[0].href)}>Read the review →</a></div>
            <div class="selector-data" hidden>{selectorCandidates.map((candidate) => <span data-signals={candidate.signals} data-brand={candidate.brand} data-name={candidate.name} data-note={candidate.note} data-setup={candidate.setup} data-compromise={candidate.compromise} data-href={pageUrl(candidate.href)}></span>)}</div>
          </div>
          <div class="review-section-body guide-framework-copy"><Fragment set:html={guide.sections.find((section) => section.id === 'decision')!.html} /></div>
        </section>

        <section class="section review-section" id="compare" aria-labelledby="compare-title">
          <header class="review-section-heading"><p class="review-overline"><span class="review-section-number">02</span>Quick comparison</p><h2 id="compare-title">{labels.compareTitle}</h2></header>
          <div class="review-section-body">
            <div class="review-table-wrap" role="region" aria-label="Quick beginner espresso machine comparison" tabindex="0">
              <table class="comparison-table review-table"><caption>{labels.quickCaption}</caption><thead><tr><th>Machine</th><th>Complete setup</th><th>Milk</th><th>Best fit</th><th></th></tr></thead><tbody>{guide.picks.map((pick) => <tr><th scope="row" data-label="Machine">{pick.name}<small>{pick.model}</small></th><td data-label="Complete setup">{pick.price}<br />{pick.setup}</td><td data-label="Milk">{pick.milk}</td><td data-label="Best fit">{pick.bestFit}</td><td data-label="Review"><a href={pageUrl(pick.href)}>Review →</a></td></tr>)}</tbody></table>
            </div>
            <details class="review-comparison-details"><summary>Open the detailed comparison</summary><div class="review-table-wrap" role="region" aria-label="Detailed beginner espresso machine comparison" tabindex="0"><table class="review-table review-table-detailed"><caption>Detailed workflow and ownership comparison</caption><thead><tr><th>Machine</th><th>Grinder</th><th>Maintenance</th><th>Avoid if</th><th>Decision</th></tr></thead><tbody>{guide.picks.map((pick) => <tr><th scope="row" data-label="Machine"><a href={pageUrl(pick.href)}>{pick.name}</a></th><td data-label="Grinder">{pick.grinder}</td><td data-label="Maintenance">{pick.maintenance}</td><td data-label="Avoid if">{pick.avoidIf}</td><td data-label="Decision">{pick.verdict}</td></tr>)}</tbody></table></div></details>
            <p class="review-table-note">Prices were checked September 25, 2026. Tax, color, stock, seller, bundles and promotions can change. Compare the complete station, not the machine-only number.</p>
          </div>
        </section>

        {guide.sections.filter((section) => !['decision', 'picks', 'verdict'].includes(section.id)).map((section, index) => (
          <section class:list={['section', 'review-section', { 'principles-section': section.id === 'criteria' }]} id={section.id} aria-labelledby={`${section.id}-title`}>
            <header class="review-section-heading"><p class="review-overline"><span class="review-section-number">{String(index + 3).padStart(2, '0')}</span>{section.eyebrow}</p><h2 id={`${section.id}-title`}>{section.title}</h2></header>
            <div class="review-section-body">
              <Fragment set:html={section.html} />
              {section.id === 'criteria' && <div class="principle-grid"><article><span>01</span><h3>Drink queue</h3><p>Count the actual drinks and whether milk follows every shot.</p></article><article><span>02</span><h3>Task ownership</h3><p>Name who dials in, steams, cleans and responds to prompts.</p></article><article><span>03</span><h3>Complete budget</h3><p>Include grinder, scale, water and care from the first day.</p></article><article><span>04</span><h3>Upgrade path</h3><p>Decide whether components should improve independently.</p></article></div>}
              {mediaAfter[section.id] !== undefined && (() => { const media = guide.media[mediaAfter[section.id]]; return <figure class="review-media review-inline-media" data-source-type="manufacturer" data-user-generated="false" data-usage-record={media.source}><a class="review-media-link" href={media.source} target="_blank" rel="noopener"><img src={assetUrl(media.src)} alt={media.alt} width={media.width} height={media.height} loading="lazy" decoding="async" /></a><figcaption><span class="review-media-source-badge">Manufacturer photo</span>{media.caption}<span class="review-media-credit"> Image: <a href={media.source} target="_blank" rel="noopener">{media.credit}</a>. Official manufacturer media; not a Coffeedant test photograph.</span></figcaption></figure>; })()}
            </div>
          </section>
        ))}

        <section class="section review-section" id="picks" aria-labelledby="picks-title">
          <header class="review-section-heading"><p class="review-overline"><span class="review-section-number">09</span>{guide.sections.find((section) => section.id === 'picks')!.eyebrow}</p><h2 id="picks-title">{guide.sections.find((section) => section.id === 'picks')!.title}</h2></header>
          <div class="review-section-body"><Fragment set:html={guide.sections.find((section) => section.id === 'picks')!.html} /><div class="guide-picks">{guide.picks.map((pick) => <a href={pageUrl(pick.href)}><span>{pick.brand} · {pick.model}</span><h3>{pick.name}</h3><p><strong>{pick.bestFit}</strong></p><p>{pick.avoidIf}</p><b>Read the full review →</b></a>)}</div></div>
        </section>

        <section class="section review-section" id="faq" aria-labelledby="faq-title">
          <header class="review-section-heading"><p class="review-overline"><span class="review-section-number">10</span>Visible answers</p><h2 id="faq-title">{labels.faqTitle}</h2></header>
          <div class="review-section-body"><div class="review-faq-list">{guide.faqs.map(([question, answer]) => <article class="review-faq-item"><h3>{question}</h3><p>{answer}</p></article>)}</div></div>
        </section>

        <section class="section review-section" id="video" aria-labelledby="video-title">
          <header class="review-section-heading"><p class="review-overline">{labels.videoOverline}</p><h2 id="video-title">{labels.videoTitle}</h2></header>
          <div class="review-section-body"><div class="review-video" data-review-video={guide.video.id}><button class="review-video-poster" type="button" aria-label={`Play ${guide.video.title}`}><img src={`https://img.youtube.com/vi/${guide.video.id}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" decoding="async" /><span class="review-play" aria-hidden="true">▶</span><span class="review-video-label">Play video</span></button><div class="review-video-copy"><p class="review-overline">{guide.video.creator}</p><h3>{guide.video.title}</h3><p>{guide.video.note}</p><a href={`https://www.youtube.com/watch?v=${guide.video.id}`} target="_blank" rel="noopener">Watch on YouTube <span aria-hidden="true">↗</span></a></div></div></div>
        </section>

        <section class="section review-section review-methodology" id="methodology" aria-labelledby="methodology-title">
          <header class="review-section-heading"><p class="review-overline">How the guide was built</p><h2 id="methodology-title">{labels.methodologyTitle}</h2></header>
          <div class="review-section-body">{isBuiltIn ? <><p>I checked current official pages, exact manuals or support routes, dated US price context and regional model codes for all four recommendations on September 25, 2026. Manufacturer documents control model identity and specified operation. Independent evaluations add observed workflow. Owner discussions identify questions about cleaning, bean switching and upgrade limits without establishing failure rates.</p><p>This is a research-led guide, not a Coffeedant side-by-side test. I did not treat integrated semi-automatics as identical to bean-to-cup machines, transfer specifications between generations, invent measurements or turn anecdotes into reliability statistics. The shortlist represents three different divisions of labor. Confirm the exact model, stock, seller, voltage, bundle, warranty and return terms before paying.</p></> : isBudget ? <><p>I checked exact US models or packages, current official pages and manuals, dated prices, independent evaluations and bounded owner context on September 25, 2026. The machine-only ceiling is strictly below or equal to $500 before tax and optional accessories. Manufacturer documents control identity and specified operation; independent work adds observed workflow; owner accounts identify questions without establishing rates.</p><p>This is a research-led guide, not a Coffeedant side-by-side test. I did not invent measurements, transfer facts between regional siblings, call a machine complete when it still needs a grinder or kettle, or rank value by the machine price alone. Confirm the exact model, delivered package, seller, voltage, stock, warranty and return terms before paying.</p></> : isProsumer ? <><p>I checked the exact current regional model, official documentation, dated machine price, independent evaluation and bounded owner context for every recommendation on September 25, 2026. The machine-only ceiling is $1,000 before tax, grinder, scale, water equipment and optional tools. Manufacturer sources control identity and specified operation; independent work adds observed workflow; owner accounts identify questions without establishing rates.</p><p>This is research-led, not a Coffeedant side-by-side test. I did not invent thermal measurements, transfer claims between voltage variants, call an aftermarket modification a factory feature, or treat weight as proof of cup quality. Confirm the exact model, voltage, delivered accessories, seller, warranty and return terms before paying.</p></> : <><p>I checked current official product pages, exact manuals or support routes, dated prices and regional model codes for all four recommendations on September 25, 2026. I then compared independent hands-on evaluations and owner discussions, using each for the question it can answer. Manufacturer documents control identity and specified operation. Independent reviews add observed workflow. Owner accounts identify questions but do not establish failure rates.</p><p>This is a research-led buying guide, not a Coffeedant side-by-side test. I did not invent measurements, transfer specifications between generations, treat a retailer review pool as representative, or rank the machines with an arbitrary score. The shortlist is intentionally small because it represents four different divisions of labor. Prices are dated observations, and buyers should confirm the exact model, seller, voltage, bundle, warranty and return terms.</p></>}</div>
        </section>

        <section class="section review-section" id="sources" aria-labelledby="sources-title">
          <header class="review-section-heading"><p class="review-overline">Check the evidence</p><h2 id="sources-title">Sources and further reading</h2></header>
          <div class="review-section-body"><ol class="review-source-list">{guide.sources.map(([label, href, note], index) => <li id={`${labels.sourcePrefix}-source-${index + 1}`}><a href={href} target="_blank" rel={isCommunity(href) ? 'ugc noopener' : 'noopener'}>{label} <span aria-hidden="true">↗</span></a><p>{note}</p></li>)}</ol></div>
        </section>

        <section class="section final-verdict" id="verdict" aria-labelledby="verdict-title">
          <p class="review-overline">The buying decision</p><h2 id="verdict-title">{guide.sections.find((section) => section.id === 'verdict')!.title}</h2><Fragment set:html={guide.sections.find((section) => section.id === 'verdict')!.html} />
        </section>
      </article>

      <footer class="review-meta-footer"><span>Published <time datetime={guide.published}>{formatDate(guide.published)}</time></span><span>Updated <time datetime={guide.updated}>{formatDate(guide.updated)}</time></span><a href={`${base}espresso-machine/`}>{labels.footerLabel}</a></footer>
    </div>
  </main>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  <script>
    document.querySelectorAll<HTMLElement>('.machine-guide').forEach((root) => {
      const form = root.querySelector<HTMLFormElement>('.machine-guide-form');
      const candidates = Array.from(root.querySelectorAll<HTMLElement>('.selector-data [data-signals]'));
      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        const selected = Array.from(form.querySelectorAll<HTMLInputElement>('input:checked')).map((input) => input.value);
        const match = candidates.map((candidate, index) => ({ candidate, index, score: selected.filter((value) => candidate.dataset.signals?.split(' ').includes(value)).length })).sort((a, b) => b.score - a.score || a.index - b.index)[0]?.candidate;
        if (!match) return;
        const put = (selector: string, value = '') => { const node = root.querySelector<HTMLElement>(selector); if (node) node.textContent = value; };
        put('.guide-result-brand', match.dataset.brand); put('.guide-result-title', match.dataset.name); put('.guide-result-note', match.dataset.note);
        const meta = root.querySelector<HTMLElement>('.guide-result-meta'); if (meta) meta.innerHTML = `<span>${match.dataset.setup ?? ''}</span><span>${match.dataset.compromise ?? ''}</span>`;
        const link = root.querySelector<HTMLAnchorElement>('.guide-result-link'); if (link) link.href = match.dataset.href ?? '#';
      });
    });
    document.querySelectorAll<HTMLElement>('[data-review-video]').forEach((root) => {
      root.querySelector<HTMLButtonElement>('.review-video-poster')?.addEventListener('click', (event) => {
        const button = event.currentTarget as HTMLButtonElement; const id = root.dataset.reviewVideo; if (!id) return;
        const frame = document.createElement('iframe'); frame.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1`; frame.title = button.getAttribute('aria-label')?.replace(/^Play /, '') || 'Independent video'; frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'; frame.allowFullscreen = true; button.replaceWith(frame); frame.focus();
      }, { once: true });
    });
  </script>
</HomeLayout>

