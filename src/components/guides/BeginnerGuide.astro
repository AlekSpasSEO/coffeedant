---
import HomeLayout from '../../layouts/HomeLayout.astro';
import '../../styles/review.css';
import { beginnerGuide } from '../../data/beginner-guide';

const guide = Astro.props.guide ?? beginnerGuide;
const isBuiltIn = guide.canonicalPath === '/espresso-machine/built-in-grinder/';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const assetUrl = (path: string) => /^https?:\/\//i.test(path) ? path : `${base}${path.replace(/^\//, '')}`;
const pageUrl = (path: string) => `${base}${path.replace(/^\//, '')}`;
const canonical = new URL(guide.canonicalPath.replace(/^\//, ''), 'https://coffeedant.com/').toString();
const formatDate = (date: string, short = false) => new Intl.DateTimeFormat('en-US', {
  month: short ? 'short' : 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC',
}).format(new Date(`${date}T00:00:00Z`));
const isCommunity = (href: string) => /reddit\.com/i.test(href);
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article', '@id': `${canonical}#article`, headline: guide.title,
      description: guide.description, genre: 'Research-led buying guide', articleSection: 'Espresso machine buying guides',
      inLanguage: 'en-US', datePublished: guide.published, dateModified: guide.updated,
      mainEntityOfPage: canonical, image: guide.media.map((item) => assetUrl(item.src)),
      author: { '@type': 'Person', name: guide.author.name, jobTitle: guide.author.role, image: assetUrl(guide.author.image), url: 'https://coffeedant.com/about/' },
      publisher: { '@type': 'Organization', name: 'Coffeedant', url: 'https://coffeedant.com/' },
      citation: guide.sources.map((source) => source[1]),
    },
    {
      '@type': 'VideoObject', name: guide.video.title, description: guide.video.note,
      thumbnailUrl: `https://img.youtube.com/vi/${guide.video.id}/hqdefault.jpg`, uploadDate: guide.video.published,
      duration: guide.video.duration, embedUrl: `https://www.youtube-nocookie.com/embed/${guide.video.id}`,
      contentUrl: `https://www.youtube.com/watch?v=${guide.video.id}`,
    },
    {
      '@type': 'FAQPage', mainEntity: guide.faqs.map(([question, answer]) => ({
        '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer },
      })),
    },
    {
      '@type': 'BreadcrumbList', itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://coffeedant.com/' },
        { '@type': 'ListItem', position: 2, name: 'Espresso machines', item: 'https://coffeedant.com/espresso-machine/' },
        { '@type': 'ListItem', position: 3, name: isBuiltIn ? 'Machines with grinders' : 'Machines for beginners', item: canonical },
      ],
    },
  ],
};
const jumpLinks = [
  ['decision', 'Choose a workflow'], ['criteria', 'Criteria'], ['compare', 'Compare'], ['grinder', 'Grinder'],
  ['milk', 'Milk'], ['ownership', 'Ownership'], ['picks', 'Picks'], ['first-week', 'First week'],
  ['community', 'Owners'], ['faq', 'FAQ'], ['video', 'Video'], ['methodology', 'Methodology'], ['sources', 'Sources'], ['verdict', 'Verdict'],
];
const mediaAfter: Record<string, number> = { grinder: 0, community: 1 };
const labels = isBuiltIn ? {
  breadcrumb: 'Machines with grinders', heroOverline: 'Built-in grinder buying guide Â· research-led',
  h1: 'Best espresso machines with a grinder',
  deck: 'A grinder inside the machine can mean manual espresso, assisted puck preparation or one-touch coffee. Choose the work you want the machine to remove before comparing menus or burr counts.',
  article: 'Espresso machines with a grinder buying guide', decisionTitle: 'Choose how much of the coffee should happen inside the machine',
  compareTitle: 'Four integrated systems, three different levels of involvement', quickCaption: 'Quick comparison, exact current US or North American models',
  faqTitle: 'Espresso machines with a grinder FAQ', videoOverline: 'See the automatic category',
  videoTitle: 'An independent bean-to-cup comparison', methodologyTitle: 'Exact models first, workflow categories kept separate',
  sourcePrefix: 'built-in-grinder', footerLabel: 'Compare all espresso machine routes',
} : {
  breadcrumb: 'Machines for beginners', heroOverline: 'First-machine buying guide Â· research-led',
  h1: 'Best espresso machines for beginners',
  deck: 'Choose the workflow before the machine. These four exact models remove different jobs: milk technique, separate-grinder shopping, manual puck preparation, or almost all of the visible process.',
  article: 'Beginner espresso machine buying guide', decisionTitle: 'Build the shortlist from the jobs you want to keep',
  compareTitle: 'Four different beginner workflows', quickCaption: 'Quick comparison, exact US or North American models',
  faqTitle: 'Beginner espresso machine FAQ', videoOverline: 'See the fundamentals',
  videoTitle: 'An independent beginner technique overview', methodologyTitle: 'Exact models first, observed workflow second, anecdotes kept in proportion',
  sourcePrefix: 'beginner', footerLabel: 'Compare all espresso machine routes',
};
const selectorGroups = isBuiltIn ? [
  { name: 'control', legend: 'How much control do you want?', options: [['manual', 'Manual espresso'], ['assisted', 'Guided preparation'], ['automatic', 'One-touch drinks']] },
  { name: 'milk', legend: 'Who should texture the milk?', options: [['wand', 'I will steam'], ['carafe', 'The machine'], ['either', 'Either is fine']] },
  { name: 'priority', legend: 'What matters most?', options: [['speed', 'Fast routine'], ['shared', 'Easy to share'], ['premium', 'Premium menu']] },
] : [
  { name: 'drink', legend: 'What do you drink most?', options: [['milk', 'Milk drinks'], ['espresso', 'Espresso'], ['mixed', 'A mix']] },
  { name: 'effort', legend: 'How involved should mornings feel?', options: [['guided', 'Guided manual'], ['craft', 'Hands-on craft'], ['automatic', 'Push button']] },
  { name: 'priority', legend: 'What matters most?', options: [['modular', 'Upgrade freedom'], ['integrated', 'One station'], ['shared', 'Easy to share']] },
];
const selectorCandidates = isBuiltIn ? [
  { signals: 'manual wand speed', brand: 'Breville', name: 'Barista Pro', note: 'Fast manual espresso with an integrated 30-step grinder.', setup: 'Best fit: one skilled user', compromise: 'Main limit: manual puck and milk work', href: '/espresso-machine/breville-barista-pro-bes878/' },
  { signals: 'assisted wand shared', brand: 'Breville', name: 'Barista Express Impress', note: 'Dose feedback and assisted tamping without automatic milk.', setup: 'Best fit: shared manual station', compromise: 'Main limit: slower thermocoil routine', href: '/espresso-machine/breville-barista-express-impress-bes876/' },
  { signals: 'automatic carafe shared speed', brand: 'Deâ€™Longhi', name: 'Magnifica Evo', note: 'Fresh-bean coffee and milk without a portafilter.', setup: 'Best fit: simple one-touch drinks', compromise: 'Main limit: less direct espresso control', href: '/espresso-machine/delonghi-magnifica-evo/' },
  { signals: 'automatic carafe premium either', brand: 'JURA', name: 'E8', note: 'A premium 27-specialty automatic with a closed brew system.', setup: 'Best fit: premium shared menu', compromise: 'Main limit: $2,599 reference and stock', href: '/espresso-machine/jura-e8/' },
] : [
  { signals: 'milk guided modular', brand: 'Breville', name: 'Bambino Plus', note: 'Automatic milk, manual coffee, separate grinder.', setup: 'Best fit: regular milk drinks', compromise: 'Main limit: grinder sold separately', href: '/espresso-machine/breville-bambino/' },
  { signals: 'espresso craft modular', brand: 'Gaggia', name: 'Classic Pro E24', note: 'Traditional 58 mm single-boiler learning.', setup: 'Best fit: craft-first espresso', compromise: 'Main limit: manual temperature routine', href: '/espresso-machine/gaggia-classic-evo/' },
  { signals: 'mixed guided integrated', brand: 'Breville', name: 'Barista Express', note: 'One-box grinder and manual espresso station.', setup: 'Best fit: one familiar station', compromise: 'Main limit: fixed integrated grinder', href: '/espresso-machine/breville-barista-express-bes870xl/' },
  { signals: 'milk automatic shared', brand: 'Deâ€™Longhi', name: 'Magnifica Evo', note: 'Fresh-bean drinks without a portafilter.', setup: 'Best fit: shared push-button use', compromise: 'Main limit: less manual control', href: '/espresso-machine/delonghi-magnifica-evo/' },
];
---

<HomeLayout
  title={`${guide.title} | Coffeedant`}
  description={guide.description}
  canonicalPath={guide.canonicalPath}
  image={guide.media[0].src}
  imageAlt={guide.media[0].alt}
  ogType="article"
  published={guide.published}
  updated={guide.updated}
>
  <main id="main-content" class="review-page guide-page" tabindex="-1">
    <div class="review-shell">
      <nav class="review-breadcrumbs" aria-label="Breadcrumb">
        <a href={base}>Home</a><span aria-hidden="true">/</span>
        <a href={`${base}espresso-machine/`}>Espresso machines</a><span aria-hidden="true">/</span>
        <span aria-current="page">{labels.breadcrumb}</span>
      </nav>

      <section class="hub-hero guide-hero" aria-labelledby="guide-title">
        <div class="guide-hero-copy">
          <p class="review-overline">{labels.heroOverline}</p>
          <h1 id="guide-title">{labels.h1}</h1>
          <p class="guide-deck">{labels.deck}</p>
          <div class="guide-fast-answer">
            <strong>Fast answer</strong>
            {isBuiltIn ? <p><a href={pageUrl('/espresso-machine/breville-barista-pro-bes878/')}>Barista Pro</a> is the speed-first manual choice. <a href={pageUrl('/espresso-machine/breville-barista-express-impress-bes876/')}>Barista Express Impress</a> assists dosing and tamping, <a href={pageUrl('/espresso-machine/delonghi-magnifica-evo/')}>Magnifica Evo</a> is the value one-touch choice, and <a href={pageUrl('/espresso-machine/jura-e8/')}>JURA E8</a> is the premium automatic benchmark.</p> : <p><a href={pageUrl('/espresso-machine/breville-bambino/')}>Bambino Plus</a> is the broadest starting point for milk drinks with a separate grinder. <a href={pageUrl('/espresso-machine/gaggia-classic-evo/')}>Classic E24</a> is for craft-first learning, <a href={pageUrl('/espresso-machine/breville-barista-express-bes870xl/')}>Barista Express</a> is the one-box manual station, and <a href={pageUrl('/espresso-machine/delonghi-magnifica-evo/')}>Magnifica Evo</a> is the no-portafilter choice.</p>}
          </div>
        </div>
        <aside class="review-author-card" aria-label="Author and publication details">
          <div class="review-author-head">
            <img src={assetUrl(guide.author.image)} width="48" height="48" alt={`${guide.author.name}, ${guide.author.role.toLowerCase()}`} decoding="async" />
            <div><span>Written by</span><strong>{guide.author.name}</strong><small>{guide.author.role}</small></div>
          </div>
          <dl class="review-author-dates">
            <div><dt>Published</dt><dd><time datetime={guide.published}>{formatDate(guide.published, true)}</time></dd></div>
            <div><dt>Updated</dt><dd><time datetime={guide.updated}>{formatDate(guide.updated, true)}</time></dd></div>
          </dl>
          <p><strong>A note from the author</strong>{guide.author.note}</p>
        </aside>
      </section>

      <nav class="review-jumpbar" aria-label="Guide sections">
        <span>In this guide</span><div>{jumpLinks.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}</div>
      </nav>

      <article class="review-article guide-article" aria-label={labels.article}>
        <section class="section review-section machine-guide" id="decision" aria-labelledby="decision-title">
          <header class="review-section-heading"><p class="review-overline"><span class="review-section-number">01</span>Start with the routine</p><h2 id="decision-title">{labels.decisionTitle}</h2></header>
          <div class="review-section-body machine-guide-grid">
            <form class="machine-guide-form">
              {selectorGroups.map((group) => <fieldset><legend>{group.legend}</legend>{group.options.map(([value, label], index) => <label><input type="radio" name={group.name} value={value} checked={index === 0} /><span>{label}</span></label>)}</fieldset>)}
              <button type="submit">Show my starting point â†’</button>
            </form>
            <div class="machine-guide-result" aria-live="polite"><span>Your current match</span><p class="guide-result-brand">{selectorCandidates[0].brand}</p><h3 class="guide-result-title">{selectorCandidates[0].name}</h3><p class="guide-result-note">{selectorCandidates[0].note}</p><div class="guide-result-meta"><span>{selectorCandidates[0].setup}</span><span>{selectorCandidates[0].compromise}</span></div><a class="guide-result-link" href={pageUrl(selectorCandidates[0].href)}>Read the review â†’</a></div>
            <div class="selector-data" hidden>{selectorCandidates.map((candidate) => <span data-signals={candidate.signals} data-brand={candidate.brand} data-name={candidate.name} data-note={candidate.note} data-setup={candidate.setup} data-compromise={candidate.compromise} data-href={pageUrl(candidate.href)}></span>)}</div>
          </div>
          <div class="review-section-body guide-framework-copy"><Fragment set:html={guide.sections.find((section) => section.id === 'decision')!.html} /></div>
        </section>

        <section class="section review-section" id="compare" aria-labelledby="compare-title">
          <header class="review-section-heading"><p class="review-overline"><span class="review-section-number">02</span>Quick comparison</p><h2 id="compare-title">{labels.compareTitle}</h2></header>
          <div class="review-section-body">
