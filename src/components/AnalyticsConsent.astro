---
const base = import.meta.env.BASE_URL;
---
<section class="analytics-consent" data-analytics-consent aria-label="Analytics cookie preferences" hidden>
  <h2>Analytics preferences</h2>
  <p data-analytics-copy="off">May we use Google Analytics cookies to understand which pages are useful?</p>
  <p data-analytics-copy="on" hidden>Analytics is on. We use Google Analytics cookies to understand which pages are useful. You can turn analytics off below.</p>
  <p>You can change your choice using Cookie preferences in the footer. <a href={`${base}privacy-policy/`}>Privacy policy</a></p>
  <p data-analytics-optout hidden>Your browser requests no optional tracking. Analytics will stay off while that setting is enabled.</p>
  <div>
    <button type="button" data-analytics-choice="granted"><span data-analytics-copy="off">Accept analytics</span><span data-analytics-copy="on" hidden>Keep analytics on</span></button>
    <button type="button" data-analytics-choice="denied"><span data-analytics-copy="off">Reject analytics</span><span data-analytics-copy="on" hidden>Turn off analytics</span></button>
  </div>
</section>
<style>
  .analytics-consent { position: fixed; z-index: 200; left: 18px; bottom: 18px; width: min(560px, calc(100% - 36px)); box-sizing: border-box; padding: 20px; border: 2px solid #24231f; background: #fffdf7; color: #24231f; box-shadow: 5px 5px 0 #24231f; font-family: Arial, sans-serif; }
  .analytics-consent[hidden] { display: none; }
  .analytics-consent h2 { margin: 0 0 8px; font-size: 1.15rem; line-height: 1.3; }
  .analytics-consent p { margin: 0 0 15px; font-size: .86rem; line-height: 1.5; }
  .analytics-consent a { color: inherit; text-decoration: underline; }
  .analytics-consent div { display: flex; flex-wrap: wrap; gap: 10px; }
  .analytics-consent button { flex: 1; min-width: 150px; padding: 10px 15px; border: 2px solid #24231f; background: #f3da00; color: #24231f; font: inherit; font-size: .85rem; font-weight: 700; cursor: pointer; }
  .analytics-consent button:focus-visible { outline: 3px solid #24704e; outline-offset: 3px; }
  @media print { .analytics-consent { display: none; } }
</style>
