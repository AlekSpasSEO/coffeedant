---
import editions from '../../localization/editions.json';
// Recovered from the original WordPress Site Kit settings. The other G-ID in
// that backup belongs to Site Kit telemetry, not the Coffeedant property.
const measurementId = 'G-270R14ZHVX';
const googleTagId = 'GT-KT5DM5FP';
const productionRegions = Object.fromEntries(editions.editions.map(({ host, id }) => [host, id]));
productionRegions['www.coffeedant.com'] = 'us';
---
<script id="coffeedant-ga4-bootstrap" is:inline define:vars={{ measurementId, googleTagId, productionRegions }} data-ga4-id={measurementId} data-google-tag-id={googleTagId}>
  (() => {
    // Never send localhost, GitHub Pages or Cloudflare preview traffic to GA4.
    if (!Object.prototype.hasOwnProperty.call(productionRegions, location.hostname)) return;
    // A repeated template/bootstrap must never configure a second page view.
    if (window.__coffeedantAnalyticsInitialized) return;
    window.__coffeedantAnalyticsInitialized = true;
    const storageKey = 'coffeedant.analytics-consent.v1';
    const maxAge = 180 * 24 * 60 * 60 * 1000;
    let choice = null;
    let configured = false;
    let tagState = 'idle';
    let attempts = 0;
    let retryTimer;
    let regionalMode = null;
    let policyPending = false;
    let policyResolved = false;
    let serverBrowserOptOut = false;
    let lookupController;
    let lookupVersion = 0;
    let preferencesOpener = null;
    const nativeBrowserOptOut = navigator.globalPrivacyControl === true || navigator.doNotTrack === '1';
    const browserOptOut = () => nativeBrowserOptOut || serverBrowserOptOut;
    window.dataLayer = window.dataLayer || [];
    window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
    window.gtag('consent', 'default', {
      analytics_storage: 'denied', ad_storage: 'denied',
      ad_user_data: 'denied', ad_personalization: 'denied',
    });
    const readChoice = (raw) => {
      try {
        const saved = JSON.parse(raw || 'null');
        if (saved && ['granted', 'denied'].includes(saved.value)
          && Number.isFinite(saved.savedAt) && Date.now() >= saved.savedAt
          && Date.now() - saved.savedAt < maxAge) return saved.value;
      } catch { /* Invalid preferences need a fresh choice. */ }
      return null;
    };
    try { choice = readChoice(localStorage.getItem(storageKey)); }
    catch { /* Storage may be unavailable; ask again on the next page. */ }
    if (nativeBrowserOptOut) choice = 'denied';
    const effectiveChoice = () => browserOptOut() || policyPending ? 'denied' : choice ?? (regionalMode === 'opt-out' ? 'granted' : 'denied');
    const renderControls = () => {
      const banner = document.querySelector('[data-analytics-consent]');
      if (!banner) return;
      const copy = effectiveChoice() === 'granted' ? 'on' : 'off';
      banner.querySelectorAll('[data-analytics-copy]').forEach((node) => {
        node.hidden = node.getAttribute('data-analytics-copy') !== copy;
      });
      banner.querySelector('[data-analytics-choice="granted"]').disabled = policyPending || browserOptOut();
      banner.querySelector('[data-analytics-optout]').hidden = !browserOptOut();
      banner.hidden = !preferencesOpener && (choice !== null || regionalMode === null);
    };

    const removeAnalyticsCookies = () => {
      for (const entry of document.cookie.split(';')) {
        const name = entry.trim().split('=')[0];
        if (name !== '_ga' && !name.startsWith('_ga_')) continue;
        for (const domain of new Set(['', `; Domain=${location.hostname}`, '; Domain=coffeedant.com', '; Domain=.coffeedant.com'])) {
          document.cookie = `${name}=; Max-Age=0; Path=/${domain}; SameSite=Lax; Secure`;
        }
      }
    };
    const loadTag = () => {
      if (effectiveChoice() !== 'granted' || ['loading', 'ready'].includes(tagState) || attempts >= 2) return;
      attempts++;
      tagState = 'loading';
      const tag = document.createElement('script');
      tag.id = 'coffeedant-google-tag';
      tag.async = true;
      tag.src = `https://www.googletagmanager.com/gtag/js?id=${googleTagId}`;
      tag.onload = () => { tagState = 'ready'; };
      tag.onerror = () => {
        tagState = 'error';
        tag.remove();
        // One bounded retry handles a transient failure, using the same queue.
        // A rejection cancels it; browser tracking protections remain effective.
        if (effectiveChoice() === 'granted' && attempts < 2) retryTimer = setTimeout(loadTag, 1500);
      };
      document.head.appendChild(tag);
    };
    const applyChoice = (value, clearCookies = true) => {
      if (browserOptOut() || policyPending) value = 'denied';
      window[`ga-disable-${measurementId}`] = value !== 'granted';
      window.gtag('consent', 'update', { analytics_storage: value });
      if (value !== 'granted') {
        clearTimeout(retryTimer);
        if (clearCookies) removeAnalyticsCookies();
        return;
      }
      if (!configured) {
        configured = true;
        window.gtag('js', new Date());
        window.gtag('config', measurementId, {
          send_page_view: true,
          allow_google_signals: false,
          allow_ad_personalization_signals: false,
          content_language: document.documentElement?.lang || 'en-US',
          content_region: productionRegions[location.hostname],
        });
      }
      loadTag();
    };
    const cancelRegionLookup = () => {
      lookupVersion++;
      lookupController?.abort();
      lookupController = null;
    };
    const resolveRegionalDefault = async () => {
      cancelRegionLookup();
      const version = lookupVersion;
      regionalMode = null;
      policyPending = true;
      policyResolved = false;
      // Pause collection while checking; preserve existing IDs until the policy is known.
      applyChoice('denied', false);
      renderControls();
      let mode = 'opt-in';
      let headerOptOut = serverBrowserOptOut;
      let timer;
      let controller;
      try {
        controller = new AbortController();
        lookupController = controller;
        timer = setTimeout(() => controller.abort(), 1200);
        const response = await fetch('/api/analytics-consent', {
          cache: 'no-store', credentials: 'omit', signal: controller.signal,
        });
        const data = response.ok ? await response.json() : null;
        if (!controller.signal.aborted) {
          // A positive browser signal always blocks collection. Automatic enablement
          // additionally requires the complete current policy contract.
          if (data?.browserOptOut === true) headerOptOut = true;
          if (data?.policyVersion === '2026-10-15' && typeof data.browserOptOut === 'boolean'
            && ['opt-in', 'opt-out'].includes(data.mode)) {
            headerOptOut = data.browserOptOut;
            mode = data.mode;
          }
        }
      } catch { /* Unknown location, timeout or unavailable endpoint requires opt-in. */ }
      finally { clearTimeout(timer); }
      // A newer lookup wins; the current explicit choice still overrides the regional default.
      if (version !== lookupVersion) return;
      lookupController = null;
      policyPending = false;
      policyResolved = true;
      serverBrowserOptOut = headerOptOut;
      regionalMode = mode;
      applyChoice(effectiveChoice());
      renderControls();
    };
    if (choice === 'denied' || nativeBrowserOptOut) applyChoice('denied');
    else resolveRegionalDefault();
    // Apply withdrawal/acceptance immediately to other open tabs on this host.
    window.addEventListener('storage', (event) => {
      if (event.key !== storageKey && event.key !== null) return;
      preferencesOpener = null;
      choice = nativeBrowserOptOut ? 'denied' : readChoice(event.key === null ? null : event.newValue);
      if (choice === null) {
        applyChoice('denied');
        resolveRegionalDefault();
      } else if (choice === 'granted' && !policyResolved && !policyPending && !browserOptOut()) {
        resolveRegionalDefault();
      } else applyChoice(effectiveChoice());
      renderControls();
    });

    const connectControls = () => {
      const banner = document.querySelector('[data-analytics-consent]');
      if (!banner) return;
      renderControls();
      document.querySelectorAll('[data-analytics-preferences]').forEach((button) => {
        button.hidden = false;
        button.addEventListener('click', () => {
          preferencesOpener = button;
          if (!policyResolved && !policyPending && !browserOptOut()) resolveRegionalDefault();
          renderControls();
          [...banner.querySelectorAll('[data-analytics-choice]')].find((control) => !control.disabled)?.focus({ preventScroll: true });
        });
      });
      banner.querySelectorAll('[data-analytics-choice]').forEach((button) => {
        button.addEventListener('click', () => {
          const value = button.getAttribute('data-analytics-choice');
          if (value === 'granted' && (policyPending || browserOptOut())) return;
          choice = value;
          try { localStorage.setItem(storageKey, JSON.stringify({ value: choice, savedAt: Date.now() })); }
          catch { /* Keep the visitor's choice for this page when storage is blocked. */ }
          applyChoice(choice);
          // Only restore focus when a control opened the banner explicitly.
          preferencesOpener?.focus({ preventScroll: true });
          preferencesOpener = null;
          renderControls();
        });
      });
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', connectControls, { once: true });
    else connectControls();
  })();
</script>
