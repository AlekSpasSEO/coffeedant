---
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div><strong>Coffeedant</strong><br/>Honest espresso machine reviews and buying guides.</div>
    <nav>
      <a href={base + 'about/'}>About</a>
      <a href={base + 'contact/'}>Contact</a>
      <a href={base + 'privacy-policy/'}>Privacy</a>
      <a href={base + 'tos/'}>Terms</a>
      <button type="button" class="cookie-preferences" data-analytics-preferences hidden>Cookie preferences</button>
    </nav>
    <div>&copy; {year} Coffeedant. As an Amazon Associate I earn from qualifying purchases. Coffeedant may also earn from other retailer links.</div>
  </div>
</footer>
<style>
  .cookie-preferences { border: 0; background: none; padding: 0; color: inherit; font: inherit; cursor: pointer; text-decoration: underline; }
  .cookie-preferences[hidden] { display: none; }
</style>
