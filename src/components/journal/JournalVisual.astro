---
const {kind} = Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
const diagrams: Record<string, {title:string; note:string; steps:string[][]}> = {
 coffeehouse:{title:'The coffeehouse as an information network',note:'A comparative schematic. These activities belong to different cities and periods; they are not a portrait of one room.',steps:[['News','Travellers, print and conversation'],['Commerce','Merchants and shipping information'],['Performance','Poetry, games and discussion'],['Knowledge','Reading and scientific exchange']]},
 colonial:{title:'Follow the plant. Then follow the labour.',note:'Selected historical contexts, not a complete migration map. Plant movement and labour systems are separate histories.',steps:[['Ethiopia & South Sudan','Arabica’s native range'],['Yemen','Cultivation and export knowledge'],['Java','Colonial forced cultivation'],['Saint-Domingue','Plantations and enslaved labour']]},
 civet:{title:'Two chains of evidence',note:'Authenticating a bean cannot establish animal welfare. Both claims need their own evidence.',steps:[['Coffee cherry','Traceable origin and lot'],['Civet processing','Animal-management evidence'],['Collection & drying','Records of handling'],['Roasted coffee','Identity ≠ proof of welfare']]},
 robusta:{title:'Resilience is a system, not a species name',note:'Conceptual layers; no climate projections or measured yields are encoded in this drawing.',steps:[['Heat','Temperature and exposure'],['Water','Rainfall, soil water, irrigation'],['Farm','Shade, soils and management'],['Plant','Genetics and local adaptation']]},
 decaf:{title:'Four paths to less caffeine',note:'These are process families, not a ranking of flavour. All converge on drying green coffee before roasting.',steps:[['Water process','Extract + carbon filtration'],['CO₂','Compressed extracting medium'],['Ethyl acetate','Solvent extraction'],['Methylene chloride','Solvent extraction']]},
 fermentation:{title:'Read fermentation on four independent axes',note:'A process can combine several choices. “Anaerobic” alone does not specify ingredients or microbes.',steps:[['Oxygen','Open / oxygen-limited'],['Microbes','Resident / inoculated'],['Ingredients','Coffee alone / additions'],['Timing','Stage, duration and control']]},
 freshness:{title:'One coffee. Three clocks.',note:'Conceptual sequence, not an experimentally fitted freshness curve. No universal expiry is implied.',steps:[['Roast & sealed rest','Gas-release clock begins'],['Open the package','Exposure and closure matter'],['Grind the dose','More exposed surface'],['Brew & taste','Judge the finished cup']]},
};
const d = diagrams[kind];
---
<div class="journal-visual" data-visual={kind}>
 {kind === 'routes' ? <>
  <div class="visual-head"><span class="journal-label">Trade atlas / reconstructed network</span><h3>Before the world had a coffee route.</h3></div>
  <div class="visual-switch" aria-label="Choose historical period"><button type="button" data-route-era="sixteenth" aria-pressed="true">16th century</button><button type="button" data-route-era="seventeenth" aria-pressed="false">17th century</button></div>
  <svg viewBox="0 0 800 380" role="img" aria-label="Schematic network: Ethiopian origins, Yemeni highlands, Red Sea ports, Jeddah, Cairo and eastern Mediterranean cities. Mocha's importance grows in the seventeenth century.">
   <defs><marker id="route-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="#f3da00"/></marker></defs>
   <path d="M120 285 Q225 325 300 255 M300 255 Q355 250 410 210 M410 210 Q515 190 510 110 M510 110 Q590 110 600 60 M600 60 Q670 15 715 70" fill="none" stroke="#f3da00" stroke-width="3" marker-end="url(#route-arrow)"/>
   <path d="M600 60 Q660 120 715 185" fill="none" stroke="#a4b3a5" stroke-width="2" stroke-dasharray="6 8"/>
   {[{x:120,y:285,t:'Ethiopian source region',s:'Wild origins'},{x:300,y:255,t:'Yemeni highlands',s:'Cultivation expands'},{x:410,y:210,t:'Yemeni ports',s:'Red Sea distribution'},{x:510,y:110,t:'Jeddah',s:'Regional entrepôt'},{x:600,y:60,t:'Cairo',s:'Egyptian distribution'},{x:715,y:70,t:'Istanbul',s:'Urban coffee culture'},{x:715,y:185,t:'Aleppo / Damascus',s:'Cultural connections'}].map(n=><g><circle cx={n.x} cy={n.y} r="7" fill="#f3da00"/><text x={n.x} y={n.y+25} text-anchor="middle" fill="#fffefa" font-size="15">{n.t}</text><text x={n.x} y={n.y+44} text-anchor="middle" fill="#b7bcaf" font-size="11">{n.s}</text></g>)}
   <text x="45" y="50" fill="#8a9b91" font-size="12" letter-spacing="3">RED SEA → EASTERN MEDITERRANEAN</text>
  </svg>
  <p class="route-note" aria-live="polite">Sixteenth-century network: wild Ethiopian trade and expanding Yemeni cultivation. This schematic does not document one 1554 shipment.</p>
  <p class="visual-note">Schematic, not to geographic scale. Solid line: regional trade connections; dashed line: cultural links. Mocha’s principal entrepôt role belongs to the early seventeenth century.</p>
 </> : kind === 'americano' ? <>
  <div class="visual-head"><span class="journal-label">Recipe studio / interactive</span><h3>Build the cup. Keep the shot.</h3><p>A suggested recipe for a conventional double basket.</p></div>
  <div class="recipe-studio">
   <div class="cup-drawing" aria-hidden="true"><svg viewBox="0 0 240 250"><path d="M180 80 C235 65 237 153 184 158" fill="none" stroke="#fffefa" stroke-width="6"/><path d="M45 65 H185 L171 205 Q113 230 59 205 Z" fill="#f2da0030" stroke="#fffefa" stroke-width="3"/><path class="water-fill" d="M51 95 H180 L171 205 Q113 230 59 205 Z" fill="#b87836"/><ellipse cx="115" cy="95" rx="64" ry="11" fill="#e7b979"/><path d="M90 45 Q75 25 90 8 M125 45 Q145 25 125 8" stroke="#8c9e92" stroke-width="3" fill="none"/></svg></div>
   <div class="recipe-controls"><label>Dose <output data-dose-output>18</output> g<input type="range" min="14" max="22" value="18" step="1" data-dose /></label><label>Espresso : added water <output data-ratio-output>1 : 3</output><input type="range" min="2" max="4" value="3" step="0.5" data-dilution /></label><div class="recipe-result" aria-live="polite"><strong data-recipe>18 g coffee → 36 g espresso + 108 g water</strong><span data-total>144 g finished drink · espresso ratio 1:2</span></div><p>Match the dose to your basket. These weights do not predict extraction yield or caffeine.</p></div>
  </div>
  <div class="brew-sequence"><button type="button" data-brew-play aria-pressed="false">▶ Play the visual brew sequence</button><p data-brew-status aria-live="polite">Grind → prepare → extract → dilute</p><ol><li data-brew-step="0">01 / Grind</li><li data-brew-step="1">02 / Prepare</li><li data-brew-step="2">03 / Extract</li><li data-brew-step="3">04 / Dilute</li></ol></div>
  <p class="visual-note">Original animated schematic by Coffeedant, not footage of a measured extraction. Pause or step through at your own pace.</p>
  <video class="journal-video" controls preload="none" playsinline width="960" height="544" poster={`${base}journal/americano-poster.webp`} aria-label="Silent original Americano brewing explainer">
   <source src={`${base}journal/americano-sequence.mp4`} type="video/mp4" />
   Your browser does not support this video. The complete sequence is explained in the text below.
  </video>
  <p class="visual-note"><strong>Video transcript:</strong> Grind 18 g coffee; prepare an even bed; extract 36 g espresso; add 108 g water for a 144 g drink. Example protocol for a conventional double basket. Silent original motion schematic; no measured extraction claim.</p>
 </> : kind === 'water' ? <>
  <div class="visual-head"><span class="journal-label">Water lab / conceptual model</span><h3>Two measurements. Different jobs.</h3></div>
  <div class="water-lab"><label>Explore alkalinity<select data-water-buffer><option value="low">Lower buffering</option><option value="high">Higher buffering</option></select></label><label>Explore hardness<select data-water-hardness><option value="low">Lower calcium / magnesium</option><option value="high">Higher calcium / magnesium</option></select></label><div class="water-result" aria-live="polite"><span data-water-result>Less acid buffering; lower calcium / magnesium context. Check the complete water analysis against your machine’s requirements.</span></div></div>
  <svg viewBox="0 0 720 150" role="img" aria-label="Hardness and alkalinity are independent measurements, and both feed into a full water assessment."><rect x="10" y="20" width="230" height="85" rx="3" fill="#29483c"/><text x="125" y="58" text-anchor="middle" fill="#fffefa" font-size="20">HARDNESS</text><text x="125" y="83" text-anchor="middle" fill="#bfcfc5" font-size="14">Calcium + magnesium</text><path d="M240 60 H480" stroke="#f3da00" stroke-width="3"/><rect x="480" y="20" width="230" height="85" rx="3" fill="#29483c"/><text x="595" y="58" text-anchor="middle" fill="#fffefa" font-size="20">ALKALINITY</text><text x="595" y="83" text-anchor="middle" fill="#bfcfc5" font-size="14">Acid-buffering capacity</text><text x="360" y="140" text-anchor="middle" fill="#fffefa" font-size="14">Taste assessment + manufacturer compatibility</text></svg>
  <p class="visual-note">Qualitative explanation only. This is not a calibrated taste predictor, mineral recipe or equipment-safe zone.</p>
 </> : d ? <>
  <div class="visual-head"><span class="journal-label">Field notes / original schematic</span><h3>{d.title}</h3></div>
  <div class="diagram-grid">{d.steps.map(([title,note],i)=><div class="diagram-cell"><span>0{i+1}</span><svg viewBox="0 0 100 70" aria-hidden="true"><circle cx="50" cy="35" r={17+i*3} fill="none" stroke="#f3da00" stroke-width="2"/><path d={`M10 35 H${33-i*3} M${67+i*3} 35 H90 M50 10 V${18-i*3} M50 ${52+i*3} V65`} stroke="#869c8f" stroke-width="2"/><circle cx="50" cy="35" r="5" fill="#f3da00"/></svg><h4>{title}</h4><p>{note}</p></div>)}</div>
  <p class="visual-note">{d.note}</p>
 </> : null}
</div>
