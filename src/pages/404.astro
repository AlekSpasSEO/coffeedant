---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="Page not found" canonical="https://alekspasseo.github.io/coffeedant/404/">
  <div class="container article">
    <h1>Page not found</h1>
    <p>We couldn't find that page. Browse the <a href={base + 'espresso-machine/'}>espresso machine reviews</a> or head back <a href={base}>home</a>.</p>
  </div>
</Base>
