---
import HomeLayout from '../../layouts/HomeLayout.astro';
import data from '../../data/amazon-deals.json';
import { isCurrentDeal } from '../../../scripts/lib/amazon-deals.mjs';
const base = import.meta.env.BASE_URL;
const products = data.products.filter(product => isCurrentDeal(product));
const date = (value: string | null) => value ? new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'America/New_York' }).format(new Date(value)) + ' ET' : 'Awaiting refresh';
const schema = { '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': 'https://coffeedant.com/deals/#collection', url: 'https://coffeedant.com/deals/', name: 'Coffee deals on Amazon', description: 'Coffee, espresso machines, grinders, brewers and accessories with Amazon-reported discounts. New selections every Friday.', dateModified: data.refreshedAt, mainEntity: { '@type': 'ItemList', numberOfItems: products.length, itemListElement: products.map((product, index) => ({ '@type': 'ListItem', position: index + 1, name: product.title, url: product.detailPageUrl })) } };
---
<HomeLayout title="Coffee Deals on Amazon: Machines, Beans & More | Coffeedant" description="Browse Amazon coffee deals on beans, pods, espresso machines, grinders, brewers and accessories. New picks every Friday, with prices and availability refreshed regularly." canonicalPath="/deals/">
  <script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<', '\\u003c')} />
  <main id="main-content" class="deals-page" data-deals-page>
    <section class="deals-hero">
      <div class="shell deals-hero-grid">
        <div>
          <p class="deals-kicker">AMAZON US / THE FRIDAY ROUNDUP</p>
          <h1>Coffee deals.<br /><span>Better mornings.</span></h1>
          <p class="deals-intro">A better price on your next bag, brewer, or espresso setup. Explore coffee deals on Amazon, gathered in one place.</p>
          <a class="deals-jump" href="#browse-deals">Browse the deals <span aria-hidden="true">↓</span></a>
        </div>
        <aside class="deals-note" aria-label="Update schedule">
          <span class="note-icon" aria-hidden="true">%</span>
          <p class="deals-kicker">A FRESH ROUND EVERY</p>
          <strong>Friday.</strong>
          <p>New finds once a week.<br />Current prices checked throughout the week.</p>
          <small>Amazon.com · USD · new products</small>
        </aside>
      </div>
    </section>
    <div class="deals-meta shell">
      <p><span class="status-dot" aria-hidden="true"></span><strong data-total>{products.length}</strong> <span data-total-label>verified deals</span></p>
      <p>Roundup: <time datetime={data.selectedAt ?? undefined}>{data.selectedAt ? new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeZone: 'Europe/Skopje' }).format(new Date(data.selectedAt)) : 'Awaiting refresh'}</time></p>
      <p>Prices checked: <time datetime={data.refreshedAt ?? undefined}>{date(data.refreshedAt)}</time></p>
    </div>

    <section class="shell deals-browser" id="browse-deals" aria-labelledby="deals-heading">
      <div class="deals-section-heading"><div><p class="deals-kicker">01 / FIND YOUR NEXT UPGRADE</p><h2 id="deals-heading">What’s brewing this week.</h2></div><a href="#how-deals-work">How we find deals ↗</a></div>
      <div class="deal-categories" role="group" aria-label="Filter deals by category">
        <button type="button" data-category="all" aria-pressed="true">All deals</button>
        {data.categories.map(category => <button type="button" data-category={category.id} aria-pressed="false">{category.label}</button>)}
      </div>
      <div class="deal-controls">
        <label class="deal-search"><span>Search deals</span><input type="search" placeholder="Try beans, Breville, or a scale…" data-deal-search /></label>
        <label class="deal-sort"><span>Sort by</span><select data-deal-sort><option value="savings">Biggest savings</option><option value="price-low">Price: low to high</option><option value="price-high">Price: high to low</option><option value="ending">Ending soon</option></select></label>
      </div>
      <p class="deals-results" data-result-count aria-live="polite">Showing {products.length} deals</p>
      <div class="deals-grid" data-deals-grid>
        {products.map(product => <article class="deal-card" data-deal-card data-category={product.category} data-search={`${product.title} ${product.brand ?? ''}`.toLowerCase()} data-price={product.amount} data-savings={product.savingsPercent ?? 0} data-checked={product.checkedAt} data-ends={product.endsAt ?? ''}>
          <a class="deal-image-link" href={product.detailPageUrl} target="_blank" rel="sponsored nofollow noopener" aria-label={`View ${product.title} on Amazon`}>
            {product.imageUrl ? <img src={product.imageUrl} alt={product.title} width={product.imageWidth ?? 160} height={product.imageHeight ?? 160} loading="lazy" /> : <span class="deal-no-image">See product on Amazon ↗</span>}
            <span class="deal-badge">{product.savingsPercent ? `${product.savingsPercent}% off` : product.dealBadge}</span>
          </a>
          <div class="deal-content">
            <p class="deal-category">{data.categories.find(category => category.id === product.category)?.label}</p>
            <h3><a href={product.detailPageUrl} target="_blank" rel="sponsored nofollow noopener">{product.title}</a></h3>
            <div class="deal-price"><strong>{product.price}</strong>{product.referencePrice && <span><span>{product.referenceLabel}</span> <s>{product.referencePrice}</s></span>}</div>
            <p class="deal-saving">{product.savingsAmount ? `Save ${product.savingsAmount}` : product.dealBadge}</p>
            <div class="deal-conditions">
              {product.accessType.replaceAll('_', '') === 'PRIMEEXCLUSIVE' && <span class="prime-label">Prime members only</span>}
              {product.accessType.replaceAll('_', '') === 'PRIMEEARLYACCESS' && <span class="prime-label">Prime early access</span>}
              {product.endsAt ? <span>Ends {date(product.endsAt)}</span> : <span>No end date supplied by Amazon</span>}
            </div>
            <a class="deal-cta" href={product.detailPageUrl} target="_blank" rel="sponsored nofollow noopener">View deal on Amazon <span aria-hidden="true">↗</span></a>
          </div>
        </article>)}
      </div>
      <div class="deal-empty" data-deal-empty hidden={products.length > 0}><h3>No deals to show right now.</h3><p>Try another category or search. Offers that have ended, sold out, or could not be checked recently are removed.</p><button type="button" data-deal-reset>Reset filters</button></div>
      <noscript><p>All currently published deals appear above. Enable JavaScript to filter them and automatically hide offers when they expire.</p></noscript>
      <p class="deal-price-disclaimer">Product prices and availability are accurate as of the date/time indicated and are subject to change. Any price and availability information displayed on Amazon.com at the time of purchase will apply to the purchase of this product.</p>
    </section>

    <section class="deals-method" id="how-deals-work" aria-labelledby="deals-method-title">
      <div class="shell"><p class="deals-kicker">02 / A LITTLE CONTEXT</p><h2 id="deals-method-title">A discount is a starting point.</h2>
        <div class="deals-method-grid">
          <div><span>01</span><h3>New finds every Friday.</h3><p>We search Amazon.com for coffee, pods, machines, grinders, manual brewers, kettles, frothers, and coffee tools. This page includes the deals found by those searches; Amazon’s full catalog is larger.</p></div>
          <div><span>02</span><h3>Amazon’s numbers.</h3><p>Product details, images, prices, comparison prices, discounts, and deal terms come from Amazon’s API. Savings use Amazon’s labelled reference price. A discount does not establish a historical low.</p></div>
          <div><span>03</span><h3>Check the fit, then the price.</h3><p>Offers can end early. Check delivery, seller, tax, and any Prime requirements on Amazon before buying. Use our <a href={`${base}espresso-machine/`}>machine reviews</a>, <a href={`${base}grinder/`}>grinder guides</a>, and <a href={`${base}coffee-beans/`}>coffee reviews</a> to compare your options.</p></div>
        </div>
        <p class="deals-disclosure"><strong>Affiliate disclosure:</strong> As an Amazon Associate I earn from qualifying purchases. Deal links open Amazon in a new tab.</p>
      </div>
    </section>
  </main>
</HomeLayout>

<script>
  const page = document.querySelector<HTMLElement>('[data-deals-page]');
  if (page) {
    const grid = page.querySelector<HTMLElement>('[data-deals-grid]')!;
    const cards = [...page.querySelectorAll<HTMLElement>('[data-deal-card]')];
    const search = page.querySelector<HTMLInputElement>('[data-deal-search]')!;
    const sort = page.querySelector<HTMLSelectElement>('[data-deal-sort]')!;
    const filters = [...page.querySelectorAll<HTMLButtonElement>('button[data-category]')];
    let category = 'all';
    const current = (card: HTMLElement) => { const checked = Date.parse(card.dataset.checked ?? ''); return Number.isFinite(checked) && checked <= Date.now() && Date.now() - checked < 86400000 && (!card.dataset.ends || Date.parse(card.dataset.ends) > Date.now()); };
    const update = () => {
      const query = search.value.trim().toLowerCase();
      const live = cards.filter(current);
      const ordered = [...cards].sort((a, b) => sort.value === 'price-low' ? Number(a.dataset.price) - Number(b.dataset.price) : sort.value === 'price-high' ? Number(b.dataset.price) - Number(a.dataset.price) : sort.value === 'ending' ? (a.dataset.ends ? Date.parse(a.dataset.ends) : Infinity) - (b.dataset.ends ? Date.parse(b.dataset.ends) : Infinity) : Number(b.dataset.savings) - Number(a.dataset.savings));
      let count = 0;
      for (const card of ordered) {
        card.hidden = !current(card) || (category !== 'all' && card.dataset.category !== category) || !card.dataset.search?.includes(query);
        if (!card.hidden) count++;
        grid.append(card);
      }
      page.querySelector('[data-result-count]')!.textContent = `Showing ${count} ${count === 1 ? 'deal' : 'deals'}`;
      page.querySelector('[data-total]')!.textContent = String(live.length);
      page.querySelector('[data-total-label]')!.textContent = live.length ? 'verified deals' : 'recently verified deals — awaiting refresh';
      page.querySelector<HTMLElement>('[data-deal-empty]')!.hidden = count > 0;
    };
    filters.forEach(button => button.addEventListener('click', () => { category = button.dataset.category!; filters.forEach(filter => filter.setAttribute('aria-pressed', String(filter === button))); update(); }));
    search.addEventListener('input', update);
    sort.addEventListener('change', update);
    page.querySelector('[data-deal-reset]')?.addEventListener('click', () => { category = 'all'; search.value = ''; filters.forEach(filter => filter.setAttribute('aria-pressed', String(filter.dataset.category === 'all'))); update(); search.focus(); });
    update();
    window.setInterval(update, 60000);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) update(); });
  }
</script>

<style>
  .deals-page { color: var(--ink); }
  .deals-hero { border-bottom: 2px solid var(--ink); padding: 66px 0 58px; background: var(--yellow); }
  .deals-hero-grid { display: grid; grid-template-columns: 1.6fr 1fr; align-items: center; gap: 60px; }
  .deals-kicker { margin: 0 0 18px; font-size: .74rem; letter-spacing: .09em; font-weight: 900; }
  h1 { margin: 0; font-size: clamp(3rem, 5.7vw, 5.25rem); line-height: 1.03; letter-spacing: -.06em; }
  h1 span { color: #474100; }
  .deals-intro { max-width: 580px; margin: 24px 0; font-size: 1.13rem; line-height: 1.6; }
  .deals-jump { display: inline-flex; gap: 34px; padding: 14px 20px; background: var(--ink); color: white; text-decoration: none; font-weight: 800; }
  .deals-note { position: relative; padding: 28px 32px; border: 2px solid var(--ink); background: var(--paper); box-shadow: 7px 7px 0 var(--ink); transform: rotate(2deg); }
  .deals-note .deals-kicker { margin-top: 38px; margin-bottom: 4px; }
  .deals-note strong { display: block; font-size: clamp(3rem, 4.3vw, 4.5rem); letter-spacing: -.06em; line-height: 1.05; }
  .deals-note p { margin-bottom: 12px; }
  .deals-note small { font-size: .75rem; color: var(--muted); }
  .note-icon { position: absolute; right: 23px; top: 15px; font-size: 2.4rem; font-weight: 900; }
  .deals-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 22px; padding-block: 19px; border-bottom: 1px solid var(--line); font-size: .76rem; color: var(--muted); }
  .deals-meta p { margin: 0; }
  .deals-meta strong { color: var(--ink); }
  .status-dot { display: inline-block; width: 8px; height: 8px; margin-right: 8px; border-radius: 50%; background: var(--green); }
  .deals-browser { padding-block: 55px 60px; scroll-margin-top: 96px; }
  .deals-section-heading { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 26px; }
  .deals-section-heading h2, .deals-method h2 { margin: 0; font-size: clamp(1.8rem, 3vw, 2.7rem); letter-spacing: -.04em; line-height: 1.15; }
  .deals-section-heading .deals-kicker { margin-bottom: 10px; }
  .deals-section-heading > a { flex-shrink: 0; font-size: .8rem; font-weight: 700; }
  .deal-categories { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
  .deal-categories button { padding: 9px 13px; border: 1px solid var(--ink); background: transparent; font-size: .8rem; font-weight: 700; cursor: pointer; }
  .deal-categories button[aria-pressed="true"] { background: var(--ink); color: white; }
  .deal-categories button:hover { box-shadow: 2px 2px 0 var(--ink); }
  .deal-controls { display: grid; grid-template-columns: 1fr 240px; gap: 16px; padding: 20px; border: 1px solid var(--line); background: #f3f0e8; }
  .deal-controls label { display: grid; gap: 6px; min-width: 0; }
  .deal-controls label > span { font-size: .7rem; text-transform: uppercase; font-weight: 800; letter-spacing: .05em; }
  .deal-controls input, .deal-controls select { width: 100%; min-height: 45px; border: 1px solid #858279; padding: 10px 12px; background: white; color: var(--ink); font: inherit; font-size: .9rem; border-radius: 0; }
  button:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible { outline: 3px solid #196b4a; outline-offset: 3px; }
  .deals-results { margin: 22px 0 16px; color: var(--muted); font-size: .8rem; }
  .deals-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .deal-card { display: flex; flex-direction: column; min-width: 0; border: 1px solid var(--ink); background: white; }
  .deal-card[hidden], .deal-empty[hidden] { display: none; }
  .deal-image-link { display: flex; position: relative; align-items: center; justify-content: center; height: 210px; padding: 45px 24px 20px; text-decoration: none; background: white; border-bottom: 1px solid var(--line); }
  .deal-image-link img { width: 100%; height: 100%; object-fit: contain; }
  .deal-badge { position: absolute; left: 12px; top: 12px; padding: 5px 9px; background: var(--yellow); color: var(--ink); font-weight: 900; font-size: .8rem; max-width: calc(100% - 24px); }
  .deal-no-image { color: var(--muted); font-size: .8rem; }
  .deal-content { display: flex; flex-direction: column; padding: 18px; flex: 1; }
  .deal-category { font-size: .65rem; text-transform: uppercase; font-weight: 900; color: var(--muted); letter-spacing: .06em; margin: 0 0 10px; }
  .deal-card h3 { font-size: .96rem; line-height: 1.4; margin: 0 0 16px; }
  .deal-card h3 a { text-decoration: none; overflow-wrap: anywhere; }
  .deal-card h3 a:hover { text-decoration: underline; }
  .deal-price { display: flex; flex-direction: column; gap: 2px; margin-top: auto; }
  .deal-price strong { font-size: 1.6rem; font-weight: 900; letter-spacing: -.03em; }
  .deal-price > span { font-size: .7rem; color: var(--muted); }
  .deal-saving { margin: 5px 0 12px; color: var(--green); font-weight: 800; font-size: .8rem; }
  .deal-conditions { display: grid; align-content: start; gap: 4px; min-height: 47px; margin-bottom: 16px; font-size: .65rem; color: var(--muted); }
  .prime-label { font-weight: 800; color: #154d77; }
  .deal-cta { display: flex; gap: 8px; justify-content: space-between; align-items: center; border: 1px solid var(--ink); background: var(--yellow); padding: 10px; text-decoration: none; font-weight: 900; font-size: .73rem; }
  .deal-cta:hover { box-shadow: 3px 3px 0 var(--ink); }
  .deal-empty { padding: 50px 24px; text-align: center; border: 1px dashed var(--line); }
  .deal-empty h3 { margin: 0 0 10px; }
  .deal-empty p { max-width: 620px; margin: 0 auto 20px; }
  .deal-empty button { border: 1px solid var(--ink); padding: 10px 15px; background: var(--yellow); cursor: pointer; }
  .deal-price-disclaimer { margin-top: 26px; color: var(--muted); font-size: .7rem; line-height: 1.6; }
  .deals-method { padding: 56px 0; background: #f3f0e8; border-top: 2px solid var(--ink); }
  .deals-method-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin-top: 35px; }
  .deals-method-grid > div > span { font-size: .8rem; font-weight: 900; padding: 6px 10px; background: var(--yellow); }
  .deals-method-grid h3 { font-size: 1.15rem; margin: 18px 0 12px; letter-spacing: -.02em; }
  .deals-method-grid p { font-size: .9rem; line-height: 1.7; margin: 0; }
  .deals-disclosure { margin: 32px 0 0; font-size: .75rem; border-top: 1px solid var(--line); padding-top: 20px; color: var(--muted); }
  @media (max-width: 1020px) { .deals-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .deals-hero-grid { gap: 35px; } }
  @media (max-width: 760px) { .deals-hero { padding: 40px 0; } .deals-hero-grid { grid-template-columns: 1fr; gap: 30px; } .deals-note { transform: none; padding: 20px 24px; } .deals-note .deals-kicker { margin-top: 0; } .deals-note strong { font-size: 2.8rem; } .deals-note p { margin: 8px 0; } .deals-section-heading { display: block; } .deals-section-heading > a { display: inline-block; margin-top: 15px; } .deals-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; } .deal-controls { grid-template-columns: 1fr; padding: 14px; } .deals-method-grid { grid-template-columns: 1fr; gap: 28px; } .deals-meta { display: grid; gap: 7px; } }
  @media (max-width: 480px) { .deals-grid { grid-template-columns: 1fr; } .deal-card { display: grid; grid-template-columns: 108px minmax(0, 1fr); } .deal-image-link { height: 100%; min-height: 190px; padding: 48px 12px 18px; border-bottom: 0; border-right: 1px solid var(--line); } .deal-badge { left: 6px; top: 8px; font-size: .65rem; padding: 5px; max-width: calc(100% - 12px); } .deal-content { padding: 14px; } .deal-card h3 { font-size: .85rem; margin-bottom: 10px; } .deal-price strong { font-size: 1.4rem; } .deal-conditions { min-height: 0; margin-bottom: 12px; } .deal-cta { font-size: .68rem; } .deal-categories button { font-size: .72rem; padding: 9px 10px; } .deals-browser { padding-top: 36px; } }
</style>
