---
import HomeLayout from '../../../layouts/HomeLayout.astro';
import MachineReview from '../../../components/reviews/MachineReview.astro';
import { bambinoReview } from '../../../data/reviews';
import '../../../styles/review.css';
---

<HomeLayout
  title="Breville Bambino Plus Review: Easier Milk Drinks, With a Grinder Still to Buy | Coffeedant"
  description={bambinoReview.description}
  canonicalPath={bambinoReview.slug}
  image={bambinoReview.image}
  imageAlt={bambinoReview.imageAlt}
  ogType="article"
  published={bambinoReview.published}
  updated={bambinoReview.updated}
>
  <MachineReview review={bambinoReview} />
</HomeLayout>
