---
import HomeLayout from '../../layouts/HomeLayout.astro';
import guide from '../../data/espresso-drip-guide.json';
import '../../styles/review.css';
import '../../styles/beans.css';
import '../../styles/bean-guides.css';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const local = (path: string) => `${base}${path.replace(/^\//, '')}`;
const canonical = `https://coffeedant.com${guide.canonicalPath}`;
const cite = (paragraph: string) => paragraph.replace(/\[(\d+)\]/g, (_match, number) => `<a class="bean-cite" href="#s${number}" aria-label="Source ${number}">[${number}]</a>`);
const author = { '@type': 'Person', name: 'Aleksandar Spasevski', jobTitle: 'Editor, Coffeedant', url: 'https://coffeedant.com/about/', image: 'https://coffeedant.com/images/author-aleksandar-spasevski.jpg' };
const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'Article', '@id': `${canonical}#article`, headline: guide.title, description: guide.description, genre: 'Research-led coffee buying guide', inLanguage: 'en-US', datePublished: guide.published, dateModified: guide.updated, author, mainEntityOfPage: canonical, image: guide.picks.map((pick) => pick.image), citation: guide.sources.map((source) => source.href), publisher: { '@type': 'Organization', name: 'Coffeedant', url: 'https://coffeedant.com/' } },
  { '@type': 'ItemList', '@id': `${canonical}#shortlist`, name: 'Coffee beans for espresso and drip shortlist', itemListOrder: 'https://schema.org/ItemListUnordered', itemListElement: guide.picks.map((pick, index) => ({ '@type': 'ListItem', position: index + 1, name: pick.name, url: `https://coffeedant.com${pick.slug}` })) },
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://coffeedant.com/' }, { '@type': 'ListItem', position: 2, name: 'Coffee beans', item: 'https://coffeedant.com/coffee-beans/' }, { '@type': 'ListItem', position: 3, name: guide.title, item: canonical }] },
  { '@type': 'FAQPage', mainEntity: guide.faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) },
  ...guide.picks.map((pick) => ({ '@type': 'ImageObject', contentUrl: pick.image, caption: `${pick.name}: official product photograph`, creditText: pick.roaster, creator: { '@type': 'Organization', name: pick.roaster }, url: pick.source })),
] };
---
<HomeLayout title={`${guide.title} | Coffeedant`} description={guide.description} canonicalPath={guide.canonicalPath} image={guide.picks[0].image} imageAlt="Stumptown Hair Bender official coffee bag" ogType="article" published={guide.published} updated={guide.updated}>
  <main id="main-content" class="review-page bean-buying-guide" data-guide-kind="coffee-beans">
    <div class="review-shell">
      <nav class="review-breadcrumbs" aria-label="Breadcrumb"><a href={base}>Home</a><span>/</span><a href={local('/coffee-beans/')}>Coffee beans</a><span>/</span><span>Espresso and drip</span></nav>
      <header class="bean-guide-header">
        <p class="review-overline">Coffee buying guide · research-led · United States</p>
        <h1>{guide.title}</h1><p class="bean-lead">{guide.deck}</p>
        <aside class="review-author-card"><div class="review-author-head"><img src={local('/images/author-aleksandar-spasevski.jpg')} alt="Aleksandar Spasevski, editor at Coffeedant" width="46" height="46" /><div><strong>Aleksandar Spasevski</strong><small>Editor, Coffeedant</small></div></div><p>Published and checked <time datetime={guide.published}>October 14, 2026</time> · US direct-purchase context</p><p>I compared exact current roaster listings, brewing methods, pack sizes, freshness advice and the corresponding full reviews. I have not bought, brewed or tasted these coffees. Best-for labels are research-led buying judgments, not sensory scores.</p></aside>
      </header>
      <nav class="bean-jump" aria-label="Guide sections"><strong>Choose by your routine</strong>{guide.sections.map((section) => <a href={`#${section.id}`}>{section.title}</a>)}<a href="#quick-compare">Quick comparison</a><a href="#picks">The picks</a><a href="#detailed-compare">Detailed comparison</a><a href="#faq">FAQ</a><a href="#sources">Sources</a></nav>
      <article class="bean-article">
        {guide.sections.slice(0,2).map((section) => <section class="review-section" id={section.id}><header class="review-section-heading"><p class="review-overline">Before the shortlist</p><h2>{section.title}</h2></header><div class="review-section-body">{section.paragraphs.map((paragraph) => <p set:html={cite(paragraph)} />)}</div></section>)}
        <section class="review-section" id="quick-compare"><header class="review-section-heading"><p class="review-overline">Four distinct buying reasons</p><h2>Quick comparison</h2></header><div class="bean-guide-table" tabindex="0" role="region" aria-label="Scrollable quick coffee comparison"><table><caption>Exact whole-bean products; US direct listing observations on October 14, 2026</caption><thead><tr><th scope="col">Coffee</th><th scope="col">Best for</th><th scope="col">Dated 12 oz price</th><th scope="col">Skip if</th></tr></thead><tbody>{guide.picks.map((pick) => <tr><th scope="row"><a href={local(pick.slug)}>{pick.name}</a></th><td>{pick.bestFor}</td><td>{pick.price}</td><td>{pick.avoidIf}</td></tr>)}</tbody></table></div></section>
        <section class="review-section" id="picks"><header class="review-section-heading"><p class="review-overline">Full review for every pick</p><h2>Match the coffee to the dominant drink</h2></header><div class="bean-index-grid">{guide.picks.map((pick) => <article class="bean-guide-pick"><img src={pick.image} alt={`${pick.name} official coffee bag`} width="360" height="360" loading="lazy" decoding="async" /><div><p class="review-overline">{pick.bestFor}</p><h3><a href={local(pick.slug)}>{pick.name}</a></h3><p>{pick.flavor}.</p><p><strong>Dual-method evidence:</strong> {pick.method}.</p><p><strong>Tradeoff:</strong> {pick.tradeoff}.</p><p><strong>Think twice:</strong> {pick.avoidIf}.</p><p class="bean-credit"><a href={pick.source} target="_blank" rel="noopener">Image: {pick.roaster}</a>. Official product identification photograph.</p><a class="bean-guide-review-link" href={local(pick.slug)}>Read the full review →</a></div></article>)}</div></section>
        <section class="review-section" id="detailed-compare"><header class="review-section-heading"><p class="review-overline">Two methods, one bag</p><h2>Detailed buying comparison</h2></header><div class="bean-guide-table" tabindex="0" role="region" aria-label="Scrollable detailed coffee comparison"><table><caption>Dated direct buying facts and illustrative dose arithmetic; no tasted ranking</caption><thead><tr><th scope="col">Factor</th>{guide.picks.map((pick) => <th scope="col"><a href={local(pick.slug)}>{pick.name}</a></th>)}</tr></thead><tbody>{[['Format','format'],['Record to check','record'],['Brew evidence','method'],['Illustrative bean cost','cost'],['Main tradeoff','tradeoff']].map(([label,key]) => <tr><th scope="row">{label}</th>{guide.picks.map((pick) => <td>{pick[key as keyof typeof pick]}</td>)}</tr>)}</tbody></table></div></section>
        {guide.sections.slice(2).map((section) => <section class="review-section" id={section.id}><header class="review-section-heading"><p class="review-overline">Make the choice repeatable</p><h2>{section.title}</h2></header><div class="review-section-body">{section.paragraphs.map((paragraph) => <p set:html={cite(paragraph)} />)}</div></section>)}
        <section class="review-section" id="related"><header class="review-section-heading"><p class="review-overline">Related decisions</p><h2>Explore the neighboring buying jobs</h2></header><div class="bean-alternatives"><a href={local('/coffee-beans/best-dark-roast-coffee-beans/')}><strong>Best dark roast coffee beans</strong><span>Choose a developed roast by milk, drip or retail buying reason.</span></a><a href={local('/coffee-beans/onyx-monarch/')}><strong>Onyx Monarch review</strong><span>Consider a deliberately milk-focused espresso blend.</span></a><a href={local('/coffee-beans/intelligentsia-black-cat-classic-espresso/')}><strong>Black Cat Classic review</strong><span>Investigate a more espresso-focused fruit-accented option.</span></a><a href={local('/grinder/baratza-encore-esp/')}><strong>Baratza Encore ESP review</strong><span>Understand switching and grind-step tradeoffs.</span></a></div></section>
        <section class="review-section" id="methodology"><header class="review-section-heading"><p class="review-overline">Evidence and limits</p><h2>How these picks were selected</h2></header><div class="review-section-body"><p>This is a research-led US shortlist. Exact product, brew-use, roast, pack and direct-price claims come from named roasters' current records. Best-for and skip guidance are Coffeedant editorial judgments about the mixed espresso-and-drip workflow. Coffeedant has not conducted a tasting, measured extraction or verified that a specific bag will match the stated flavor notes. Four picks are enough to show distinct decisions without padding the list.</p><p>Prices were checked October 14, 2026 where stated; shipping, tax, subscriptions and waste are excluded. The dose arithmetic uses 18 g espresso and 20 g filter solely to make pack-price comparisons. Follow your basket, brewer and grinder instructions, check the roast date and current lot, and use the linked full review for uncertainty on each product.</p></div></section>
        <section class="review-section" id="faq"><header class="review-section-heading"><p class="review-overline">Quick answers</p><h2>Espresso and drip bean FAQ</h2></header><div class="bean-faq">{guide.faqs.map((faq) => <article><h3>{faq.question}</h3><p>{faq.answer}</p></article>)}</div></section>
        <section class="review-section" id="sources"><header class="review-section-heading"><p class="review-overline">Trace the claims</p><h2>Sources</h2></header><ol class="review-source-list">{guide.sources.map((source,index) => <li id={`s${index+1}`}><a href={source.href} target="_blank" rel="noopener">{source.title} ↗</a><p>{source.note} Checked October 14, 2026.</p></li>)}</ol></section>
        <section class="final-verdict"><p class="review-overline">Your first useful bag</p><h2>Start with 12 oz and two saved recipes</h2><p>Pick for the drink you make most often, then test that same bag as both espresso and drip. Record the grind and recipe for each. A fresh small bag that works twice is a better answer than a five-pound bargain that only works on paper.</p><a class="review-buy-button review-buy-button-dark" href={local('/coffee-beans/')}>Explore all coffee bean reviews →</a></section>
      </article>
    </div>
  </main>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
</HomeLayout>
