---
import HomeLayout from '../../layouts/HomeLayout.astro';
import { beanReviews } from '../../data/bean-reviews';
import '../../styles/review.css';
import '../../styles/beans.css';
import '../../styles/bean-guides.css';

const date = '2026-11-10';
const path = '/coffee-beans/best-fruit-forward-espresso-beans/';
const canonical = 'https://coffeedant.com' + path;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const local = (p: string) => base + p.replace(/^\//, '');
const title = 'Best Fruit-Forward Coffee Beans for Straight Espresso';
const description = 'Choose a fruit-led straight espresso from three exact US whole-bean blends: Onyx Tropical Weather, Onyx Geometry and Verve Sermon. Research-led, with no Coffeedant tasting claim.';
const choices = [
  {slug:'/coffee-beans/onyx-tropical-weather/', best:'A vivid mixed-berry and plum direction', notes:'Mixed berries, sweet tea, raw honey, plum', basis:'Onyx describes a light, changing 50/50 mix of washed and natural Ethiopian coffees and publishes an espresso method. The natural component makes this the most overtly fruit-led brief here.', tradeoff:'A seasonal blend changes its component lots. A recipe published for one bag is a starting point, and an especially bright shot may take more adjustment on your grinder.', skip:'You prefer a chocolate-led, lower-acidity brief or want a fixed farm and variety.'},
  {slug:'/coffee-beans/onyx-geometry/', best:'Berry and stone fruit with a tea-like finish', notes:'Berries, stone fruit, Earl Grey, honeysuckle', basis:'Onyx explicitly likes Geometry as both filter coffee and espresso. The current Colombia–Ethiopia washed blend is a lighter fruit direction without Tropical Weather’s natural-process component.', tradeoff:'Geometry is still light and fruit-led. Onyx’s current espresso guide is a roaster starting point, not a promise of sweetness on every machine.', skip:'You want a natural-process berry profile, or primarily want dark chocolate and low perceived brightness.'},
  {slug:'/coffee-beans/verve-sermon/', best:'Blueberry beside cocoa in a medium blend', notes:'Blueberry pie, cocoa, candied pecan', basis:'Verve sells Sermon as an espresso blend and explains that its natural coffee component contributes the blueberry impression. Its medium-roast and cocoa brief make it the bridge from a conventional espresso profile to fruit.', tradeoff:'Blueberry pie is Verve’s tasting description, not added flavoring or a Coffeedant result. Current component origins and lots should be checked on the delivered bag.', skip:'You want an all-light, tea-like espresso or no cocoa and nut direction.'}
];
const picks = choices.map(p => ({...p, review: beanReviews.find(r => r.slug === p.slug)!}));
if (picks.some(p => !p.review)) throw new Error('Fruit-forward espresso guide pick lacks a canonical bean review');
const sources = [
  ['Onyx Tropical Weather product and espresso guide','https://onyxcoffeelab.com/products/tropical-weather','Current Ethiopian washed/natural identity, light roast, roaster notes and espresso instructions.'],
  ['Onyx Geometry product and espresso guide','https://onyxcoffeelab.com/products/geometry','Current Colombia–Ethiopia washed identity, light roast, roaster notes and espresso instructions.'],
  ['Onyx brew guides','https://onyxcoffeelab.com/pages/brew-guides','Both blends appear with filter and espresso methods; recipes can change.'],
  ['Verve Sermon US product','https://www.vervecoffee.com/products/sermon','Current espresso-blend identity, medium roast and roaster notes.'],
  ['Verve, How We Brew Sermon','https://www.vervecoffee.com/blogs/the-verve-blog/how-we-brew-sermon','Roaster explanation of the natural component and intended espresso use; older article, checked against current product.'],
  ['Pull & Pour, Tropical Weather','https://pullandpourcoffee.com/tropical-weather-blend-onyx-coffee-lab/','Independent older sample found espresso enjoyable while preferring pour-over; not a current-lot comparison.'],
  ['Geometry owner discussion','https://www.reddit.com/r/pourover/comments/1vkexiv/onyx_geometry/','One buyer preferred filter after buying for espresso; anecdotal and setup-dependent.'],
  ['Sermon owner discussion','https://www.reddit.com/r/espresso/comments/1nrgo25/','Individual espresso experience, not a consensus or measured taste ranking.']
];
const faqs = [
  {q:'Which is the most fruit-led starting bag?',a:'Tropical Weather has the most explicit mixed-berry and plum brief and includes a natural Ethiopian component. That is an inference from Onyx’s description, not a Coffeedant taste ranking.'},
  {q:'Which one also makes sense for filter coffee?',a:'Onyx explicitly positions Geometry and Tropical Weather for filter and espresso. Geometry is the washed Colombia–Ethiopia option; Tropical Weather combines washed and natural Ethiopian lots. Use separate grind settings for each method.'},
  {q:'Does Sermon contain blueberry flavoring?',a:'Verve describes blueberry pie as a tasting note and attributes it to a natural coffee component. Check the product label if added ingredients matter to you; no added flavoring is asserted here.'},
  {q:'Can I copy the roaster espresso recipe exactly?',a:'Use it as a starting point only. Basket size, grinder, water, coffee age and taste preference can require a different dose, yield or grind. Record your own adjustments.'},
  {q:'Will the blend taste the same all year?',a:'No. Tropical Weather is seasonal, and all three blends can change components or lots. Check the current roaster listing and delivered bag before assuming a permanent origin or variety.'},
  {q:'Did Coffeedant taste these coffees side by side?',a:'No. This comparison uses current roaster records, an older independent sample, owner context and our linked research-led reviews. We do not assign sensory scores.'}
];
const author = {'@type':'Person',name:'Aleksandar Spasevski',jobTitle:'Editor, Coffeedant',url:'https://coffeedant.com/about/',image:'https://coffeedant.com/images/author-aleksandar-spasevski.jpg'};
const schema = {'@context':'https://schema.org','@graph':[
  {'@type':'Article','@id':canonical+'#article',headline:title,description,inLanguage:'en-US',datePublished:date,dateModified:date,author,mainEntityOfPage:canonical,image:picks.map(p=>p.review.image),citation:sources.map(s=>s[1]),publisher:{'@type':'Organization',name:'Coffeedant',url:'https://coffeedant.com/'}},
  {'@type':'ItemList','@id':canonical+'#shortlist',name:title,itemListElement:picks.map((p,i)=>({'@type':'ListItem',position:i+1,name:p.review.roaster+' '+p.review.coffee,url:'https://coffeedant.com'+p.slug}))},
  {'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://coffeedant.com/'},{'@type':'ListItem',position:2,name:'Coffee beans',item:'https://coffeedant.com/coffee-beans/'},{'@type':'ListItem',position:3,name:title,item:canonical}]},
  {'@type':'FAQPage',mainEntity:faqs.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}
]};
---
<HomeLayout title={title+' | Coffeedant'} description={description} canonicalPath={path} image={picks[0].review.image} imageAlt={picks[0].review.imageAlt} ogType="article" published={date} updated={date}>
  <main id="main-content" class="review-page bean-buying-guide" data-guide-kind="coffee-beans"><div class="review-shell">
    <nav class="review-breadcrumbs" aria-label="Breadcrumb"><a href={base}>Home</a><span>/</span><a href={local('/coffee-beans/')}>Coffee beans</a><span>/</span><span>Fruit-forward espresso</span></nav>
    <header class="bean-guide-header"><p class="review-overline">Coffee buying guide · research-led · United States</p><h1>{title}</h1><p class="bean-lead">Fruit in espresso can read like mixed berries, washed-coffee stone fruit and tea, or blueberry beside cocoa. These three whole-bean blends have current roaster espresso guidance and different flavor briefs. Choose a first bag by the kind of contrast you want, then dial it in on your own equipment.</p><aside class="review-author-card"><div class="review-author-head"><img src={local('/images/author-aleksandar-spasevski.jpg')} alt="Aleksandar Spasevski, editor at Coffeedant" width="46" height="46" /><div><strong>Aleksandar Spasevski</strong><small>Editor, Coffeedant</small></div></div><p>Published and checked <time datetime={date}>November 10, 2026</time> · US whole-bean context</p><p>I compared roaster product pages and recipes with independent and owner context and our full reviews. I have not bought, brewed or tasted these bags. Best-for labels are research-led judgments.</p></aside></header>
    <nav class="bean-jump" aria-label="Guide sections"><strong>Choose a fruit profile</strong><a href="#criteria">Selection</a><a href="#compare">Compare</a><a href="#picks">The picks</a><a href="#dial-in">Dial in</a><a href="#details">Details</a><a href="#buying">Buying</a><a href="#faq">FAQ</a><a href="#sources">Sources</a></nav>
    <article class="bean-article">
      <section class="review-section" id="criteria"><header class="review-section-heading"><p class="review-overline">Selection method</p><h2>Find fruit with an actual espresso path</h2></header><div class="review-section-body"><p>We required an exact current US whole-bean blend, an existing Coffeedant review, a roaster-attributed fruit note and explicit roaster espresso positioning or brewing guidance. Tropical Weather and Geometry have Onyx espresso guides; Verve sells Sermon as an espresso blend and has explained its blueberry profile. We excluded fruit-forward filter coffees without comparable espresso evidence, and we did not use a price or taste score to rank bags. [1] [2] [3] [4] [5]</p><p>The important split is <strong>fruit alone versus fruit with a familiar base</strong>. Onyx’s Tropical Weather combines washed and natural Ethiopian components for a mixed-berry and plum brief. Geometry pairs washed Colombia and Ethiopia for berries, stone fruit and tea. Sermon places Verve’s blueberry-pie descriptor beside cocoa and candied pecan in a medium blend. These are roaster descriptions of intended flavor, not tasting results from our kitchen. [1] [2] [4]</p><p>Two picks share a roaster because their component processing and espresso briefs solve different first-bag decisions. The Verve pick adds a medium-roast bridge. The older independent Tropical Weather sample and individual owner accounts help expose possible preference splits; none measured these three coffees side by side or establishes a current-lot winner. [6] [7] [8]</p></div></section>
      <section class="review-section" id="compare"><header class="review-section-heading"><p class="review-overline">At a glance</p><h2>Three fruit directions for a straight shot</h2></header><div class="bean-guide-table" tabindex="0" role="region" aria-label="Scrollable fruit-forward espresso bean comparison"><table><caption>Current US roaster briefs checked November 10, 2026; no Coffeedant tasting or price ranking</caption><thead><tr><th scope="col">Exact coffee</th><th scope="col">Best for</th><th scope="col">Roaster notes</th><th scope="col">Skip if</th></tr></thead><tbody>{picks.map(p=><tr><th scope="row"><a href={local(p.slug)}>{p.review.roaster} {p.review.coffee}</a></th><td>{p.best}</td><td>{p.notes}</td><td>{p.skip}</td></tr>)}</tbody></table></div></section>
      <section class="review-section" id="picks"><header class="review-section-heading"><p class="review-overline">First-bag choices</p><h2>What each bag asks of you</h2></header><div class="bean-index-grid">{picks.map(p=><article class="bean-guide-pick"><img src={p.review.image} alt={p.review.imageAlt} width="360" height="360" loading="lazy" decoding="async" /><div><p class="review-overline">{p.best}</p><h3><a href={local(p.slug)}>{p.review.roaster} {p.review.coffee}</a></h3><p><strong>Why:</strong> {p.basis}</p><p><strong>Tradeoff:</strong> {p.tradeoff}</p><p><strong>Skip if:</strong> {p.skip}</p><p class="bean-credit"><a href={p.review.imageSource} target="_blank" rel="noopener">Image: {p.review.roaster}</a>. {p.review.imageCredit}</p><a class="bean-guide-review-link" href={local(p.slug)}>Read the full review →</a></div></article>)}</div></section>
      <section class="review-section" id="dial-in"><header class="review-section-heading"><p class="review-overline">Use the bag</p><h2>Expect to change the grinder setting</h2></header><div class="review-section-body"><p>Start with the exact roaster espresso guide where one exists, then adjust to your basket, water and taste. Onyx currently lists different espresso starting methods for Geometry and Tropical Weather. It is safer to record dose, yield, grind setting and the bag’s roast date than to copy one setting across both. We have not verified either recipe on a Coffeedant machine. [1] [2] [3]</p><p>With Tropical Weather, decide whether you enjoy the natural-process fruit emphasis before buying a larger size. Geometry offers a washed-coffee route to fruit and a roaster-supported filter fallback. Sermon has the cocoa and nut brief if you want berry without leaving a more conventional espresso frame. None guarantees a specific blueberry, plum or floral note after you change grinder, water or extraction.</p><p>When a shot is sharply sour or dull, change one variable at a time rather than assuming the bag is defective. A light blend may take more dial-in time than a familiar darker coffee. The independent older Tropical Weather account preferred its pour-over result while still finding espresso worthwhile; a Geometry owner reported preferring filter after intending espresso. These are useful preference warnings, not proof that a current bag will behave the same way. [6] [7]</p></div></section>
      <section class="review-section" id="details"><header class="review-section-heading"><p class="review-overline">Detailed comparison</p><h2>What the evidence actually separates</h2></header><div class="bean-guide-table" tabindex="0" role="region" aria-label="Scrollable detailed fruit-forward espresso comparison"><table><caption>Maker-reported identity and flavor; components and methods may change</caption><thead><tr><th scope="col">Factor</th>{picks.map(p=><th scope="col"><a href={local(p.slug)}>{p.review.coffee}</a></th>)}</tr></thead><tbody><tr><th scope="row">Current roast brief</th><td>Light</td><td>Light</td><td>Medium</td></tr><tr><th scope="row">Component distinction</th><td>Ethiopian washed and natural lots</td><td>Colombia and Ethiopia, washed</td><td>Blend with a natural coffee component; check current bag origins</td></tr><tr><th scope="row">Fruit descriptor</th><td>Mixed berries and plum</td><td>Berries and stone fruit</td><td>Blueberry pie beside cocoa</td></tr><tr><th scope="row">Espresso basis</th><td>Onyx published espresso guide</td><td>Onyx published espresso guide and café use</td><td>Verve espresso blend and brew article</td></tr><tr><th scope="row">Main uncertainty</th><td>Seasonal components and dial-in</td><td>Preference for filter versus espresso</td><td>Current component details and the cocoa-fruit balance</td></tr></tbody></table></div></section>
      <section class="review-section" id="buying"><header class="review-section-heading"><p class="review-overline">Purchase and alternatives</p><h2>Buy a bag you can finish and learn</h2></header><div class="review-section-body"><p>Confirm the exact whole-bean product, current size, roast or ship date where available, component detail, delivery cost and US stock before checkout. Buy a manageable first bag; keep it sealed in a cool, dry place and grind shortly before brewing. We make no current price, discount or relative-value claim, and a subscription offer should be checked separately from a one-time bag.</p><p>If a fruit note alongside chocolate sounds more comfortable, the <a href={local('/coffee-beans/best-chocolate-forward-espresso-beans/')}>chocolate-forward straight-espresso guide</a> compares a different sensory direction. For milk as the main drink, use the <a href={local('/coffee-beans/best-coffee-beans-for-milk-drinks/')}>milk-drink guide</a>. If filter coffee must share the bag, start with the <a href={local('/coffee-beans/best-coffee-beans-for-espresso-and-drip/')}>dual-method comparison</a> and the current roaster recipes rather than treating an espresso setting as a filter setting.</p><p>Coffeedant may earn from affiliate links elsewhere on this site at no extra cost to you. Product images identify the bags and are credited to their roasters; they are not photographs of Coffeedant tasting.</p></div></section>
      <section class="review-section" id="methodology"><header class="review-section-heading"><p class="review-overline">Evidence and limits</p><h2>How this shortlist was made</h2></header><div class="review-section-body"><p>On November 10, 2026, we checked current roaster product pages and brew guidance against the three existing full reviews. We used an older independent Tropical Weather account and owner discussions only for possible preference and setup limits. Our best-for labels infer likely fit from documented blend briefs; there was no purchase, controlled tasting, extraction measurement or freshness test. A new lot, water or grinder can change the cup.</p></div></section>
      <section class="review-section" id="faq"><header class="review-section-heading"><p class="review-overline">Quick answers</p><h2>Fruit-forward espresso FAQ</h2></header><div class="bean-faq">{faqs.map(f=><article><h3>{f.q}</h3><p>{f.a}</p></article>)}</div></section>
      <section class="review-section" id="sources"><header class="review-section-heading"><p class="review-overline">Attributable evidence</p><h2>Sources checked November 10, 2026</h2></header><ol class="review-source-list">{sources.map((s,i)=><li id={'s'+(i+1)}><a href={s[1]} target="_blank" rel="noopener">{s[0]} ↗</a><p>{s[2]} Checked November 10, 2026.</p></li>)}</ol></section>
      <section class="final-verdict"><p class="review-overline">The first bag</p><h2>Choose which fruit belongs in your shot</h2><p>Start with Tropical Weather for a natural-process berry and plum emphasis, Geometry for washed-coffee fruit and tea, or Sermon for blueberry beside cocoa. The roasters supply those descriptions; your repeatable shot decides whether to buy the bag again.</p><a class="review-buy-button review-buy-button-dark" href={local('/coffee-beans/')}>Explore all bean reviews →</a></section>
    </article>
  </div></main>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
</HomeLayout>
