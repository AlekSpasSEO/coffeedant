---
import HomeLayout from '../../layouts/HomeLayout.astro';
import guide from '../../data/dark-roast-guide.json';
import '../../styles/review.css';
import '../../styles/beans.css';
import '../../styles/bean-guides.css';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const local = (path: string) => `${base}${path.replace(/^\//, '')}`;
const canonical = `https://coffeedant.com${guide.canonicalPath}`;
const cite = (paragraph: string) => paragraph.replace(/\[(\d+)\]/g, (_match, number) => `<a class="bean-cite" href="#s${number}" aria-label="Source ${number}">[${number}]</a>`);
const jumpLabels: Record<string,string> = {decision:'Choose your drink',criteria:'Selection criteria',milk:'Espresso and milk',drip:'Drip coffee',retail:'Direct or retail',cost:'Cost per dose',storage:'Freshness',grinder:'Grinder care',trial:'First bag',alternatives:'Alternatives'};
const author = { '@type': 'Person', name: 'Aleksandar Spasevski', jobTitle: 'Editor, Coffeedant', url: 'https://coffeedant.com/about/', image: 'https://coffeedant.com/images/author-aleksandar-spasevski.jpg' };
const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'Article', '@id': `${canonical}#article`, headline: guide.title, description: guide.description, genre: 'Research-led coffee buying guide', inLanguage: 'en-US', datePublished: guide.published, dateModified: guide.updated, author, mainEntityOfPage: canonical, image: guide.picks.map((pick) => pick.image), citation: guide.sources.map((source) => source.href), publisher: { '@type': 'Organization', name: 'Coffeedant', url: 'https://coffeedant.com/' } },
  { '@type': 'ItemList', '@id': `${canonical}#shortlist`, name: 'Dark-roast coffee buying shortlist', itemListOrder: 'https://schema.org/ItemListUnordered', itemListElement: guide.picks.map((pick, index) => ({ '@type': 'ListItem', position: index + 1, name: pick.name, url: `https://coffeedant.com${pick.slug}` })) },
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://coffeedant.com/' }, { '@type': 'ListItem', position: 2, name: 'Coffee beans', item: 'https://coffeedant.com/coffee-beans/' }, { '@type': 'ListItem', position: 3, name: 'Best dark-roast coffee beans', item: canonical }] },
  { '@type': 'FAQPage', mainEntity: guide.faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) },
  ...guide.picks.map((pick) => ({ '@type': 'ImageObject', contentUrl: pick.image, caption: `${pick.name}: official product photograph`, creditText: pick.roaster, creator: { '@type': 'Organization', name: pick.roaster }, url: pick.source })),
] };
---
<HomeLayout title={`${guide.title} | Coffeedant`} description={guide.description} canonicalPath={guide.canonicalPath} image={guide.picks[0].image} imageAlt="Counter Culture Forty-Six coffee bag" ogType="article" published={guide.published} updated={guide.updated}>
  <main id="main-content" class="review-page bean-buying-guide" data-guide-kind="coffee-beans">
    <div class="review-shell">
      <nav class="review-breadcrumbs" aria-label="Breadcrumb"><a href={base}>Home</a><span>/</span><a href={local('/coffee-beans/')}>Coffee beans</a><span>/</span><span>Dark-roast buying guide</span></nav>
      <header class="bean-guide-header"><p class="review-overline">Coffee buying guide · research-led</p><h1>Best dark roast coffee beans</h1><p class="bean-lead">{guide.deck}</p><aside class="review-author-card"><div class="review-author-head"><img src={local('/images/author-aleksandar-spasevski.jpg')} alt="Aleksandar Spasevski, editor at Coffeedant" width="46" height="46" /><div><strong>Aleksandar Spasevski</strong><small>Editor, Coffeedant</small></div></div><p>Published and checked <time datetime={guide.published}>October 13, 2026</time> · US purchase context</p><p>I selected distinct buying reasons from current roaster records and relevant brewing and ownership guidance. I have not bought, brewed or tasted these coffees, and no sensory scores are assigned.</p></aside></header>
      <nav class="bean-jump" aria-label="Guide sections"><strong>Choose a buying reason</strong>{guide.sections.map((section) => <a href={`#${section.id}`}>{jumpLabels[section.id] ?? section.title}</a>)}<a href="#picks">The picks</a><a href="#quick-compare">Quick comparison</a><a href="#detailed-compare">Detailed comparison</a><a href="#faq">FAQ</a><a href="#sources">Sources</a></nav>
      <article class="bean-article">
        {guide.sections.slice(0,2).map((section) => <section class="review-section" id={section.id}><header class="review-section-heading"><p class="review-overline">Before the shortlist</p><h2>{section.title}</h2></header><div class="review-section-body">{section.paragraphs.map((paragraph) => <p set:html={cite(paragraph)} />)}</div></section>)}
        <section class="review-section" id="quick-compare"><header class="review-section-heading"><p class="review-overline">Three distinct buying reasons</p><h2>Quick comparison</h2></header><div class="bean-guide-table" tabindex="0" role="region" aria-label="Scrollable quick coffee comparison"><table><caption>Exact whole-bean selections; US listing observations on October 13, 2026</caption><thead><tr><th scope="col">Coffee</th><th scope="col">Best buying reason</th><th scope="col">Dated reference price</th><th scope="col">Pause if</th></tr></thead><tbody>{guide.picks.map((pick) => <tr><th scope="row"><a href={local(pick.slug)}>{pick.name}</a></th><td>{pick.bestFor}</td><td>{pick.price}</td><td>{pick.avoidIf}</td></tr>)}</tbody></table></div></section>
        <section class="review-section" id="picks"><header class="review-section-heading"><p class="review-overline">Read the full review</p><h2>Match a coffee to the job</h2></header><div class="bean-index-grid">{guide.picks.map((pick) => <article class="bean-guide-pick"><img src={pick.image} alt={`${pick.name} official coffee bag`} width="360" height="360" loading="lazy" decoding="async" /><div><p class="review-overline">{pick.bestFor}</p><h3><a href={local(pick.slug)}>{pick.name}</a></h3><p>{pick.flavor}.</p><p>{pick.tradeoff}</p><p><strong>Think twice:</strong> {pick.avoidIf}.</p><p class="bean-credit"><a href={pick.source} target="_blank" rel="noopener">Image: {pick.roaster}</a>. Official product identification photograph.</p><a class="bean-guide-review-link" href={local(pick.slug)}>Read the full review →</a></div></article>)}</div></section>
        <section class="review-section" id="detailed-compare"><header class="review-section-heading"><p class="review-overline">The order and the routine</p><h2>Detailed comparison</h2></header><div class="bean-guide-table" tabindex="0" role="region" aria-label="Scrollable detailed coffee comparison"><table><caption>Buying records and transparent calculations; no taste rankings or live discounts</caption><thead><tr><th scope="col">Buying factor</th>{guide.picks.map((pick) => <th scope="col"><a href={local(pick.slug)}>{pick.name}</a></th>)}</tr></thead><tbody>{[['Roaster flavor brief','flavor'],['Pack choices','format'],['Record to inspect','record'],['Brewing brief','method'],['Illustrative bean cost','cost'],['Main tradeoff','tradeoff']].map(([label,key]) => <tr><th scope="row">{label}</th>{guide.picks.map((pick) => <td>{pick[key as keyof typeof pick]}</td>)}</tr>)}</tbody></table></div></section>
        {guide.sections.slice(2).map((section) => <section class="review-section" id={section.id}><header class="review-section-heading"><p class="review-overline">Make the choice repeatable</p><h2>{section.title}</h2></header><div class="review-section-body">{section.paragraphs.map((paragraph) => <p set:html={cite(paragraph)} />)}</div></section>)}
        <section class="review-section" id="related"><header class="review-section-heading"><p class="review-overline">The surrounding routine</p><h2>Useful coffee and grinder comparisons</h2></header><div class="bean-alternatives"><a href={local('/coffee-beans/counter-culture-big-trouble/')}><strong>Counter Culture Big Trouble</strong><span>Compare a medium-dark direction outside this shortlist.</span></a><a href={local('/coffee-beans/counter-culture-hologram/')}><strong>Counter Culture Hologram</strong><span>Compare a different rotating blend brief.</span></a><a href={local('/grinder/baratza-encore-esp/')}><strong>Baratza Encore ESP</strong><span>Understand stepped adjustment and separate grinder care.</span></a><a href={local('/grinder/1zpresso-k-ultra/')}><strong>1Zpresso K-Ultra</strong><span>Consider an all-round manual grinding routine.</span></a></div></section>
        <section class="review-section" id="methodology"><header class="review-section-heading"><p class="review-overline">Evidence and limits</p><h2>How these picks were selected</h2></header><div class="review-section-body"><p>This is a research-led buying guide. Exact product identity, roast classification and purchase details come from the named roasters. The best-for labels are Coffeedant editorial judgments about distinct buying jobs. We have not conducted a tasting, bought a bag, measured caffeine or verified universal machine compatibility. The price calculations use the stated pack mass and an illustrative 18 g dose, with shipping, tax and waste excluded.</p><p>The shortlist is deliberately limited to three current documented whole-bean blends with full Coffeedant reviews. It is not an exhaustive market ranking. Each linked review records its own source limits. Follow the current seller selection and exact appliance instructions before buying or loading a hopper.</p></div></section>
        <section class="review-section" id="faq"><header class="review-section-heading"><p class="review-overline">Quick answers</p><h2>Dark-roast coffee FAQ</h2></header><div class="bean-faq">{guide.faqs.map((faq) => <article><h3>{faq.question}</h3><p>{faq.answer}</p></article>)}</div></section>
        <section class="review-section" id="sources"><header class="review-section-heading"><p class="review-overline">Trace the claims</p><h2>Sources</h2></header><ol class="review-source-list">{guide.sources.map((source,index) => <li id={`s${index+1}`}><a href={source.href} target="_blank" rel="noopener">{source.title} ↗</a><p>{source.note} Checked October 13, 2026.</p></li>)}</ol></section>
        <section class="final-verdict"><p class="review-overline">Your next useful purchase</p><h2>Buy for the drink and the bag you will finish</h2><p>Investigate Forty-Six for a milk-first espresso brief and dated component record, French Roast for a drip routine with sensible pack size, or Major Dickason's for an exact-format direct-versus-retail comparison. Start small, keep the recipe repeatable and let your own bag answer the taste question.</p><a class="review-buy-button review-buy-button-dark" href={local('/coffee-beans/')}>Explore all coffee bean reviews →</a></section>
      </article>
    </div>
  </main>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
</HomeLayout>

