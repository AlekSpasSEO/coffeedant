---
import HomeLayout from '../../layouts/HomeLayout.astro';
import { beanReviews } from '../../data/bean-reviews';
import '../../styles/review.css';
import '../../styles/beans.css';
import '../../styles/bean-guides.css';

const date = '2026-11-11';
const path = '/coffee-beans/best-espresso-beans-with-brew-recipes/';
const canonical = 'https://coffeedant.com' + path;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const local = (p: string) => base + p.replace(/^\//, '');
const title = 'Best Espresso Beans with Published Starting Recipes';
const description = 'Three exact US whole-bean coffees with roaster-published espresso dose and yield: Intelligentsia Black Cat Analog, Onyx Monarch and Onyx Geometry. Research-led comparison.';
const choices = [
  {slug:'/coffee-beans/intelligentsia-black-cat-analog-espresso/', best:'A chocolate-led first shot for milk', dose:'18 g', yield:'45 g', ratio:'1:2.5', notes:'Dark chocolate, toasted marshmallow, baking spices', roast:'Darker than Black Cat Classic; Intelligentsia calls it traditional', basis:'Intelligentsia gives the dose and beverage yield directly on the Analog product page. The darker Black Cat brief is a clear entry point if your household makes cappuccinos and wants a familiar chocolate direction.', tradeoff:'The page gives a target ratio but not a universal grinder setting for your basket or water. An older independent tasting used a different ratio; neither proves how a current bag tastes.', skip:'You mainly want bright straight shots or a fixed named farm and variety.'},
  {slug:'/coffee-beans/onyx-monarch/', best:'A darker shot with winey berry beside chocolate', dose:'19 g', yield:'47 g', ratio:'about 1:2.47', notes:'Dark chocolate, molasses, red wine, dried berries', roast:'Expressive dark, according to Onyx', basis:'Onyx publishes a Monarch espresso guide with a 19 g dose, 47 g yield and a pressure timeline. The roaster designs this year-round blend specifically for espresso and describes a chocolate and winey-berry direction.', tradeoff:'Its Colombia and Ethiopia components are rotating lots. A published pressure profile cannot be reproduced exactly on every home machine, and individual owner reactions differ.', skip:'You want a lighter, tea-like fruit brief or need an unchanging lot.'},
  {slug:'/coffee-beans/onyx-geometry/', best:'A lighter washed-coffee experiment with filter fallback', dose:'20 g', yield:'47 g', ratio:'1:2.35', notes:'Berries, stone fruit, Earl Grey, honeysuckle', roast:'Light, according to Onyx', basis:'Onyx lists a separate 20 g to 47 g espresso recipe for Geometry and also publishes a filter method. The washed Colombia–Ethiopia blend gives a different first-bag question: whether you enjoy fruit and tea in a straight shot.', tradeoff:'A light roast may ask for more grinder adjustment than a familiar darker blend. One owner bought it for espresso and preferred it as pour-over; that is a preference signal, not a general result.', skip:'You want a traditional low-brightness espresso or have no interest in filter as a backup use.'}
];
const picks = choices.map(p => ({...p, review: beanReviews.find(r => r.slug === p.slug)!}));
if (picks.some(p => !p.review)) throw new Error('Recipe guide pick lacks a canonical bean review');
const sources = [
  ['Intelligentsia Black Cat Analog US product','https://www.intelligentsia.com/products/black-cat-analog-espresso','Exact Analog identity, 18 g to 45 g espresso start, roast direction and roaster flavor notes.'],
  ['Onyx Monarch US product','https://onyxcoffeelab.com/products/monarch','Current blend identity, espresso intent, rotating lots and roaster flavor brief.'],
  ['Onyx Geometry US product','https://onyxcoffeelab.com/products/geometry','Current washed-blend identity, roast and roaster flavor brief.'],
  ['Onyx espresso brew guides','https://onyxcoffeelab.com/pages/brew-guides','Monarch 19 g to 47 g and Geometry 20 g to 47 g starting recipes and pressure timelines.'],
  ['Coffee Cantata Black Cat Analog review','https://coffeecantata.co/?p=5923','Independent 2019 tasting of one Analog bag; historical context only, not a current-lot guarantee.'],
  ['Geometry owner discussion','https://www.reddit.com/r/pourover/comments/1vkexiv/onyx_geometry/','One buyer preferred filter after intending espresso; self-selected owner evidence.'],
  ['Monarch owner discussion','https://www.reddit.com/r/espresso/comments/1os2h0o/cant_get_onyx_monarch_to_not_be_sour_linea_pb_swan/','A setup-specific dial-in difficulty; anecdote, not a reliability or flavor rate.']
];
const faqs = [
  {q:'Is 18 g to 45 g the right recipe for every espresso machine?',a:'No. That is Intelligentsia’s Black Cat Analog starting point. Basket capacity, grind, water, roast age and taste can all change the useful dose or yield.'},
  {q:'Does Onyx publish the same recipe for Monarch and Geometry?',a:'No. The checked Onyx guide gives Monarch 19 g to 47 g and Geometry 20 g to 47 g, with different pressure timelines. Check the current guide for the bag you buy.'},
  {q:'What if my machine cannot control pressure?',a:'Use the published dose and yield as an initial reference, then adjust grind and taste on your machine. Do not treat Onyx’s pressure timeline as a requirement your equipment can meet.'},
  {q:'Which bag also has a filter method?',a:'Onyx publishes a filter recipe for Geometry. Monarch also has filter guidance, but this shortlist recommends Geometry specifically when a lighter washed-coffee filter fallback appeals to you.'},
  {q:'Are the flavor notes Coffeedant tasting results?',a:'No. They are the roasters’ descriptions. Coffeedant has not bought, brewed or tasted these bags or measured extraction.'},
  {q:'How do I compare the cost of these recipes?',a:'Check current bag size, price, shipping and roast date at the US seller, then divide the delivered bag cost by the number of doses you will actually use. This guide makes no current price or discount claim.'}
];
const author = {'@type':'Person',name:'Aleksandar Spasevski',jobTitle:'Editor, Coffeedant',url:'https://coffeedant.com/about/',image:'https://coffeedant.com/images/author-aleksandar-spasevski.jpg'};
const schema = {'@context':'https://schema.org','@graph':[
  {'@type':'Article','@id':canonical+'#article',headline:title,description,inLanguage:'en-US',datePublished:date,dateModified:date,author,mainEntityOfPage:canonical,image:picks.map(p=>p.review.image),citation:sources.map(s=>s[1]),publisher:{'@type':'Organization',name:'Coffeedant',url:'https://coffeedant.com/'}},
  {'@type':'ItemList','@id':canonical+'#shortlist',name:title,itemListElement:picks.map((p,i)=>({'@type':'ListItem',position:i+1,name:p.review.roaster+' '+p.review.coffee,url:'https://coffeedant.com'+p.slug}))},
  {'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://coffeedant.com/'},{'@type':'ListItem',position:2,name:'Coffee beans',item:'https://coffeedant.com/coffee-beans/'},{'@type':'ListItem',position:3,name:title,item:canonical}]},
  {'@type':'FAQPage',mainEntity:faqs.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}
]};
---
<HomeLayout title={title+' | Coffeedant'} description={description} canonicalPath={path} image={picks[0].review.image} imageAlt={picks[0].review.imageAlt} ogType="article" published={date} updated={date}>
  <main id="main-content" class="review-page bean-buying-guide" data-guide-kind="coffee-beans"><div class="review-shell">
    <nav class="review-breadcrumbs" aria-label="Breadcrumb"><a href={base}>Home</a><span>/</span><a href={local('/coffee-beans/')}>Coffee beans</a><span>/</span><span>Espresso starting recipes</span></nav>
    <header class="bean-guide-header"><p class="review-overline">Coffee buying guide · research-led · United States</p><h1>{title}</h1><p class="bean-lead">A published espresso recipe makes the first shot less arbitrary. It does not make three coffees interchangeable. Compare a chocolate-led Analog, a darker berry-and-molasses Monarch, and a lighter washed Geometry by the ratio each roaster actually gives and the drink you want to learn.</p><aside class="review-author-card"><div class="review-author-head"><img src={local('/images/author-aleksandar-spasevski.jpg')} alt="Aleksandar Spasevski, editor at Coffeedant" width="46" height="46" /><div><strong>Aleksandar Spasevski</strong><small>Editor, Coffeedant</small></div></div><p>Published and checked <time datetime={date}>November 11, 2026</time> · US whole-bean context</p><p>I compared current roaster recipes with the exact product records, dated independent and owner accounts, and our full reviews. I have not bought, brewed or tasted these bags. These are buying-fit judgments, not sensory scores.</p></aside></header>
    <nav class="bean-jump" aria-label="Guide sections"><strong>Choose a first shot</strong><a href="#criteria">Selection</a><a href="#compare">Recipes</a><a href="#picks">The picks</a><a href="#use">Use the recipe</a><a href="#details">Details</a><a href="#buying">Buying</a><a href="#faq">FAQ</a><a href="#sources">Sources</a></nav>
    <article class="bean-article">
      <section class="review-section" id="criteria"><header class="review-section-heading"><p class="review-overline">Selection method</p><h2>Require a recipe for the exact coffee</h2></header><div class="review-section-body"><p>We included current US whole-bean coffees with an existing full Coffeedant review and a named roaster-published espresso dose and yield for the exact product. We selected three different first-shot decisions: a traditional chocolate-led coffee for milk, a darker espresso blend with a berry accent, and a light washed blend that can also move to filter. The recipe is the inclusion test, not evidence that a coffee is easier, tastes better or extracts consistently across machines. [1] [2] [3] [4]</p><p>We excluded generic espresso-labeled bags whose current page lacks a product-specific dose and yield. We also excluded single-origin lots whose recipe could disappear with the harvest and did not rank by a price we could not verify for the exact checkout selection. This is a short list of documented starting points, not a market-wide taste ranking.</p><p>The independent Analog account is from 2019. It shows one taster using a different ratio, which is useful evidence that a roaster recipe is not a final answer. The Geometry and Monarch owner reports illustrate preference and setup variation, without establishing a typical outcome for a new shipment. [5] [6] [7]</p></div></section>
      <section class="review-section" id="compare"><header class="review-section-heading"><p class="review-overline">At a glance</p><h2>Three published dose and yield pairs</h2></header><div class="bean-guide-table" tabindex="0" role="region" aria-label="Scrollable espresso bean and recipe comparison"><table><caption>US roaster recipes checked November 11, 2026; all are starting points, not Coffeedant extraction results</caption><thead><tr><th scope="col">Exact coffee</th><th scope="col">Best first bag for</th><th scope="col">Roaster start</th><th scope="col">Skip if</th></tr></thead><tbody>{picks.map(p=><tr><th scope="row"><a href={local(p.slug)}>{p.review.roaster} {p.review.coffee}</a></th><td>{p.best}</td><td>{p.dose} in → {p.yield} out</td><td>{p.skip}</td></tr>)}</tbody></table></div></section>
      <section class="review-section" id="picks"><header class="review-section-heading"><p class="review-overline">First-bag choices</p><h2>Use the recipe to learn a distinct coffee</h2></header><div class="bean-index-grid">{picks.map(p=><article class="bean-guide-pick"><img src={p.review.image} alt={p.review.imageAlt} width="360" height="360" loading="lazy" decoding="async" /><div><p class="review-overline">{p.best}</p><h3><a href={local(p.slug)}>{p.review.roaster} {p.review.coffee}</a></h3><p><strong>Why:</strong> {p.basis}</p><p><strong>Tradeoff:</strong> {p.tradeoff}</p><p><strong>Skip if:</strong> {p.skip}</p><p class="bean-credit"><a href={p.review.imageSource} target="_blank" rel="noopener">Image: {p.review.roaster}</a>. {p.review.imageCredit}</p><a class="bean-guide-review-link" href={local(p.slug)}>Read the full review →</a></div></article>)}</div></section>
      <section class="review-section" id="use"><header class="review-section-heading"><p class="review-overline">A repeatable first shot</p><h2>Record dose, beverage mass and taste</h2></header><div class="review-section-body"><p>Match the bag and its roast date to the live roaster guide before starting. If your basket accepts the stated dose, weigh dry coffee and stop the shot near the published beverage mass. Record the time, grind setting, water and what you liked or disliked. Change one variable at a time. The ratio alone does not specify a universal grind size or temperature, and the Onyx pressure timelines assume equipment that can follow those profiles. [1] [4]</p><p>Analog’s 18 g to 45 g ratio and Monarch’s 19 g to 47 g ratio are close numerically, but that does not mean the beans should share a grinder setting or flavor expectation. Geometry’s 20 g to 47 g is a slightly shorter ratio, yet its lighter washed-coffee brief is a different sensory target. Treat each bag as a fresh dial-in. If your basket is smaller, scale within its documented capacity instead of forcing a dose that does not fit.</p><p>For milk, start with the coffee you want to notice after dilution. Analog’s darker chocolate brief and Monarch’s darker chocolate plus berry direction offer different reasons to try a small cappuccino. Geometry is more useful when you want to find out whether berry and tea survive a straight shot or whether you prefer it as filter. Those are inferences from roaster descriptions and owner context, not Coffeedant tasting. [1] [2] [3] [6]</p></div></section>
      <section class="review-section" id="details"><header class="review-section-heading"><p class="review-overline">Detailed comparison</p><h2>What the recipe does and does not tell you</h2></header><div class="bean-guide-table" tabindex="0" role="region" aria-label="Scrollable detailed espresso recipe comparison"><table><caption>Product-specific roaster records; flavor words are attributed to the roaster</caption><thead><tr><th scope="col">Factor</th>{picks.map(p=><th scope="col"><a href={local(p.slug)}>{p.review.coffee}</a></th>)}</tr></thead><tbody><tr><th scope="row">Dry dose</th>{picks.map(p=><td>{p.dose}</td>)}</tr><tr><th scope="row">Beverage yield</th>{picks.map(p=><td>{p.yield}</td>)}</tr><tr><th scope="row">Approximate ratio</th>{picks.map(p=><td>{p.ratio}</td>)}</tr><tr><th scope="row">Roast brief</th>{picks.map(p=><td>{p.roast}</td>)}</tr><tr><th scope="row">Roaster notes</th>{picks.map(p=><td>{p.notes}</td>)}</tr><tr><th scope="row">Main uncertainty</th><td>Current lot and equipment adaptation</td><td>Rotating blend components and pressure control</td><td>Light-roast preference and dial-in</td></tr></tbody></table></div></section>
      <section class="review-section" id="buying"><header class="review-section-heading"><p class="review-overline">Purchase and alternatives</p><h2>Buy the first bag you can finish</h2></header><div class="review-section-body"><p>Check exact whole-bean selection, current pack size, roast or shipping date, US stock, shipping and tax at checkout. A recipe cannot rescue an old bag or a grinder that cannot make useful espresso adjustments. Start with a manageable bag; keep it sealed in a cool, dry place and grind shortly before brewing. We make no current price, discount, cost-per-dose or value ranking.</p><p>If you want a fruit-led straight shot without making recipe availability the main filter, use our <a href={local('/coffee-beans/best-fruit-forward-espresso-beans/')}>fruit-forward espresso guide</a>. For a chocolate preference across different blends, see the <a href={local('/coffee-beans/best-chocolate-forward-espresso-beans/')}>chocolate-forward guide</a>. If one bag must also serve drip, compare the <a href={local('/coffee-beans/best-coffee-beans-for-espresso-and-drip/')}>dual-method picks</a>. A separate <a href={local('/grinder/')}>espresso grinder</a> remains part of the complete setup.</p><p>Coffeedant may earn from affiliate links elsewhere on this site at no extra cost to you. The roaster product photographs identify bags; they do not document Coffeedant brewing or tasting.</p></div></section>
      <section class="review-section" id="methodology"><header class="review-section-heading"><p class="review-overline">Evidence and limits</p><h2>What our recommendation rests on</h2></header><div class="review-section-body"><p>On November 11, 2026, we compared the current roaster product and brew pages with three existing full reviews, one older independent Analog tasting and individual owner reports. The best-for labels are editorial inferences from documented recipes and roaster flavor briefs. We did not buy coffee, taste these bags side by side, measure extraction, test freshness or establish owner failure rates. Roasters can change components and recipes; the delivered bag and current product page control the actual choice.</p></div></section>
      <section class="review-section" id="faq"><header class="review-section-heading"><p class="review-overline">Quick answers</p><h2>Espresso starting-recipe FAQ</h2></header><div class="bean-faq">{faqs.map(f=><article><h3>{f.q}</h3><p>{f.a}</p></article>)}</div></section>
      <section class="review-section" id="sources"><header class="review-section-heading"><p class="review-overline">Attributable evidence</p><h2>Sources checked November 11, 2026</h2></header><ol class="review-source-list">{sources.map((s,i)=><li id={'s'+(i+1)}><a href={s[1]} target="_blank" rel="noopener">{s[0]} ↗</a><p>{s[2]} Checked November 11, 2026.</p></li>)}</ol></section>
      <section class="final-verdict"><p class="review-overline">The first bag</p><h2>A measured start is only the start</h2><p>Try Analog when chocolate in milk is the target, Monarch when darker chocolate with winey berry appeals, or Geometry when you want a lighter washed-coffee experiment with a filter fallback. Each roaster supplies an actual starting recipe; your grinder, basket, water and taste decide the next adjustment.</p><a class="review-buy-button review-buy-button-dark" href={local('/coffee-beans/')}>Explore all bean reviews →</a></section>
    </article>
  </div></main>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
</HomeLayout>
