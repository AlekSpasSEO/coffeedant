---
import HomeLayout from '../../layouts/HomeLayout.astro';
import { beanReviews } from '../../data/bean-reviews';
import '../../styles/review.css';
import '../../styles/beans.css';
import '../../styles/bean-guides.css';

const date = '2026-11-02';
const path = '/coffee-beans/best-coffee-beans-for-moka-pot/';
const canonical = 'https://coffeedant.com' + path;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const local = (value: string) => base + value.replace(/^\//, '');
const title = 'Best Coffee Beans for Moka Pot by Cup Style';
const description = 'Two exact US whole-bean moka-pot starting points: Blue Bottle Hayes Valley Espresso for chocolate and orange, and Peet’s Major Dickason’s for a darker earthy cup. Research-led with brewing limits.';
const choices = [
  {slug:'/coffee-beans/blue-bottle-hayes-valley-espresso/', best:'Chocolate and orange, with or without milk', brief:'Baking chocolate, orange zest and brown sugar — Blue Bottle’s notes', why:'Blue Bottle offers both the current dark-roast Hayes Valley identity and a separate six-cup moka-pot method. The thick, chocolate-led brief is a reasonable starting fit for a concentrated stovetop cup.', tradeoff:'The moka-pot guide is a general Blue Bottle method, not a product-specific Hayes Valley comparison or tasting.', skip:'You dislike citrus accents or want a lighter, delicate filter-style cup.'},
  {slug:'/coffee-beans/peets-major-dickasons/', best:'Earthy, roast-forward stovetop coffee', brief:'Earth, spice and everything — Peet’s profile icons', why:'Peet’s identifies the exact whole-bean dark roast and separately names moka pot as a suitable way to explore dark-roast depth. Pick it when roast and earthy spice matter more than a citrus brief.', tradeoff:'Peet’s moka-pot advice covers dark roasts generally; the product page recommends French press and pour-over, so this is an inferred fit rather than a Major Dickason’s-specific moka recipe.', skip:'You want roaster-verified moka-pot parameters for this exact blend or a bright fruit-led cup.'}
];
const picks = choices.map(p => ({...p, review: beanReviews.find(r => r.slug === p.slug)!}));
if (picks.some(p => !p.review)) throw new Error('Moka-pot guide pick lacks a canonical bean review');
const sources = [
  ['Blue Bottle moka-pot brew guide','https://bluebottlecoffee.com/us/eng/brew-guides/moka-pot','Six-cup method: 20–22 g coffee, water to the safety valve, fine but not espresso-fine grind; no tamping.'],
  ['Blue Bottle Hayes Valley Espresso','https://bluebottlecoffee.com/us/eng/product/hayes-valley-espresso','US dark-roast identity and roaster-attributed baking chocolate, orange zest and brown sugar notes.'],
  ['Peet’s Major Dickason’s','https://www.peets.com/products/major-dickasons','US whole-bean dark-roast identity and earthy/spice flavor profile.'],
  ['Peet’s light- versus dark-roast guide','https://www.peets.com/blogs/peets/light-roast-vs-dark-roast-coffee','General recommendation of moka pot among methods for dark roasts; not a product-specific recipe.']
];
const sections = [
  {id:'criteria', title:'Choose the cup before the roast label', paragraphs:[
    'This US whole-bean shortlist addresses a six-cup stovetop moka pot, where the basket, heat and grind make a concentrated cup. We looked for a currently identifiable coffee with a Coffeedant full review, an attributable roaster flavor description and a reasoned connection to moka brewing. We excluded capsule, preground and uncertain bag identities. Neither roaster has published a controlled head-to-head test of these two coffees in the same moka pot. [1] [2] [3] [4]',
    'Blue Bottle’s method is specific to a six-cup moka pot but general to its coffees. Peet’s says dark roast works with a moka pot, while its Major Dickason’s product page recommends French press and pour-over. That difference matters: the picks are flavor-direction starting points, not proven winners. Coffeedant has not bought, brewed or tasted either bag. [1] [3] [4]',
    'If you actually want espresso from a machine, use our espresso-bean guide. A moka pot uses a different brewer and its cup should not inherit an espresso shot recipe or sensory claim. The same whole bean can be tried in both, but you will need a separate grind setting and a separate judgment.'
  ]},
  {id:'brewing', title:'Hold the moka-pot method steady', paragraphs:[
    'For a six-cup pot, Blue Bottle gives a 20–22 g coffee starting dose and about 345 g water to the safety valve. It calls for a grind finer than pour-over but coarser than espresso, roughly granulated sugar. Level the basket without tamping, keep grounds off the rim, and use medium heat. Its guide says to remove the pot when hissing or gurgling signals the finish. These are Blue Bottle’s published instructions, not measured results from our kitchen. [1]',
    'The safety valve, basket capacity and heat source on your actual pot control the setup. Do not copy the six-cup weights into a smaller pot or fill above its valve. Follow the pot maker’s instructions where they differ, especially for induction compatibility and cleaning. Use the same dose, water level, grind and heat for your first comparison; otherwise a change in technique can masquerade as a bean preference.',
    'If the finished cup is harsh, first check whether the burner kept heating after the pot began sputtering or whether the grind is too fine. If it is thin, check basket fill and grind before declaring a bean unsuitable. Those are diagnostic experiments, not a promise that one adjustment fixes every coffee. Record what you changed and taste again.'
  ]},
  {id:'buying', title:'Buy a bag you can use fresh', paragraphs:[
    'Both picks are named US whole-bean coffees. A product listing does not verify the roast date, shipping condition or remaining stock of the bag that arrives. Check the selected format, package size, delivery estimate, shipping and tax in the live US cart. This guide does not compare prices or claim a current discount. [2] [3]',
    'Buy a modest bag first if you are testing a new cup direction. Keep it sealed in a cool, dry place and grind just before brewing. The roaster’s notes describe its intended profile; changes in component lots, roast date, water and preparation can alter your result. Avoid treating a general roast category as a guaranteed tasting note.'
  ]},
  {id:'alternatives', title:'What to choose when these briefs miss', paragraphs:[
    'For a citrus-and-chocolate direction, begin with Hayes Valley; Blue Bottle’s product page calls it a dark roast designed for thick, sweet espresso, and its separate moka guide supplies a reproducible brewer starting point. That combination supports a trial, not a claim that it outperforms another bean in a moka pot. [1] [2]',
    'For an earthy, darker profile, begin with Major Dickason’s. Peet’s dark-roast article supports the method family, but offers no recipe for this exact blend. If you prefer a cleaner, more delicate black cup, a pour-over and its own bean shortlist may be a better first decision. If caffeine is the constraint, use our separate decaf guide and confirm the exact decaf bag; neither pick here is decaf. [3] [4]'
  ]}
];
const faqs = [
  {q:'Do moka pots make espresso?',a:'They make concentrated stovetop coffee. Blue Bottle describes an espresso-style cup, but its moka-pot method is distinct from an espresso-machine shot.'},
  {q:'Which pick has a product-specific moka-pot recipe?',a:'Neither. Blue Bottle publishes a general six-cup moka-pot method; Peet’s recommends moka pot for dark roasts generally.'},
  {q:'Should I use an espresso-fine grind?',a:'Blue Bottle says finer than pour-over but not as fine as espresso for its six-cup method. Adjust to your own pot and grinder.'},
  {q:'Should I tamp the moka basket?',a:'No. Blue Bottle’s guide says to level the coffee gently and not tamp it.'},
  {q:'Can I use these beans with milk?',a:'You can try either cup with milk. Hayes Valley has a chocolate-and-orange roaster brief; Major Dickason’s has an earthy, roast-forward brief. Coffeedant has not tasted either preparation.'},
  {q:'Did Coffeedant test or rank these cups?',a:'No. These are research-led first-bag choices based on exact current product identities, roaster notes and published brew guidance.'}
];
const cite=(p:string)=>p.replace(/\[(\d+)\]/g,(_m,n)=>'<a class="bean-cite" href="#s'+n+'" aria-label="Source '+n+'">['+n+']</a>');
const author={'@type':'Person',name:'Aleksandar Spasevski',jobTitle:'Editor, Coffeedant',url:'https://coffeedant.com/about/',image:'https://coffeedant.com/images/author-aleksandar-spasevski.jpg'};
const schema={'@context':'https://schema.org','@graph':[
  {'@type':'Article','@id':canonical+'#article',headline:title,description,genre:'Research-led coffee buying guide',inLanguage:'en-US',datePublished:date,dateModified:date,author,mainEntityOfPage:canonical,image:picks.map(p=>p.review.image),citation:sources.map(s=>s[1]),publisher:{'@type':'Organization',name:'Coffeedant',url:'https://coffeedant.com/'}},
  {'@type':'ItemList','@id':canonical+'#shortlist',name:title,itemListElement:picks.map((p,i)=>({'@type':'ListItem',position:i+1,name:p.review.roaster+' '+p.review.coffee,url:'https://coffeedant.com'+p.slug}))},
  {'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://coffeedant.com/'},{'@type':'ListItem',position:2,name:'Coffee beans',item:'https://coffeedant.com/coffee-beans/'},{'@type':'ListItem',position:3,name:title,item:canonical}]},
  {'@type':'FAQPage',mainEntity:faqs.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}
]};
---
<HomeLayout title={title+' | Coffeedant'} description={description} canonicalPath={path} image={picks[0].review.image} imageAlt={picks[0].review.imageAlt} ogType="article" published={date} updated={date}>
  <main id="main-content" class="review-page bean-buying-guide" data-guide-kind="coffee-beans"><div class="review-shell">
    <nav class="review-breadcrumbs" aria-label="Breadcrumb"><a href={base}>Home</a><span>/</span><a href={local('/coffee-beans/')}>Coffee beans</a><span>/</span><span>Moka pot</span></nav>
    <header class="bean-guide-header"><p class="review-overline">Coffee buying guide · research-led · United States</p><h1>{title}</h1><p class="bean-lead">Two darker whole beans, two different cups: chocolate and orange or earthy spice. Use a repeatable stovetop method before deciding which fits you.</p><aside class="review-author-card"><div class="review-author-head"><img src={local('/images/author-aleksandar-spasevski.jpg')} alt="Aleksandar Spasevski, editor at Coffeedant" width="46" height="46" /><div><strong>Aleksandar Spasevski</strong><small>Editor, Coffeedant</small></div></div><p>Published and checked <time datetime={date}>November 2, 2026</time> · US whole-bean context</p><p>I compared current roaster listings and moka-pot guidance with our full reviews. I have not bought, brewed or tasted these bags. The best-for labels are research-led buying judgments.</p></aside></header>
    <nav class="bean-jump" aria-label="Guide sections"><strong>Choose a moka-pot bean</strong>{sections.map(s=><a href={'#'+s.id}>{s.title}</a>)}<a href="#quick-compare">Quick comparison</a><a href="#picks">The picks</a><a href="#detailed-compare">Detailed comparison</a><a href="#faq">FAQ</a><a href="#sources">Sources</a></nav>
    <article class="bean-article">
      {sections.slice(0,2).map(s=><section class="review-section" id={s.id}><header class="review-section-heading"><p class="review-overline">Buyer decision</p><h2>{s.title}</h2></header><div class="review-section-body">{s.paragraphs.map(p=><p set:html={cite(p)} />)}</div></section>)}
      <section class="review-section" id="quick-compare"><header class="review-section-heading"><p class="review-overline">Two cup directions</p><h2>Quick comparison</h2></header><div class="bean-guide-table" tabindex="0" role="region" aria-label="Scrollable moka-pot bean comparison"><table><caption>US whole-bean identities checked November 2, 2026; no price ranking</caption><thead><tr><th scope="col">Coffee</th><th scope="col">Best for</th><th scope="col">Roaster flavor brief</th><th scope="col">Skip if</th></tr></thead><tbody>{picks.map(p=><tr><th scope="row"><a href={local(p.slug)}>{p.review.roaster} {p.review.coffee}</a></th><td>{p.best}</td><td>{p.brief}</td><td>{p.skip}</td></tr>)}</tbody></table></div></section>
      <section class="review-section" id="picks"><header class="review-section-heading"><p class="review-overline">Reasons to choose</p><h2>Two first-bag picks</h2></header><div class="bean-index-grid">{picks.map(p=><article class="bean-guide-pick"><img src={p.review.image} alt={p.review.imageAlt} width="360" height="360" loading="lazy" decoding="async" /><div><p class="review-overline">{p.best}</p><h3><a href={local(p.slug)}>{p.review.roaster} {p.review.coffee}</a></h3><p><strong>Why:</strong> {p.why}</p><p><strong>Tradeoff:</strong> {p.tradeoff}</p><p><strong>Skip if:</strong> {p.skip}</p><p class="bean-credit"><a href={p.review.imageSource} target="_blank" rel="noopener">Image: {p.review.roaster}</a>. {p.review.imageCredit}</p><a class="bean-guide-review-link" href={local(p.slug)}>Read the full review →</a></div></article>)}</div></section>
      <section class="review-section" id="detailed-compare"><header class="review-section-heading"><p class="review-overline">Compare the evidence</p><h2>Detailed comparison</h2></header><div class="bean-guide-table" tabindex="0" role="region" aria-label="Scrollable detailed moka-pot comparison"><table><caption>Roaster descriptions and method scope, not Coffeedant tasting results</caption><thead><tr><th scope="col">Factor</th>{picks.map(p=><th scope="col"><a href={local(p.slug)}>{p.review.coffee}</a></th>)}</tr></thead><tbody><tr><th scope="row">Cup direction</th>{picks.map(p=><td>{p.best}</td>)}</tr><tr><th scope="row">Roaster notes</th>{picks.map(p=><td>{p.brief}</td>)}</tr><tr><th scope="row">Method evidence</th><td>Blue Bottle general six-cup moka-pot guide</td><td>Peet’s general dark-roast moka-pot guidance</td></tr><tr><th scope="row">Main limit</th>{picks.map(p=><td>{p.tradeoff}</td>)}</tr><tr><th scope="row">US checkout</th>{picks.map(_p=><td>Verify whole-bean size, roast date, stock, shipping and tax</td>)}</tr></tbody></table></div></section>
      {sections.slice(2).map(s=><section class="review-section" id={s.id}><header class="review-section-heading"><p class="review-overline">Use the evidence</p><h2>{s.title}</h2></header><div class="review-section-body">{s.paragraphs.map(p=><p set:html={cite(p)} />)}</div></section>)}
      <section class="review-section" id="related"><header class="review-section-heading"><p class="review-overline">Related decisions</p><h2>Compare the brew you actually use</h2></header><div class="bean-alternatives"><a href={local('/coffee-beans/best-dark-roast-coffee-beans/')}><strong>Dark-roast beans</strong><span>Choose by roast-forward use beyond moka pot.</span></a><a href={local('/coffee-beans/best-coffee-beans-for-espresso-and-drip/')}><strong>Espresso and drip</strong><span>One bag for two distinct methods.</span></a><a href={local('/coffee-beans/best-decaf-coffee-beans-by-brew-method/')}><strong>Decaf by method</strong><span>Start with caffeine needs.</span></a></div></section>
      <section class="review-section" id="methodology"><header class="review-section-heading"><p class="review-overline">Evidence and limits</p><h2>How this guide was made</h2></header><div class="review-section-body"><p>We checked exact US whole-bean identities, current roaster descriptions, published moka-pot advice and our linked full reviews. We selected two contrasting flavor briefs, not a sensory winner. Coffeedant did not brew, taste, measure extraction or verify a delivered bag.</p><p>Blue Bottle’s six-cup method is general to its coffees. Peet’s moka suggestion is general to dark roast. Neither is a controlled product-specific comparison. No price, discount, stock guarantee or owner reliability claim is inferred.</p></div></section>
      <section class="review-section" id="faq"><header class="review-section-heading"><p class="review-overline">Quick answers</p><h2>Moka-pot bean FAQ</h2></header><div class="bean-faq">{faqs.map(f=><article><h3>{f.q}</h3><p>{f.a}</p></article>)}</div></section>
      <section class="review-section" id="sources"><header class="review-section-heading"><p class="review-overline">Attributable evidence</p><h2>Sources checked November 2, 2026</h2></header><ol class="review-source-list">{sources.map((s,i)=><li id={'s'+(i+1)}><a href={s[1]} target="_blank" rel="noopener">{s[0]} ↗</a><p>{s[2]} Checked November 2, 2026.</p></li>)}</ol></section>
      <section class="final-verdict"><p class="review-overline">Your first bag</p><h2>Pick a flavor brief, then repeat a safe brew</h2><p>Use the roaster’s notes to choose a starting bag. Follow your pot’s instructions, hold the method steady, and let your own fresh-bag cup decide the next purchase.</p><a class="review-buy-button review-buy-button-dark" href={local('/coffee-beans/')}>Explore all bean reviews →</a></section>
    </article>
  </div></main>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
</HomeLayout>

