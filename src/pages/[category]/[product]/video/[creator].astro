---
import HomeLayout from '../../../../layouts/HomeLayout.astro';
import { modernReviews } from '../../../../data/review-registry';
import { bambinoReview } from '../../../../data/reviews';
import { beanReviews } from '../../../../data/bean-reviews';
import { getProductVideos, getVideoWatchPath, videoSchema } from '../../../../lib/product-videos';
import '../../../../styles/video-watch.css';

export function getStaticPaths() {
  const products = [
    ...[bambinoReview, ...modernReviews].map(r => ({ slug: r.slug, brand: r.brand, model: r.model })),
    ...beanReviews.map(r => ({ slug: r.slug, brand: r.roaster, model: r.coffee })),
  ];
  return products.flatMap(product => getProductVideos(product.slug).map(video => {
    const watchPath = getVideoWatchPath(product.slug, video);
    const [category, model, , creator] = watchPath.split('/').filter(Boolean);
    const name = product.model.toLowerCase().startsWith(`${product.brand.toLowerCase()} `) ? product.model : `${product.brand} ${product.model}`;
    return { params: { category, product: model, creator }, props: { product: { ...product, name }, video, watchPath } };
  }));
}
const { product, video, watchPath } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = `https://coffeedant.com${watchPath}`;
const title = `${product.name}: ${video.title} · ${video.creator} (${video.published.slice(0, 10)}) | Coffeedant`.replace(/\s+/g, ' ').trim();
const description = `Watch ${video.creator} on ${product.name} (${video.published.slice(0, 10)}): ${video.title}. ${video.summary}`.replace(/\s+/g, ' ').trim();
const date = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(video.published));
const primaryVideo = { ...videoSchema(video, product, canonical), url: canonical, isPartOf: { '@id': `${canonical}#watchpage` } };
const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'ItemPage', '@id': `${canonical}#watchpage`, url: canonical, name: title, description, dateModified: '2026-10-21', mainEntity: { '@id': primaryVideo['@id'] } },
  primaryVideo,
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://coffeedant.com/' },
    { '@type': 'ListItem', position: 2, name: product.name, item: `https://coffeedant.com${product.slug}` },
    { '@type': 'ListItem', position: 3, name: `Video by ${video.creator}`, item: canonical },
  ] },
] };
---
<HomeLayout title={title} description={description} canonicalPath={watchPath} image={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`} imageAlt={`${product.name} video by ${video.creator}`}>
  <main id="main-content" class="video-watch-page" tabindex="-1">
    <article class="video-watch-content" data-video-watch data-video-id={video.id}>
      <div class="video-watch-toolbar"><a href={`${base}${product.slug.slice(1)}`}>← {product.name} review</a><a href={`${base}videos/?model=${encodeURIComponent(product.slug)}`}>More videos</a></div>
      <div class="video-watch-stage">
        <iframe src={`https://www.youtube-nocookie.com/embed/${video.id}?rel=0`} title={`${video.title} by ${video.creator}`} width="960" height="540" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
      </div>
      <div class="video-watch-copy">
        <p class="video-watch-eyebrow">{product.name} · {video.sourceType === 'retailer' ? 'Retailer perspective' : 'Third-party perspective'}</p>
        <h1 id="video-watch-title">{video.title}</h1>
        <p class="video-watch-credit">By <a href={video.channelUrl} target="_blank" rel="noopener noreferrer">{video.creator}</a> · Published <time datetime={video.published}>{date}</time></p>
        <p>{video.summary}</p>
        {video.disclosure && <p class="video-watch-disclosure">{video.disclosure}</p>}
        <p class="video-watch-disclosure">Video and opinions belong to {video.creator}. Coffeedant curates this perspective alongside our written review.</p>
        <a class="video-watch-source" href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" rel="noopener noreferrer">Watch on YouTube ↗</a>
      </div>
    </article>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
</HomeLayout>
