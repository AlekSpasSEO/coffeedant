{
  "name": "coffeedant",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "validate:brand-navigation": "node scripts/validate-brand-navigation.mjs",
    "validate:videos": "node scripts/validate-product-videos.mjs",
    "update:amazon-deals": "node scripts/update-amazon-deals.mjs",
    "refresh:amazon-deals": "node scripts/update-amazon-deals.mjs --refresh",
    "test:deals": "node --test scripts/tests/amazon-deals.test.mjs scripts/tests/deal-season.test.mjs scripts/tests/deal-recovery.test.mjs",
    "update:deal-season": "node scripts/update-deal-season.mjs",
    "test:review-originality": "node --test scripts/tests/review-originality.test.mjs",
    "validate:review-originality": "node scripts/validate-review-originality.mjs",
    "dev": "astro dev",
    "build": "astro build && node scripts/localization/build.mjs && node scripts/build-seo.mjs && node scripts/validate-deals.mjs",
    "validate:deals": "node scripts/validate-deals.mjs",
    "build:region": "node scripts/localization/build.mjs --astro",
    "build:regions": "node scripts/localization/bundle.mjs",
    "localization:source": "node scripts/localization/source.mjs",
    "localization:translate": "node scripts/localization/translate.mjs",
    "localization:status": "node scripts/localization/status.mjs",
    "localization:refresh-offers": "node scripts/localization/refresh-offers.mjs",
    "test:localization": "node --test scripts/localization/tests/*.test.mjs",
    "preview": "astro preview",
    "validate:seo": "node scripts/validate-seo.mjs && node scripts/validate-review-anchors.mjs",
    "test:seo": "node --test scripts/tests/seo.test.mjs scripts/tests/product-video-schema.test.mjs scripts/tests/review-anchors.test.mjs",
    "plan:upgrades": "node scripts/next-content-upgrade-batch.mjs",
    "audit:article-parity": "node scripts/audit-canonical-article-parity.mjs",
    "audit:supporting-pages": "node scripts/audit-supporting-pages.mjs",
    "generate:review-media-ledgers": "node scripts/generate-review-media-ledgers.mjs",
    "update:coffee-finder": "node scripts/update-coffee-finder-sync.mjs",
    "validate:coffee-finder": "node scripts/validate-coffee-finder.mjs",
    "update:amazon-offers": "node scripts/update-amazon-offers.mjs",
    "update:amazon-recommendations": "node scripts/update-amazon-recommendations.mjs",
    "validate:amazon-banners": "node scripts/validate-amazon-banners.mjs",
    "validate:beans": "node scripts/validate-bean-reviews.mjs",
    "validate:amazon-catalog": "node scripts/validate-amazon-catalog.mjs",
    "validate:analytics": "node scripts/validate-analytics.mjs",
    "test:analytics-policy": "node --test scripts/tests/analytics-policy.test.mjs",
    "audit:analytics:live": "node scripts/audit-live-analytics.mjs",
    "validate:journal": "node --test scripts/tests/journal-routing.test.mjs && node scripts/validate-journal.mjs",
    "validate:migration": "npm run build && node scripts/validate-legacy-migration.mjs",
    "validate:reviews": "npm run build && npm run generate:review-media-ledgers && node scripts/validate-review-batch.mjs"
  },
  "dependencies": {
    "astro": "^4.16.18",
    "parse5": "^7.3.0"
  }
}
