{
  "name": "coffeedant",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "plan:upgrades": "node scripts/next-content-upgrade-batch.mjs",
    "audit:article-parity": "node scripts/audit-canonical-article-parity.mjs",
    "audit:supporting-pages": "node scripts/audit-supporting-pages.mjs",
    "generate:review-media-ledgers": "node scripts/generate-review-media-ledgers.mjs",
    "update:coffee-finder": "node scripts/update-coffee-finder-sync.mjs",
    "update:amazon-offers": "node scripts/update-amazon-offers.mjs",
    "update:amazon-recommendations": "node scripts/update-amazon-recommendations.mjs",
    "validate:amazon-banners": "node scripts/validate-amazon-banners.mjs",
    "validate:analytics": "node scripts/validate-analytics.mjs",
    "validate:migration": "npm run build && node scripts/validate-legacy-migration.mjs",
    "validate:reviews": "npm run build && npm run generate:review-media-ledgers && node scripts/validate-review-batch.mjs"
  },
  "dependencies": {
    "astro": "^4.16.18",
    "parse5": "^7.3.0"
  }
